#!/usr/bin/env python3
"""Per-test conformance floor: every corpus through its own harness in one interpreter mode.

  floor run --mode MODE --out DIR [--corpus NAME]... [--unit CORPUS/LABEL]... [--runs N] [--jobs N]
      one DIR/CORPUS.tsv per corpus (test id, status; sorted) and DIR/summary.md
  floor compare FLOOR DIR
      every test PASS in FLOOR and not PASS in DIR (a corpus DIR lacks is skipped); exit 1 if any
  floor quick [--base REF] [--jobs N]
      the per-change gate: builds, then runs kernel, difftest and jitcheck whole in their gate lanes
      and the units results/floor/quick.tsv lists in the modes the change calls for (slice_modes),
      all from one queue; prints each floor pass lost against results/floor/off, PASS or FAIL, and
      the wall time from the start of the build
  floor select --budget S [--past DIR]... [--now DIR]... [--history FILE]
      rewrites results/floor/quick.tsv from floor runs of the tier: the units with the most
      catches, floor passes and stdlib topics per second, within S unit seconds per mode

Modes: off (-X lucifer_jit=off), on (default flags), jit (-X lucifer_jit=always),
deopt (-X lucifer_jit=always -X lucifer_stress=deopt:7).

Each corpus splits into units, one harness invocation each (a Lib/test module, a numpy test
file, a fuzzdiff generator and seed, ...). Units of every corpus share one queue of --jobs
workers (default: every CPU this process may use), longest first by the seconds each took last time
in the mode (build/floor/unit-seconds.json; units never timed go first). A Lib/test module's and a
fuzzdiff process's deadline is MARGIN times those seconds when that is over the harness's default.

With --runs N each corpus runs N times; a test is PASS only if every run passed it, and a
test whose status changed between runs is listed as flaky in the summary.

Run from the repository root on a built tree. Environment, as tools/status takes it:
  LUCIFER        the executable under test (default bin/lucifer)
  ORACLE_T       the CPython 3.14t reference interpreter
  HOST_PYTHON    CPython 3.14 for kernelcheck and compilercheck, and for make
  TEST_PREFIX    command words put in front of each unit's harness run
  NUMPY_SITE, NUMPY_CACHE   prepared site-packages and wheel cache (numpy)
  FT_WORK        the package workspace from tools/ftcorpus/prepare.py (ft-packages)
  PYPI_CACHE     the wheel and source cache (pypi)
  PYPI_SITE      installed cp314t site-packages; PYPI_SITE_<package> overrides it per package
A corpus whose environment is missing is reported and skipped.
"""
import argparse
import collections
from concurrent.futures import ThreadPoolExecutor, as_completed
import csv
import json
import math
import os
from pathlib import Path
import re
import shlex
import shutil
import subprocess
import sys
import threading
import time

ROOT = Path(__file__).resolve().parents[1]
MODES = {
    "off": ["-X", "lucifer_jit=off"],
    "on": [],
    "jit": ["-X", "lucifer_jit=always"],
    "deopt": ["-X", "lucifer_jit=always", "-X", "lucifer_stress=deopt:7"],
}
# The same modes in the harnesses that name them themselves.
KERNEL_LANES = {"off": "jit-off", "on": "plain", "jit": "jit", "deopt": "jit-deopt"}
JITCHECK_MODES = {"off": "off", "on": "on", "jit": "always", "deopt": "deopt:7"}
LINE = re.compile(r"^(PASS|FAIL|XPASS|XFAIL) (.+)$", re.M)
# The harnesses' order of outcomes: a test two units report (a case two Lib/test modules share) keeps the worst.
RANK = {s: i for i, s in enumerate(["PASS", "SKIP", "XFAIL", "NOTRUN", "XPASS", "FAIL", "ERROR", "CRASH", "TIMEOUT"])}
HISTORY = ROOT / "build/floor/unit-seconds.json"
# A unit may take this many times what it took last time in its mode before its harness calls it hung: a
# stress mode's slow unit fits under load, and a hung one still stops at a bound its own cost sets.
MARGIN = 2
LOG_LOCK = threading.Lock()


class Missing(Exception):
    """A corpus's environment is not set up."""


def env(name, default=None):
    value = os.environ.get(name, default)
    if value is None:
        raise Missing(f"{name} is not set")
    return value


def run(argv, log, cwd=ROOT, prefixed=True):
    """Run a harness step, appending its output to log; the output."""
    words = shlex.split(os.environ.get("TEST_PREFIX", "")) if prefixed else []
    done = subprocess.run(words + argv, cwd=cwd, text=True, errors="replace",
                          stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
    with LOG_LOCK, log.open("a") as f:
        f.write(f"$ {shlex.join(argv)}\n{done.stdout}\nexit {done.returncode}\n")
    return done.stdout


def make(target, log, **variables):
    flags = [f"{v}={os.environ[v]}" for v in ("ORACLE_T", "HOST_PYTHON") if v in os.environ]
    return run(["make", target, *flags, *(f"{k}={v}" for k, v in variables.items())], log)


def lucifer(flags):
    return shlex.join([str(Path(env("LUCIFER", "bin/lucifer")).resolve()), *flags])


def manifest(path):
    with path.open(newline="") as f:
        return {row["id"]: row["status"] for row in csv.DictReader(f, delimiter="\t")}


def unit_manifest(path):
    """A unit's manifest, which lists every test of its corpus: read once, then removed to spare the disk."""
    rows = manifest(path)
    path.unlink()
    return rows


def unit_results(suite, directory):
    """A unit's own results/SUITE: links to the inputs there, so harness runs write their manifests apart."""
    target = directory / "results" / suite
    shutil.rmtree(directory / "results", ignore_errors=True)
    target.mkdir(parents=True)
    for path in (ROOT / "results" / suite).iterdir():
        if not re.fullmatch(r"lucifer(-.*)?\.(tsv|json)", path.name):
            (target / path.name).symlink_to(path)
    return target


def unit_history(path=HISTORY):
    """{mode: {CORPUS/LABEL: seconds its last run took}}; a file from before modes were kept apart reads empty."""
    raw = json.loads(path.read_text()) if path.exists() else {}
    return {mode: units for mode, units in raw.items() if isinstance(units, dict)}


def deadline(past, unit, default):
    """A harness deadline for unit, given its mode's history: MARGIN times its last run, at least default."""
    return max(default, math.ceil(MARGIN * past.get(unit, 0)))


def output_lines(text):
    """{id: status} from PASS/FAIL lines; the detail after an id (': exit ...', a count) is dropped."""
    rows = {}
    for status, rest in LINE.findall(text):
        rest = re.sub(r": exit .*$| \(run \d+\)$| \(luc-\w+\)$", "", rest)
        rest = re.sub(r"^(stress: gc:\d+) .*", r"\1", rest)
        rows[rest] = status
    return rows


# --- corpora: each takes (mode, flags, work, log) and returns its units, {label: function}; -----
# --- a unit runs one harness invocation and returns {test id: status} for the tests it owns ----

KERNEL_SHARD = 20     # programs per harness run


def kernel_programs():
    return sorted(p.stem for p in (ROOT / "tests/kernel").glob("*.py"))


def kernelcheck(mode, selection, log):
    """kernelcheck in MODE's lane on --programs NAMES or --checks; {check: status}. One check at a time:
    the floor's own queue runs the shards at once."""
    out = run([env("HOST_PYTHON"), "tools/kernelcheck", "--oracle", env("ORACLE_T"), "--lucifer",
               env("LUCIFER", "bin/lucifer"), "--lane", KERNEL_LANES[mode], "--jobs", "1", *selection], log)
    rows = output_lines(out)
    total = re.search(r"\d+/(\d+) checks pass", out)
    if not total or int(total[1]) != len(rows):
        rows["kernelcheck"] = "CRASH"  # the harness did not report every check
    return rows


def kernel(mode, flags, work, log):
    names = kernel_programs()
    # The checks that are not programs run once, as a unit of their own.
    return {"checks": lambda: kernelcheck(mode, ["--checks"], log),
            **{str(start): lambda p=names[start:start + KERNEL_SHARD]:
               kernelcheck(mode, ["--programs", " ".join(p)], log) for start in range(0, len(names), KERNEL_SHARD)}}


def whole(corpus):
    """A corpus that runs as one unit."""
    return lambda mode, flags, work, log: {"all": lambda: corpus(mode, flags, work, log)}


@whole
def capi(mode, flags, work, log):
    """make check-capi, its two halves apart: a failure in one leaves the other's tests run."""
    return output_lines("".join(make(half, log, LUCIFER_FLAGS=shlex.join(flags))
                                for half in ("check-capi-ext", "check-capi-so")))


@whole
def embed(mode, flags, work, log):
    """The embedding program; an embedder passes no command-line flags, so every mode runs the default."""
    return {"embed": "PASS" if "PASS embed" in make("check-embed", log) else "FAIL"}


def difftest(mode, flags, work, log):
    """A unit per ID prefix: a directory of tests/diff, and the corpus by first letter."""
    corpus = "tests/diff/corpus/"
    ids = manifest(ROOT / "results/difftest/expected.tsv")
    prefixes = sorted({i[:len(corpus) + 1] if i.startswith(corpus) else i.rsplit("/", 1)[0] + "/" for i in ids})

    def unit(prefix):
        results = work / "difftest" / prefix.replace("/", "_")
        shutil.rmtree(results, ignore_errors=True)
        run(["python3", "tools/difftest", "run", "--oracle", env("ORACLE_T"), "--python", lucifer(flags),
             "--runtime", "lucifer", "--results", str(results), "--work", str(results / "work"), "--select", prefix],
            log)
        return {i: status for i, status in manifest(results / "lucifer.tsv").items() if i.startswith(prefix)}
    return {prefix: lambda p=prefix: unit(p) for prefix in prefixes}


@whole
def jitcheck(mode, flags, work, log):
    out = run(["python3", "tools/jitcheck", "--lucifer", env("LUCIFER", "bin/lucifer"), "--oracle", env("ORACLE_T"),
               "--modes", JITCHECK_MODES[mode]], log)
    return {k.split(" ")[0]: v for k, v in output_lines(out).items()}


@whole
def compiler(mode, flags, work, log):
    """Marshaled code per file of each compilercheck corpus; the files listed as differing fail."""
    out = run([env("HOST_PYTHON"), "tools/compilercheck", "--lucifer", lucifer(flags), "--oracle", env("ORACLE_T"),
               "--show", "1000000"], log)
    rows, name = {}, None
    for line in out.splitlines():
        if m := re.match(r"(\w+): \d+ of \d+ files marshal identically", line):
            name = m[1]
            rows.update({f"{name}:{p}": "PASS" for p in compilercheck_corpus(name)})
        elif name and line.startswith("    "):
            rows[f"{name}:{line.strip().split(': ', 1)[0]}"] = "FAIL"
    return rows


def compilercheck_corpus(name):
    import importlib.machinery, importlib.util
    loader = importlib.machinery.SourceFileLoader("compilercheck", str(ROOT / "tools/compilercheck"))
    module = importlib.util.module_from_spec(importlib.util.spec_from_loader("compilercheck", loader))
    loader.exec_module(module)
    return [str(p.relative_to(ROOT)) for p in module.corpus(name)]


def libtest(mode, flags, work, log):
    """A unit per Lib/test module (--shard I/N over N modules picks module I)."""
    modules = {}
    for build in json.loads((ROOT / "results/libtest/inventory.json").read_text()).values():
        for module, entry in build.items():
            modules.setdefault(module, set()).update(entry["cases"])
    names = sorted(modules)
    past = unit_history().get(mode, {})

    def unit(index, module):
        directory = work / "libtest" / module
        results = unit_results("libtest", directory)
        run(["python3", "tools/libtest/run.py", "run", "--python", lucifer(flags), "--runtime", "lucifer",
             "--source", "installed", "--jobs", "1", "--results", str(results),
             "--raw-dir", str(directory / "raw"), "--shard", f"{index}/{len(names)}",
             "--timeout", str(deadline(past, f"libtest/{module}", 180))], log)
        rows = unit_manifest(results / "lucifer.tsv")
        # A case other modules share is the worst of theirs in the manifest; this module's own is here.
        shared = json.loads((results / "lucifer.json").read_text()).get("shared_cases", {}).get(module, {})
        return {key: shared[key][0] if key in shared else rows[key] for key in modules[module]}
    return {module: lambda i=i, m=module: unit(i, m) for i, module in enumerate(names)}


# The whole-file deadline is a backstop for a wedged process; pytest-timeout times each test.
NUMPY_FILE_TIMEOUT = 3600


def numpy(mode, flags, work, log):
    """A unit per numpy test file."""
    site, cache = env("NUMPY_SITE"), env("NUMPY_CACHE")
    files = collections.defaultdict(list)
    for i in manifest(ROOT / "results/numpytest/expected.tsv"):
        files[i.split("::")[0]].append(i)

    def unit(path):
        directory = work / "numpy" / path
        results = unit_results("numpytest", directory)
        run(["python3", "tools/numpytest/run.py", "run", "--python", lucifer(flags), "--runtime", "lucifer",
             "--site", site, "--cache", cache, "--work", str(work / "numpy-raw"), "--results", str(results.parent),
             "--shard", path, "--timeout", str(NUMPY_FILE_TIMEOUT)], log)
        rows = unit_manifest(results / "lucifer.tsv")
        return {i: rows[i] for i in files[path]}
    return {path: lambda p=path: unit(p) for path in sorted(files)}


def ftcorpus(suite):
    def corpus(mode, flags, work, log):
        """ft-cpython: a unit per module and lane. ft-packages: a unit per package, its two lanes
        together, since both run in the package's one test tree."""
        extra = ["--work", env("FT_WORK")] if suite == "ft-packages" else []
        units = json.loads((ROOT / "results" / suite / "inventory.json").read_text())["units"]
        names = sorted(units)
        if suite == "ft-cpython":
            parts = {name: (["--shard", f"{i}/{len(names)}"], [name]) for i, name in enumerate(names)}
        else:
            packages = sorted({n.split("/")[1] for n in names})
            parts = {p: (["--select", p], [n for n in names if n.split("/")[1] == p]) for p in packages}

        def unit(label, selection, owned):
            directory = work / suite / label
            results = unit_results(suite, directory)
            run(["python3", "tools/ftcorpus/run.py", suite, "run", "--python", lucifer(flags), "--runtime", "lucifer",
                 "--results", str(results), "--raw-dir", str(directory / "raw"), *extra, *selection], log)
            rows = unit_manifest(results / "lucifer.tsv")
            shared = json.loads((results / "lucifer.json").read_text()).get("shared_outcomes", {})
            mine = {}
            for name in owned:
                # Package ids carry the package; CPython ids already name the module.
                prefix = name.split("/")[0] + "/" + (name.split("/")[1] + "/" if suite == "ft-packages" else "")
                for key in (prefix + case for case in units[name]):
                    mine[key] = shared.get(name, {}).get(key, [rows[key]])[0]
            return mine
        return {label: lambda l=label, s=s, o=o: unit(l, s, o) for label, (s, o) in parts.items()}
    return corpus


def pypi(mode, flags, work, log):
    cache, default_site = env("PYPI_CACHE"), env("PYPI_SITE")

    def unit(package):
        results = unit_results(f"pypi/{package}", work / "pypi" / package).parent
        site = os.environ.get(f"PYPI_SITE_{package}", default_site)
        run(["python3", "tools/pypi/run.py", "run", "--python", lucifer(flags), "--package", package,
             "--runtime", "lucifer", "--cache", cache, "--work", str(work / "pypi-work"), "--site", site,
             "--results", str(results)], log)
        return {f"{package}/{k}": v for k, v in manifest(results / package / "lucifer.tsv").items()}
    packages = json.loads((ROOT / "tools/pypi/corpus.json").read_text())["packages"]
    return {package: lambda p=package: unit(p) for package in packages}


def fuzzdiff(mode, flags, work, log):
    """A unit per generator and seed. Each case: match PASS, mismatch FAIL, skip SKIP, error (the oracle
    has no result) ERROR."""
    # Links the modules the generators import and unpacks the generators once, running no case.
    generators = [json.loads(line)["generator"] for line in make("fuzzdiff", log, FUZZDIFF="--cases 0").splitlines()
                  if line.startswith("{") and '"generator"' in line]
    # Each mode's results and scratch files apart, over the one unpacked tree: modes may run at once.
    fuzz = work / "fuzzdiff"
    fuzz.mkdir(exist_ok=True)
    for name in ("python-formalization", "cpython"):
        (fuzz / name).is_symlink() or (fuzz / name).symlink_to(ROOT / "build/fuzzdiff" / name)
    named = {"mismatch": "FAIL", "skip": "SKIP", "error": "ERROR"}
    past = unit_history().get(mode, {})

    def unit(generator, seed):
        out = run(["env", f"PYTHONPATH={ROOT / 'build/tests/capi/ext'}", "python3", "tools/fuzzdiff/run.py",
                   "--oracle", env("ORACLE_T"), generator, "--seed", str(seed), "--python", lucifer(flags),
                   "--work", str(fuzz), "--timeout", str(deadline(past, f"fuzzdiff/{generator}-s{seed}", 300))], log)
        rows = {}
        for line in out.splitlines():
            if line.startswith("{") and '"generator"' in line:
                c = json.loads(line)
                stem = f"{c['generator']}-s{c['seed']}"
                rows.update({f"{stem}/{i}": "PASS" for i in range(c["cases"])})
                for record in map(json.loads, (fuzz / "results" / f"{stem}.jsonl").read_text().splitlines()):
                    rows[f"{stem}/{record['index']}"] = named[record["status"]]
        if not rows:
            raise ValueError(f"fuzzdiff {generator} seed {seed} reported nothing")
        return rows
    return {f"{g}-s{s}": lambda g=g, s=s: unit(g, s) for g in generators for s in (1, 2)}


def workloads(mode, flags, work, log):
    """tools/bench/corpus programs against the CPython reference's checks: their output must match."""
    site = ROOT / "build/corpus/site"
    run(["python3", "tools/bench/corpus", "prepare", str(site)], log, prefixed=False)
    reference = json.loads((ROOT / "results/status-reference.json").read_text())["corpus"]
    ref = work / "corpus-reference.json"
    ref.write_text(json.dumps(reference))
    named = {"ok": "PASS", "fail": "FAIL", "wrong": "FAIL", "crash": "CRASH", "timeout": "TIMEOUT",
             "noreference": "SKIP"}

    def unit(program):
        out = run(["python3", "tools/bench/corpus", "time", str(site), "--run", lucifer(flags), "--reference", str(ref),
                   "--programs", program], log)
        return {p: named[r["status"]] for p, r in json.loads(out.strip().splitlines()[-1]).items()}
    return {program: lambda p=program: unit(p) for program in sorted(reference)}


CORPORA = {
    "kernel": kernel,
    "capi": capi,
    "embed": embed,
    "difftest": difftest,
    "jitcheck": jitcheck,
    "compiler": compiler,
    "fuzzdiff": fuzzdiff,
    "workloads": workloads,
    "libtest": libtest,
    "ft-cpython": ftcorpus("ft-cpython"),
    "ft-packages": ftcorpus("ft-packages"),
    "pypi": pypi,
    "numpy": numpy,
}


# --- records --------------------------------------------------------------------------------

def merge(runs):
    """A test passes only if it passed every run; (rows, flaky ids)."""
    rows, flaky = {}, set()
    for i in set().union(*runs):
        seen = [r.get(i, "NOTRUN") for r in runs]
        rows[i] = next((s for s in seen if s != "PASS"), "PASS")
        flaky |= {i} if len(set(seen)) > 1 else set()
    return rows, flaky


def write_tsv(path, rows):
    path.write_text("".join(f"{i}\t{rows[i]}\n" for i in sorted(rows)))


def read_tsv(path):
    return dict(line.split("\t") for line in path.read_text().splitlines())


def write_summary(out, mode):
    """summary.md from every CORPUS.tsv in out, keeping the unit seconds and flaky lists already recorded."""
    path = out / "summary.json"
    notes = json.loads(path.read_text()) if path.exists() else {}
    statuses = ["PASS", "FAIL", "ERROR", "SKIP", "XFAIL", "XPASS", "TIMEOUT", "CRASH", "NOTRUN"]
    md = [f"# Conformance floor: mode {mode} ({shlex.join(MODES[mode]) or 'default flags'})", "",
          "| corpus | runs | unit s | total | " + " | ".join(statuses) + " |", "|---" * (len(statuses) + 4) + "|"]
    for name in CORPORA:
        if (out / f"{name}.tsv").exists():
            counts = collections.Counter(read_tsv(out / f"{name}.tsv").values())
            n = notes.get(name, {})
            md.append(f"| {name} | {n.get('runs', '-')} | {n.get('seconds', '-')} | {sum(counts.values())} | "
                      + " | ".join(str(counts.get(s, 0)) for s in statuses) + " |")
    if "wall" in notes:
        md += ["", f"Unit s is the corpus's units' seconds summed; the last run took {notes['wall']['seconds']} s "
                   f"of wall time with {notes['wall']['jobs']} jobs."]
    for name, n in notes.items():
        if n.get("flaky"):
            md += ["", f"## Flaky in {name} (recorded as not PASS)", ""] + [f"- {i}" for i in n["flaky"]]
        if n.get("skipped"):
            md += ["", f"## {name} not run: {n['skipped']}"]
    (out / "summary.md").write_text("\n".join(md) + "\n")


def run_targets(targets, runs, jobs):
    """Run the units of every target, (mode, out, work, corpora, keep), from one queue of jobs workers,
    longest first by the seconds each took last time in its mode (build/floor/unit-seconds.json; units
    never timed go first). keep(corpus, label) picks a corpus's units. A target's CORPUS.tsv and summary
    are written as each of its corpora finishes. Returns the corpora, as (mode, corpus), with a unit that produced
    no results."""
    history = unit_history()
    started = time.monotonic()
    units, logs, notes, seconds, failed, dropped = {}, {}, {}, {}, set(), set()

    def skip(target, why):
        mode, name, out = target
        print(f"{name} ({mode}): skipped, {why}", flush=True)
        notes[out][name] = {"skipped": str(why)}
        dropped.add(target)
    for mode, out, work, corpora, keep in targets:
        history.setdefault(mode, {})
        out.mkdir(parents=True, exist_ok=True)
        work.mkdir(parents=True, exist_ok=True)
        path = out / "summary.json"
        notes[out] = json.loads(path.read_text()) if path.exists() else {}
        # The oracle's _testcapi and friends beside the standard library: kernel, capi and Lib/test import them.
        make("oracle-exts", work / "oracle-exts.log")
        for name in corpora:
            target = (mode, name, out)
            logs[target] = work / f"{name}.log"
            logs[target].unlink(missing_ok=True)
            try:
                every = CORPORA[name](mode, MODES[mode], work, logs[target])
                units[target] = {label: unit for label, unit in every.items() if keep(name, label)}
            except Missing as why:
                skip(target, why)
    collected = {target: [] for target in units}

    def timed(target, label, unit):
        start = time.monotonic()
        try:
            return unit()
        finally:
            took = seconds[target, label] = round(time.monotonic() - start, 1)
            # A run over MARGIN times the last hung or stalled: its seconds would stretch the deadline.
            past, key = history[target[0]], f"{target[1]}/{label}"
            if took <= MARGIN * past.get(key, math.inf):
                past[key] = took
    for _ in range(runs):  # a run's units reuse its scratch directories, so runs follow one another
        rows = {target: {} for target in units}
        left = collections.Counter({target: len(u) for target, u in units.items()})
        queue = [(target, label, unit) for target, u in units.items() for label, unit in sorted(u.items())]
        queue.sort(key=lambda q: -history[q[0][0]].get(f"{q[0][1]}/{q[1]}", math.inf))
        with ThreadPoolExecutor(jobs) as pool:
            futures = {pool.submit(timed, *q): q[:2] for q in queue}
            for future in as_completed(futures):
                target, label = futures[future]
                mode, name, out = target
                try:
                    for i, status in future.result().items():
                        old = rows[target].get(i)
                        rows[target][i] = status if old is None or RANK[status] > RANK[old] else old
                except Missing as why:
                    skip(target, why)
                except (OSError, ValueError, KeyError, IndexError) as error:
                    print(f"{name}/{label} ({mode}): harness produced no results ({error!r}); see {logs[target]}",
                          flush=True)
                    failed.add((mode, name))
                left[target] -= 1
                if not left[target] and target not in dropped:
                    collected[target].append(rows[target])
                    if len(collected[target]) == runs:
                        merged, flaky = merge(collected[target])
                        write_tsv(out / f"{name}.tsv", merged)
                        total = round(sum(seconds[target, label] for label in units[target]))
                        notes[out][name] = {"runs": runs, "seconds": total, "flaky": sorted(flaky)}
                        (out / "summary.json").write_text(json.dumps(notes[out], indent=1) + "\n")
                        write_summary(out, mode)
                        print(f"{name} ({mode}): {dict(collections.Counter(merged.values()))}, units {total} s",
                              flush=True)
        HISTORY.parent.mkdir(parents=True, exist_ok=True)
        HISTORY.write_text(json.dumps(history, indent=1, sort_keys=True) + "\n")
    wall = round(time.monotonic() - started)
    for mode, out, *_ in targets:
        notes[out]["wall"] = {"seconds": wall, "jobs": jobs}
        (out / "summary.json").write_text(json.dumps(notes[out], indent=1) + "\n")
        write_summary(out, mode)
    print(f"wall {wall} s with {jobs} jobs", flush=True)
    return failed


def run_mode(args):
    out = args.out.resolve()
    work = (args.work or ROOT / "build/floor" / args.mode).resolve()
    keep = lambda name, label: not args.unit or f"{name}/{label}" in args.unit
    corpora = args.corpus or sorted({u.split("/")[0] for u in args.unit or ()}, key=list(CORPORA).index) or CORPORA
    return 1 if run_targets([(args.mode, out, work, corpora, keep)], args.runs, args.jobs) else 0


def lost(floor, now, ids):
    """(id, status now) for each of ids that is PASS in floor and not PASS now."""
    return [(i, now.get(i, "MISSING")) for i in sorted(ids) if floor.get(i) == "PASS" and now.get(i) != "PASS"]


def compare(args):
    regressed = 0
    for floor_tsv in sorted(args.floor.glob("*.tsv")):
        mine = args.dir / floor_tsv.name
        if not mine.exists():
            print(f"{floor_tsv.stem}: not in {args.dir}, skipped")
            continue
        floor = read_tsv(floor_tsv)
        for i, status in lost(floor, read_tsv(mine), floor):
            print(f"{floor_tsv.stem}\t{i}\t{status}")
            regressed += 1
    print(f"{regressed} floor passes not passing")
    return 1 if regressed else 0


# --- quick: the per-change gate ---------------------------------------------------------------

FLOOR = ROOT / "results/floor/off"
SELECTION = ROOT / "results/floor/quick.tsv"
# Run whole on every change: the kernel programs in the plain, jit and jit-deopt lanes; difftest and
# jitcheck compiled at first call, without and with failing guards.
WHOLE = {"on": ["kernel"], "jit": ["kernel", "difftest", "jitcheck"], "deopt": ["kernel", "difftest", "jitcheck"]}
# Run as the units SELECTION lists, in the modes the change calls for.
SLICED = ["libtest", "fuzzdiff", "ft-cpython", "pypi", "numpy"]


def changed_paths(base):
    """Tracked paths that differ from where HEAD left base, committed or not; untracked files (logs, scratch)
    never count."""
    git = lambda *a: subprocess.run(["git", *a], cwd=ROOT, check=True, capture_output=True, text=True).stdout
    return set(git("diff", "--name-only", git("merge-base", base, "HEAD").strip()).split())


def slice_modes(paths):
    """Tests and docs alone: no slice. The tier alone: the slice compiled, at first call and with failing
    guards. Anything else (the interpreter, the kernel, lib/, the C-API, tools, results), or no change
    at all: the slice in those modes and with the tier off too."""
    light = lambda p: p.startswith(("tests/", "docs/", ".tickets/")) or p.endswith(".md")
    if paths and all(map(light, paths)):
        return []
    if paths and all(light(p) or p.startswith("runtime/jit/") for p in paths):
        return ["jit", "deopt"]
    return ["off", "jit", "deopt"]


def quick(args):
    started = time.monotonic()
    modes = slice_modes(changed_paths(args.base))
    print(f"quick: slice in {', '.join(modes) or 'no mode'} (changes against {args.base})", flush=True)
    build = ["make", f"-j{args.jobs}", "all", *(f"{v}={os.environ[v]}" for v in ("ORACLE_T", "HOST_PYTHON")
                                              if v in os.environ)]
    done = subprocess.run(build, cwd=ROOT, text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
    print(f"quick: build {round(time.monotonic() - started)} s", flush=True)
    if done.returncode:
        print(done.stdout[-5000:] + "quick: FAIL, the build failed")
        return 1
    selection = {line.split("\t")[0] for line in SELECTION.read_text().splitlines() if not line.startswith("#")}
    sliced = [name for name in SLICED if any(unit.startswith(name + "/") for unit in selection)]
    keep = lambda name, label: name not in SLICED or f"{name}/{label}" in selection
    out = args.out.resolve()
    shutil.rmtree(out, ignore_errors=True)
    targets = [(mode, out / mode, ROOT / "build/floor/quick-work" / mode,
                WHOLE.get(mode, []) + (sliced if mode in modes else []), keep)
               for mode in MODES if WHOLE.get(mode) or mode in modes]
    failed = run_targets(targets, 1, args.jobs)
    regressed = 0
    for mode, out, _, corpora, _ in targets:
        for name in corpora:
            path = out / f"{name}.tsv"
            if not path.exists():
                print(f"NOTRUN {mode} {name}")
                failed.add((mode, name))
                continue
            floor, now = read_tsv(FLOOR / path.name), read_tsv(path)
            if name not in SLICED:  # a whole corpus passes whole, as its gate does, tests newer than the floor too
                floor = dict.fromkeys(floor.keys() | now.keys(), "PASS")
            missed = lost(floor, now, now if name in SLICED else floor)
            if name == "kernel" and missed:
                missed = retry_kernel(mode, missed, ROOT / "build/floor/quick-work" / mode / "kernel-retry.log")
            for i, status in missed:
                print(f"LOST {mode} {name} {i} {status}")
                regressed += 1
    verdict = "FAIL" if regressed or failed else "PASS"
    print(f"quick: {verdict}, {regressed} floor passes lost, {len(failed)} corpora with units that gave no results"
          f" ({', '.join(sorted(f'{n} {m}' for m, n in failed))}); wall {round(time.monotonic() - started)} s")
    return 1 if verdict == "FAIL" else 0


def retry_kernel(mode, missed, log):
    """A kernel program's thread schedule varies with the host's load: each check that failed runs once
    more, alone, and fails the gate only if it fails again. Those that pass are printed as FLAKY."""
    names = set(kernel_programs())
    programs = sorted({i.split()[0] for i, _ in missed if i.split()[0] in names})
    again = kernelcheck(mode, ["--programs", " ".join(programs)], log) if programs else {}
    if any(i.split()[0] not in names | {"kernelcheck"} for i, _ in missed):
        again.update(kernelcheck(mode, ["--checks"], log))
    for i, status in missed:
        if again.get(i) == "PASS":
            print(f"FLAKY {mode} kernel {i} {status}, then PASS")
    return [(i, status) for i, status in missed if again.get(i) != "PASS"]


# --- select: which units quick runs --------------------------------------------------------------

# Parts of the standard library a change to the tier or the interpreter most often breaks.
TOPICS = re.compile(r"(^|[./])test_(re|json|pickle\w*|collections|itertools|functools|dataclasses|typing|enum|"
                    r"asyncio|threading|generators|coroutines|exceptions|traceback|frame|sys|sys_settrace|"
                    r"monitoring|gc|weakref|unicode\w*|str\w*|int|long|float|struct|io|memoryio|fileio|"
                    r"contextlib|scope|descr|class|dict|list|set|tuple|deque|operator|copy|bytes)($|[._])")


def units_of(corpus):
    """A sliced corpus's test id -> the labels of the units that report it."""
    if corpus == "libtest":
        owners = collections.defaultdict(set)
        for build in json.loads((ROOT / "results/libtest/inventory.json").read_text()).values():
            for module, entry in build.items():
                for case in entry["cases"]:
                    owners[case].add(module)
        return lambda i: owners.get(i, set())
    if corpus == "ft-cpython":
        owners = collections.defaultdict(set)
        for name, cases in json.loads((ROOT / "results/ft-cpython/inventory.json").read_text())["units"].items():
            for case in cases:
                owners[name.split("/")[0] + "/" + case].add(name)
        return lambda i: owners.get(i, set())
    if corpus == "numpy":
        return lambda i: {i.split("::")[0]}
    return lambda i: {i.split("/")[0]}  # fuzzdiff GENERATOR-sSEED/N, pypi PACKAGE/...


def select(args):
    """Score each unit of the sliced corpora that some floor pass belongs to, by what it caught per
    second, and take the best until the budget is spent."""
    seconds = {}  # a unit's cost is its slowest mode's
    for units in unit_history(args.history).values():
        for unit, took in units.items():
            seconds[unit] = max(took, seconds.get(unit, 0))
    passes, losses, broken = collections.Counter(), collections.Counter(), set()
    for corpus in SLICED:
        owner, floor = units_of(corpus), read_tsv(FLOOR / f"{corpus}.tsv")
        for i, status in floor.items():
            for label in owner(i) if status == "PASS" else ():
                passes[f"{corpus}/{label}"] += 1
        for directory, past in [(d, True) for d in args.past] + [(d, False) for d in args.now]:
            if (directory / f"{corpus}.tsv").exists():
                now = read_tsv(directory / f"{corpus}.tsv")
                hit = {f"{corpus}/{label}" for i, _ in lost(floor, now, now) for label in owner(i)}
                losses.update(hit) if past else broken.update(hit)
    scored = []
    for unit in passes:
        cost = seconds.get(unit)
        if unit in broken or cost is None or cost > args.max_unit:
            continue  # failing now, never timed, or too long to run beside the rest
        topic = unit.startswith(("libtest/", "ft-cpython/")) and bool(TOPICS.search(unit.split("/", 1)[1]))
        value = math.sqrt(passes[unit]) * (1 + losses[unit]) * (2 if topic else 1)
        scored.append((value / max(cost, 1), unit, cost, losses[unit], topic, passes[unit]))
    scored.sort(reverse=True)
    # Units that caught the tier before first, then each corpus's best, then by score; a Lib/test module once,
    # from libtest or ft-cpython's serial lane.
    catchers = [row for row in scored if row[3]]
    firsts = [next(row for row in scored if row[1].startswith(corpus + "/")) for corpus in SLICED
              if any(row[1].startswith(corpus + "/") for row in scored)]
    module = lambda unit: re.sub(r"^(libtest|ft-cpython/serial)/", "", unit)
    rows, spent, taken = [], 0, set()
    for score, unit, cost, caught, topic, count in catchers + firsts + scored:
        if spent + cost <= args.budget and module(unit) not in taken:
            spent += cost
            taken.add(module(unit))
            rows.append(f"{unit}\t{cost}\t{caught}\t{int(topic)}\t{count}\t{score:.3f}")
    SELECTION.write_text(
        f"# tools/floor select: {len(rows)} units, {round(spent)} s of {args.budget} budget per mode, units over "
        f"{args.max_unit} s left out; {len(args.past)} past and {len(args.now)} current tier runs\n"
        "# unit\tseconds\tpast runs it lost passes in\tstdlib topic\tfloor passes\tscore\n" + "\n".join(rows) + "\n")
    print(f"{len(rows)} units, {round(spent)} s; by corpus {dict(collections.Counter(r.split('/')[0] for r in rows))}")
    return 0


def main():
    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="action", required=True)
    r = sub.add_parser("run")
    r.add_argument("--mode", choices=MODES, required=True)
    r.add_argument("--out", type=Path, required=True)
    r.add_argument("--work", type=Path, help="logs and scratch results (default build/floor/MODE)")
    r.add_argument("--corpus", action="append", choices=CORPORA)
    r.add_argument("--unit", action="append", help="CORPUS/LABEL: run this unit alone (repeatable)")
    r.add_argument("--runs", type=int, default=1)
    r.add_argument("--jobs", type=int, default=len(os.sched_getaffinity(0)),
                   help="units run at once (default: every CPU this process may use)")
    c = sub.add_parser("compare")
    c.add_argument("floor", type=Path)
    c.add_argument("dir", type=Path)
    q = sub.add_parser("quick")
    q.add_argument("--base", default="origin/master", help="what the change is against (default origin/master)")
    q.add_argument("--out", type=Path, default=ROOT / "build/floor/quick")
    q.add_argument("--jobs", type=int, default=len(os.sched_getaffinity(0)))
    s = sub.add_parser("select")
    s.add_argument("--past", type=Path, action="append", default=[],
                   help="an earlier floor run of the tier (jit or deopt); a unit that lost passes there scores higher")
    s.add_argument("--now", type=Path, action="append", default=[],
                   help="a floor run of the tier on master; a unit that loses passes there is left out")
    s.add_argument("--history", type=Path, default=HISTORY, help="unit seconds (default build/floor/unit-seconds.json)")
    s.add_argument("--budget", type=float, required=True, help="unit seconds per mode")
    s.add_argument("--max-unit", type=float, default=240)
    args = p.parse_args()
    return {"run": run_mode, "compare": compare, "quick": quick, "select": select}[args.action](args)


if __name__ == "__main__":
    sys.exit(main())
