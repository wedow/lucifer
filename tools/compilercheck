#!/usr/bin/env python3
"""Check the runtime's compiler against the free-threaded CPython 3.14 oracle.

usage: compilercheck --lucifer BIN --oracle PYTHON [--corpus a,b] [--require a,b] [FILE...]

For each file of a corpus, marshal.dumps(compile(source, path, "exec")) must be
the same bytes on BIN as on the oracle (a SyntaxError or other error must be
the same message). Run with a host CPython whose version matches
third_party/cpython/VERSION.

Corpora: closure (tests/compiler/closure.txt: the vendored Lib files of the 64
modules `-X importtime` reports on the oracle for the difftest probe and for
tools/difftest/bridge.py running a one-line program), difftest (the
cases and dependencies of tests/diff/inventory.json), kernel (tests/kernel),
lib (every vendored Lib/**/*.py). Exit status 1 when a corpus named with
--require is not fully identical.
"""
import argparse
import concurrent.futures
import json
from pathlib import Path
import subprocess
import sys

ROOT = Path(__file__).resolve().parent.parent
LIB = ROOT / "third_party" / "cpython" / "Lib"
TIMEOUT = 120


def corpus(name):
    if name == "closure":
        return [LIB / line for line in (ROOT / "tests/compiler/closure.txt").read_text().split()]
    if name == "difftest":
        inventory = json.loads((ROOT / "tests/diff/inventory.json").read_text())
        return sorted(ROOT / p for p in [*inventory["cases"], *inventory.get("dependencies", {})]
                      if p.endswith(".py"))
    if name == "kernel":
        return sorted((ROOT / "tests/kernel").rglob("*.py"))
    if name == "lib":
        return sorted(LIB.rglob("*.py"))
    raise SystemExit(f"unknown corpus {name}")


def first_difference(a, b):
    a, b = repr(a), repr(b)
    i = next((i for i, (x, y) in enumerate(zip(a, b)) if x != y), min(len(a), len(b)))
    return f"host …{a[max(0, i - 60):i + 60]}… ours …{b[max(0, i - 60):i + 60]}…"


# The free-threaded build frees code objects only when the cycle collector runs,
# and a code object the compiler merged away until then still shares its tables
# with the survivor, which marshal records. When the collector runs depends on
# the process's memory, so both sides run without it.
DRIVER = """
import gc, marshal, sys
gc.disable()
for path in sys.argv[1:]:
    try:
        print(path, marshal.dumps(compile(open(path, "rb").read(), path, "exec", 0, True)).hex(), flush=True)
    except BaseException as error:
        print(path, "raised", type(error).__name__, error, flush=True)
"""


def run_driver(interpreter, paths):
    """{path: output line} of DRIVER run by interpreter -I -S over paths (relative to ROOT)."""
    child = subprocess.run([interpreter, "-I", "-S", "-c", DRIVER, *paths], cwd=ROOT,
                           capture_output=True, text=True, errors="replace", timeout=TIMEOUT * len(paths))
    lines = {line.split(" ", 1)[0]: line for line in child.stdout.splitlines()}
    return {p: lines.get(p, f"{p} no output (exit {child.returncode}): {child.stderr.strip()[-300:]}")
            for p in paths}


def check_runtime(lucifer, oracle, paths, jobs):
    """{path: None if the runtime's marshaled code equals the oracle's else a difference}."""
    relative = [str(p.relative_to(ROOT)) for p in paths]
    chunks = [chunk for chunk in (relative[i::jobs] for i in range(jobs)) if chunk]
    with concurrent.futures.ThreadPoolExecutor(2 * jobs) as pool:
        ours = pool.map(run_driver, [lucifer] * len(chunks), chunks)
        theirs = pool.map(run_driver, [oracle] * len(chunks), chunks)
        ours = {k: v for d in ours for k, v in d.items()}
        theirs = {k: v for d in theirs for k, v in d.items()}
    return {ROOT / p: None if ours[p] == theirs[p] else first_difference(theirs[p], ours[p]) for p in relative}


def check_version():
    want = (LIB.parent / "VERSION").read_text().split()[1].lstrip("v")
    have = "%d.%d.%d" % sys.version_info[:3]
    if have != want or sys.version_info.releaselevel != "final":
        raise SystemExit(f"host Python {have} does not match vendored CPython {want}")


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--corpus", default="closure,difftest,kernel,lib", help="comma-separated corpora")
    parser.add_argument("--require", default="", help="corpora that must be fully identical")
    parser.add_argument("--jobs", type=int, default=4)
    parser.add_argument("--show", type=int, default=5, help="differences listed per corpus")
    parser.add_argument("--lucifer", required=True, help="the runtime to check")
    parser.add_argument("--oracle", required=True, help="free-threaded CPython 3.14 that --lucifer is compared with")
    parser.add_argument("files", nargs="*", type=Path, help="check these files instead of corpora")
    args = parser.parse_args()
    check_version()
    corpora = {"files": [p.resolve() for p in args.files]} if args.files else {
        name: corpus(name) for name in args.corpus.split(",")}
    failed = False
    for name, paths in corpora.items():
        results = check_runtime(args.lucifer, args.oracle, paths, args.jobs)
        bad = {p: r for p, r in results.items() if r is not None}
        print(f"{name}: {len(paths) - len(bad)} of {len(paths)} files marshal identically on {args.lucifer}")
        for path, difference in list(bad.items())[:args.show]:
            print(f"    {path.relative_to(ROOT)}: {difference}")
        failed |= bool(bad) and name in args.require.split(",")
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main())
