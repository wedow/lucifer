#!/usr/bin/env python3
"""Daily status pass on a built tree: gates, AWFY timing, the web benchmark, conformance, optional numpy.

Writes results/status-DATE/{summary.csv,summary.md,*.log}. Run from the repository root.

Environment:
  LUCIFER        the executable under test (default bin/lucifer)
  ORACLE_T       the CPython 3.14t reference interpreter
  HOST_PYTHON    passed to make for host-side tools
  TIMING_PREFIX  command words put in front of each timed step (an exclusive lock, say)
  TEST_PREFIX    command words put in front of each gate and numpy shard
  NUMPY_SITE, NUMPY_CACHE, NUMPY_WORK  site-packages, wheel cache and raw-log directory (--numpy)
  WEB_SITE       site-packages with Flask for the 3.14t ABI (the web benchmark; skipped when unset)
  WEB_GIL_PYTHON a CPython 3.14 GIL interpreter that imports Flask (--refresh-reference only)

CPython timings come from results/status-reference.json; --refresh-reference rewrites it.
"""
import argparse
import csv
import datetime
import importlib.machinery
import importlib.util
import json
import math
import os
from pathlib import Path
import re
import shlex
import subprocess
import sys

ROOT = Path(__file__).resolve().parents[1]
REFERENCE = ROOT / "results/status-reference.json"
AWFY = ROOT / "third_party/awfy/Python"
WEB = ROOT / "tools/bench/web/bench"
WEB_CPUS = "1,2,4,8"
WEB_SCORE_CPUS = "8"  # the composite speed score takes the web point that uses every core: no GIL is the point
LUCIFER = str(Path(os.environ.get("LUCIFER", "bin/lucifer")).resolve())


def awfy_inner():
    """The canonical inner counts, from the AWFY driver."""
    sys.path.insert(0, str(ROOT / "tools/bench"))
    path = str(ROOT / "tools/bench/awfy")
    spec = importlib.util.spec_from_loader("awfy_driver", importlib.machinery.SourceFileLoader("awfy_driver", path))
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module.INNER


def words(prefix):
    return shlex.split(os.environ.get(prefix, ""))


def run(argv, prefix="", cwd=ROOT):
    return subprocess.run(words(prefix) + argv, cwd=cwd, text=True, errors="replace",
                          stdout=subprocess.PIPE, stderr=subprocess.STDOUT)


# --- timing -----------------------------------------------------------------

def time_one(names, iters, commands):
    """Worker: per benchmark, best-of-iters microseconds per labelled command, as JSON on stdout."""
    inner = awfy_inner()
    result = {}
    for name in names:
        result[name] = {}
        for label, command in commands.items():
            done = subprocess.run(shlex.split(command) + ["harness.py", name, str(iters), str(inner[name])], cwd=AWFY,
                                  text=True, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
            samples = [int(m[1]) for m in re.finditer(rf"^{name}: iterations=1 runtime: (\d+)us$", done.stdout, re.M)]
            result[name][label] = min(samples) if done.returncode == 0 and len(samples) == iters else None
    print(json.dumps(result))


def timings(names, iters, commands):
    """All benchmarks in one prefixed step: one wait for the host, however busy."""
    done = run([sys.executable, __file__, "time", ",".join(names), "--iters", str(iters)]
               + [f"--run={label}={command}" for label, command in commands.items()], "TIMING_PREFIX")
    try:
        return json.loads(done.stdout.strip().splitlines()[-1])
    except (ValueError, IndexError):
        return {name: {label: None for label in commands} for name in names}


def oracle_version(oracle):
    return run([oracle, "-c", "import sys; print(sys.version)"]).stdout.strip()


def web_timings(runs):
    """The web benchmark per runtime and server CPU count: {runtime: {cpus: point}}."""
    done = run([sys.executable, str(WEB), "time", "--cpus", WEB_CPUS] + [f"--run={n}={c}" for n, c in runs.items()],
               "TIMING_PREFIX")
    points = {}
    for line in done.stdout.splitlines():
        if line.startswith("{"):
            p = json.loads(line)
            points.setdefault(p["runtime"], {})[str(p["cpus"])] = {k: p[k] for k in ("rps", "p50_ms", "p99_ms", "errors", "server_exit")}
    return points, done.stdout


def web_check(oracle, site):
    done = run([sys.executable, str(WEB), "check", f"--run=cpython-3.14t=env PYTHONPATH={site} {oracle}",
                f"--run=lucifer=env PYTHONPATH={site} {LUCIFER}"], "TEST_PREFIX")
    return done.returncode == 0, done.stdout


def refresh_reference(names, iters, oracle):
    times = timings(names, iters, {"cpython": oracle})
    site, gil = os.environ.get("WEB_SITE"), os.environ.get("WEB_GIL_PYTHON")
    web = web_timings({"cpython-3.14": gil, "cpython-3.14t": f"env PYTHONPATH={site} {oracle}"})[0] if site and gil else {}
    REFERENCE.write_text(json.dumps({"version": oracle_version(oracle),
                                     "best_us": {n: times[n]["cpython"] for n in names},
                                     "web": web}, indent=1) + "\n")


# --- gates and conformance --------------------------------------------------

def make_targets():
    check = re.search(r"^check:(.*)$", (ROOT / "Makefile").read_text(), re.M)[1].split()
    return check + ["check-jit"]


def gates(out):
    flags = [f"{v}={os.environ[v]}" for v in ("ORACLE_T", "HOST_PYTHON") if v in os.environ]
    rows = {}
    for target in make_targets():
        done = run(["make", target] + flags, "TEST_PREFIX")
        (out / f"{target}.log").write_text(done.stdout)
        detail = [l for l in done.stdout.splitlines() if re.search(r"\d+/\d+ checks pass|failing|^FAIL|^PASS difftest", l)]
        rows[target] = (done.returncode == 0, "; ".join(l[:200] for l in detail[:6]))
    return rows


def kernel_counts(out):
    counts = {}
    for target in ("check-kernel", "check-kernel-jit"):
        log = out / f"{target}.log"
        for m in re.finditer(r"(\d+)/(\d+) checks pass \((\S+)\)", log.read_text() if log.exists() else ""):
            counts[f"conformance.kernel.{m[3]}.pass"], counts[f"conformance.kernel.{m[3]}.total"] = int(m[1]), int(m[2])
    return counts


def difftest_counts():
    """Difftest passes per lane of the check-jit gate just run (build/difftest/LANE/lucifer.tsv)."""
    counts = {}
    for path in sorted((ROOT / "build/difftest").glob("*/lucifer.tsv")):
        statuses = [r["status"] for r in csv.DictReader(path.open(), delimiter="\t")]
        lane = path.parent.name
        counts[f"conformance.difftest.{lane}.pass"], counts[f"conformance.difftest.{lane}.total"] = statuses.count("PASS"), len(statuses)
    return counts


def numpy_date():
    """When the numpy shards behind results/numpytest/lucifer.tsv last ran."""
    stamps = [json.loads(p.read_text()).get("recorded_at", "") for p in (ROOT / "results/numpytest").glob("lucifer-*.json")]
    return max(stamps)[:10] if any(stamps) else None


def libtest_core():
    """Lib/test passes in the core-type modules Lucifer runs, for Lucifer and the oracle."""
    results = ROOT / "results/libtest"
    modules = json.loads((results / "lucifer.json").read_text())["modules"]
    status = {rt: {r["id"]: r["status"] for r in csv.DictReader((results / f"{rt}.tsv").open(), delimiter="\t")}
              for rt in ("lucifer", "cpython-3.14.10t")}
    core = [i for i in status["cpython-3.14.10t"] if i.startswith(tuple(f"test.{m}." for m in modules))]
    counts = {f"conformance.libtest-core.{tag}.pass": sum(status[rt].get(i) == "PASS" for i in core)
              for tag, rt in (("lucifer", "lucifer"), ("oracle", "cpython-3.14.10t"))}
    # The daily never runs Lib/test: its counts date from the last committed run.
    counts["conformance.libtest-core.date"] = run(["git", "log", "-1", "--format=%cs", "--", str(results / "lucifer.tsv")]).stdout.strip()
    return counts


def conformance(out):
    metrics = {**kernel_counts(out), **difftest_counts()}
    board = run([sys.executable, "tools/scoreboard"]).stdout
    (out / "scoreboard.tsv").write_text(board)
    for row in csv.DictReader(board.splitlines(), delimiter="\t"):
        if row["suite"] in ("libtest", "numpytest") and row["runtime"] in ("lucifer", "cpython-3.14.10t"):
            tag = "lucifer" if row["runtime"] == "lucifer" else "oracle"
            metrics[f"conformance.{row['suite']}.{tag}.pass"] = int(row["PASS"])
            metrics[f"conformance.{row['suite']}.total"] = int(row["total"])
    metrics["conformance.numpytest.date"] = numpy_date()
    metrics.update(libtest_core())
    audit = run(["make", "abi-audit"]).stdout
    (out / "abi-audit.log").write_text(audit)
    m = re.search(r"functions:\s+(\d+) implemented, (\d+) stubs, of (\d+)", audit)
    if m:
        metrics["capi.implemented"], metrics["capi.stubs"], metrics["capi.total"] = map(int, m.groups())
    return metrics


def numpy(out):
    from_env = [os.environ.get(v) for v in ("NUMPY_SITE", "NUMPY_CACHE", "NUMPY_WORK")]
    if not all(from_env):
        return {}, ["numpy: NUMPY_SITE, NUMPY_CACHE and NUMPY_WORK must be set"]
    site, cache, work = from_env
    ids = [r["id"] for r in csv.DictReader((ROOT / "results/numpytest/expected.tsv").open(), delimiter="\t")]
    shards = sorted({i.split("::")[0] if i.startswith("numpy/_core/") else "/".join(i.split("/")[:2]) for i in ids})
    for shard in shards:
        done = run([sys.executable, "tools/numpytest/run.py", "run", "--python", LUCIFER, "--runtime", "lucifer",
                    "--site", site, "--cache", cache, "--work", work, "--shard", shard], "TEST_PREFIX")
        (out / "numpytest.log").open("a").write(f"== {shard} exit {done.returncode}\n{done.stdout[-2000:]}\n")
    counts = {}
    for row in csv.DictReader((ROOT / "results/numpytest/lucifer.tsv").open(), delimiter="\t"):
        counts[row["status"]] = counts.get(row["status"], 0) + 1
    return {f"numpy.{s.lower()}": n for s, n in counts.items()}, []


# --- records ----------------------------------------------------------------

def previous_summary(date):
    earlier = sorted(p for p in (ROOT / "results").glob("status-*/summary.csv") if p.parent.name < f"status-{date}")
    if not earlier:
        return {}
    return {r["metric"]: r["value"] for r in csv.DictReader(earlier[-1].open())}


def geomean(values):
    return math.exp(sum(map(math.log, values)) / len(values)) if values else None


def fmt(x, digits=3):
    return "-" if x is None else f"{x:.{digits}f}"


def delta(now, before):
    return "-" if now is None or before in (None, "") else f"{100 * (now / float(before) - 1):+.1f}%"


def web_section(metrics, before):
    """req/s per runtime and server CPU count; efficiency is req/s over N times 1 CPU's."""
    runtimes = ("cpython-3.14", "cpython-3.14t", "lucifer")
    counts = sorted({int(k.rsplit(".", 2)[1]) for k in metrics if k.startswith("web.") and k.endswith(".rps")})
    if not counts:
        return []
    def rps(r, n):
        return metrics.get(f"web.{r}.{n}.rps")
    def eff(r, n):
        return rps(r, n) / (n * rps(r, 1)) if rps(r, n) and rps(r, 1) else None
    md = ["", "## Web (Flask Todo app, thread per connection, req/s; efficiency = req/s / (CPUs x 1-CPU req/s))", "",
          "| CPUs | 3.14 | 3.14t | Lucifer | Lucifer p50 ms | Lucifer p99 ms | Lucifer/3.14t | eff 3.14 | eff 3.14t | eff Lucifer | Lucifer vs yesterday |",
          "|---|---|---|---|---|---|---|---|---|---|---|"]
    for n in counts:
        a, t, l = (rps(r, n) for r in runtimes)
        md.append(f"| {n} | {fmt(a, 0)} | {fmt(t, 0)} | {fmt(l, 0)} | {fmt(metrics.get(f'web.lucifer.{n}.p50_ms'), 2)} "
                  f"| {fmt(metrics.get(f'web.lucifer.{n}.p99_ms'), 2)} | {fmt(l / t if l and t else None)} "
                  f"| {' | '.join(fmt(eff(r, n), 2) for r in runtimes)} | {delta(l, before.get(f'web.lucifer.{n}.rps'))} |")
    return md


def write_summary(out, date, metrics, gate_rows, problems, names, ran_numpy):
    before = previous_summary(date)
    with (out / "summary.csv").open("w", newline="") as f:
        w = csv.writer(f)
        w.writerow(["metric", "value", "previous"])
        for k, v in metrics.items():
            w.writerow([k, "" if v is None else v, before.get(k, "")])
    val = metrics.get
    md = [f"# Lucifer status {date}", "", "## AWFY (best iteration, ms; ratio is JIT on / CPython)", "",
          "| benchmark | CPython | JIT on | on/CPython | on vs yesterday |", "|---|---|---|---|---|"]
    for n in names:
        c, on = (val(f"awfy.{n}.{k}_us") for k in ("cpython", "on"))
        md.append(f"| {n} | {fmt(c and c / 1000, 1)} | {fmt(on and on / 1000, 1)} "
                  f"| {fmt(val(f'awfy.{n}.on_over_cpython'))} | {delta(on, before.get(f'awfy.{n}.on_us'))} |")
    md += ["", f"Geomean JIT on / CPython: {fmt(val('awfy.geomean_on_over_cpython'))} "
           f"(yesterday {fmt(float(before['awfy.geomean_on_over_cpython']) if before.get('awfy.geomean_on_over_cpython') else None)})"]
    md += web_section(metrics, before)
    md += ["", "## Gates", "", "| target | result | detail |", "|---|---|---|"]
    md += [f"| {t} | {'pass' if ok else 'FAIL'} | {d} |" for t, (ok, d) in gate_rows.items()]
    md += ["", "## Conformance", "", "| metric | value | previous |", "|---|---|---|"]
    md += [f"| {k.removeprefix('conformance.')} | {v} | {before.get(k, '-')} |" for k, v in metrics.items()
           if k.startswith(("conformance.", "capi.", "numpy."))]
    if not ran_numpy:
        md.append("| numpy | not run | |")
    md += ["", "## Problems", ""] + ([f"- {p}" for p in problems] or ["none"])
    (out / "summary.md").write_text("\n".join(md) + "\n")


def main():
    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--out", type=Path)
    p.add_argument("--iters", type=int, default=3, help="iterations per timed run; the best counts")
    p.add_argument("--numpy", action="store_true", help="also run the full numpy suite")
    p.add_argument("--refresh-reference", action="store_true", help="re-time CPython into results/status-reference.json and exit")
    sub = p.add_subparsers(dest="worker")
    t = sub.add_parser("time", help=argparse.SUPPRESS)
    t.add_argument("names")
    t.add_argument("--iters", type=int, dest="witers")
    t.add_argument("--run", action="append", dest="runs")
    args = p.parse_args()
    oracle = os.environ.get("ORACLE_T", "python3.14t")
    if args.worker:
        return time_one(args.names.split(","), args.witers, dict(r.split("=", 1) for r in args.runs))
    names = sorted(awfy_inner())
    if args.refresh_reference:
        return refresh_reference(names, args.iters, oracle)
    date = datetime.datetime.now(datetime.timezone.utc).strftime("%F")
    out = args.out or ROOT / "results" / f"status-{date}"
    out.mkdir(parents=True, exist_ok=True)
    problems = []
    gate_rows = gates(out)
    problems += [f"gate {t} failed" for t, (ok, _) in gate_rows.items() if not ok]
    commands = {"on": LUCIFER}
    times = timings(names, args.iters, commands)
    ref = json.loads(REFERENCE.read_text()) if REFERENCE.exists() else {"version": None, "best_us": {}}
    if not REFERENCE.exists():
        problems.append("no CPython reference; run --refresh-reference")
    elif ref["version"] != oracle_version(oracle):
        problems.append("CPython reference is for a different version; run --refresh-reference")
    metrics = {}
    for n in names:
        c = ref["best_us"].get(n)
        on = times[n]["on"]
        metrics.update({f"awfy.{n}.cpython_us": c, f"awfy.{n}.on_us": on,
                        f"awfy.{n}.on_over_cpython": on / c if on and c else None})
        if on is None:
            problems.append(f"AWFY {n}: JIT on produced no timing")
    metrics["awfy.geomean_on_over_cpython"] = geomean([metrics[f"awfy.{n}.on_over_cpython"] for n in names if metrics[f"awfy.{n}.on_over_cpython"]])
    site = os.environ.get("WEB_SITE")
    if site:
        ok, log = web_check(oracle, site)
        points, timing_log = web_timings({"lucifer": f"env PYTHONPATH={site} {LUCIFER}"})
        (out / "web.log").write_text(log + timing_log)
        if not ok:
            problems.append("web check failed (web.log)")
        if not points:
            problems.append("web benchmark produced no timing (web.log)")
        for runtime, by_cpus in {**ref.get("web", {}), **points}.items():
            for n, p in by_cpus.items():
                metrics.update({f"web.{runtime}.{n}.{k}": v for k, v in p.items() if k != "server_exit"})
                if p["errors"]:
                    problems.append(f"web {runtime} at {n} CPUs: {p['errors']} errors")
                if p.get("server_exit") is not None:
                    problems.append(f"web {runtime} at {n} CPUs: server died (exit {p['server_exit']})")
        t, l = (metrics.get(f"web.{r}.{WEB_SCORE_CPUS}.rps") for r in ("cpython-3.14t", "lucifer"))
        metrics["web.flask.on_over_cpython"] = t / l if t and l else None
    else:
        problems.append("web benchmark skipped: WEB_SITE is not set")
    numpy_metrics = {}
    if args.numpy:
        numpy_metrics, numpy_problems = numpy(out)
        problems += numpy_problems
    metrics.update(conformance(out))
    metrics.update(numpy_metrics)
    metrics.update({f"gate.{t}": int(ok) for t, (ok, _) in gate_rows.items()})
    write_summary(out, date, metrics, gate_rows, problems, names, args.numpy)
    print(f"status: {out.relative_to(ROOT) if out.is_relative_to(ROOT) else out}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
