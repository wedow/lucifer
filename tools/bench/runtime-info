#!/usr/bin/env python3
"""Record build/runtime capabilities and test whether PYTHON_JIT=1 works."""
import argparse
import json
from pathlib import Path

from common import PROBE, ROOT, command, probe, public_data, run, runtime_name, write_json

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--python', required=True)
parser.add_argument('--runtime', type=runtime_name, required=True)
parser.add_argument('--output', type=Path, default=ROOT / 'results/bench/runtimes.json')
args = parser.parse_args()
argv = command(args.python)
default = probe(argv)
enabled = None
if default:
    status, out, _, _ = run(argv + ['-c', PROBE], env_overrides={'PYTHON_JIT': '1'})
    if status == 'PASS':
        enabled = json.loads(out)
data = json.loads(args.output.read_text()) if args.output.exists() else {}
data[args.runtime] = public_data(dict(default=default, python_jit_1=enabled,
    jit_followup='separate JIT-capable build required' if default and not default['jit_available'] else None))
write_json(args.output, data)
