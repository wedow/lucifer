#!/usr/bin/env python3
"""The broad benchmark corpus: pinned upstream programs, run unmodified and identically by every runtime.

Suites:
  pyperformance  every benchmark in the pinned pyperformance release's MANIFEST, as
                 `run_benchmark.py [extra_opts] --worker -l LOOPS -w 1 -n 3 -o FILE`;
                 a program's time is the sum over its pyperf benchmarks of the best value
  cli            real command-line programs over files from third_party/cpython;
                 a program's time is the best wall time of 3 runs after a warm-up run
  cadence        scripts shipped in the cadence-net release (a numpy brain simulation),
                 timed as cli programs; the lock unpacks the release tree beside SITE

Every program runs as `COMMAND ARGS` with PYTHONPATH=SITE and nothing else changed.

  corpus prepare SITE              install corpus.lock.json into SITE (hash-checked downloads, cached)
  corpus time SITE --run COMMAND   one JSON object, {program: result}, on the last stdout line
      --reference FILE             measure against a reference produced without it: the same
                                   pyperf loops, and an output that must match the reference's

Without --reference the run calibrates: LOOPS is set so one pyperf value takes about
TARGET seconds, and each program's check (its pyperf benchmark names and a hash of its
stderr, or a hash of a CLI program's exit status and stdout) is recorded. A result is
{"status": ok|fail|crash|timeout|wrong, "seconds": best or null, "loops", "check"}.
Host stdlib only.
"""
import argparse
import hashlib
import json
import os
from pathlib import Path
import shlex
import shutil
import subprocess
import sys
import tarfile
import tempfile
import time
import tomllib
import urllib.request
import zipfile

HERE = Path(__file__).resolve().parent
ROOT = HERE.parents[1]
LOCK = HERE / "corpus.lock.json"
CACHE = Path(os.environ.get("XDG_CACHE_HOME") or Path.home() / ".cache") / "lucifer-corpus"
TARGET = 0.1   # seconds per pyperf value on the calibrating runtime
WARMUPS, VALUES, RUNS = 1, 3, 3
TIMEOUT = 300  # seconds per run
# Benchmarks the MANIFEST lists that the lock does not install.
EXCLUDED = {"dask": "a distributed cluster over psutil, msgpack and dozens more"}
# Inputs come from third_party/cpython as src/..., relative so the output names no checkout:
# upstream Lib/ files, which the vendoring never modifies (CHANGES.md changes with it).
CLI = {
    "black": ["-m", "black", "-q", "-", "<", "src/Lib/textwrap.py"],
    "isort": ["-m", "isort", "-", "<", "src/Lib/typing.py"],
    "pyflakes": ["-m", "pyflakes", "src/Lib/email", "src/Lib/json", "src/Lib/asyncio"],
    "pycodestyle": ["-m", "pycodestyle", "--max-line-length=100", "src/Lib/email", "src/Lib/json"],
    "pygments": ["-m", "pygments", "-l", "python", "-f", "html", "src/Lib/typing.py"],
    "markdown": ["-m", "markdown", "src/Lib/idlelib/NEWS2x.txt"],
}
# Scripts in the cadence-net release tree, which is GPL-3.0: fetched by the lock, never committed.
# The examples run as shipped; the two benchmark chambers get one small cell of their grid.
CADENCE = {
    "continuing_brain": ["examples/continuing_brain.py"],
    "walking_rhythm": ["examples/walking_rhythm.py"],
    "walking_for_reward": ["examples/walking_for_reward.py"],
    "bandit": ["benchmarks/extinction/bandit.py", "--thetas", "0.5", "--fails", "0", "--seeds", "0",
               "--out", "/dev/stdout"],
    "night_replay": ["benchmarks/replay/night_replay.py", "--world", "signal", "--settings", "defaults",
                     "--seeds", "1", "--rounds", "1"],
}


def cadence_tree(site):
    """Where the lock unpacked the cadence-net release (a vendored copy would live under third_party/)."""
    return site.parent / "cadence-net"


# --- installation -----------------------------------------------------------

def fetch(entry, cache):
    path = cache / entry["url"].rsplit("/", 1)[1]
    if not path.exists():
        cache.mkdir(parents=True, exist_ok=True)
        part = path.with_suffix(".part")
        with urllib.request.urlopen(entry["url"], timeout=120) as response, part.open("wb") as out:
            shutil.copyfileobj(response, out)
        part.replace(path)
    if hashlib.sha256(path.read_bytes()).hexdigest() != entry["sha256"]:
        raise SystemExit(f"corpus: hash mismatch for {path.name}")
    return path


def install(entry, archive, site):
    """A wheel unpacks into SITE; a pure-Python sdist contributes its one package directory,
    and with "tree" its whole top directory too, as SITE/../NAME."""
    if "package" not in entry:
        with zipfile.ZipFile(archive) as wheel:
            for name in wheel.namelist():
                if name.endswith("/"):
                    continue
                parts = name.split("/")
                if parts[0].endswith(".data"):
                    if parts[1] not in ("purelib", "platlib"):
                        continue
                    parts = parts[2:]
                target = site.joinpath(*parts)
                target.parent.mkdir(parents=True, exist_ok=True)
                target.write_bytes(wheel.read(name))
        return
    with tempfile.TemporaryDirectory(dir=site) as temp, tarfile.open(archive) as sdist:
        sdist.extractall(temp, filter="data")
        package = Path(temp, entry["package"])
        shutil.copytree(package, site / package.name, dirs_exist_ok=True)
        if "tree" in entry:
            shutil.rmtree(site.parent / entry["name"], ignore_errors=True)
            shutil.copytree(Path(temp, entry["tree"]), site.parent / entry["name"])


def prepare(site, cache):
    stamp = site / ".lock-sha256"
    digest = hashlib.sha256(LOCK.read_bytes()).hexdigest()
    if stamp.exists() and stamp.read_text() == digest:
        return
    shutil.rmtree(site, ignore_errors=True)
    site.mkdir(parents=True)
    for entry in json.loads(LOCK.read_text()):
        install(entry, fetch(entry, cache), site)
    # What bm_2to3 would pip-install itself when lib2to3 (gone since 3.13) is missing.
    shutil.copytree(site / "pyperformance/data-files/benchmarks/bm_2to3/vendor/src/lib2to3", site / "lib2to3",
                    dirs_exist_ok=True)
    stamp.write_text(digest)


# --- programs ---------------------------------------------------------------

def pyperformance(site):
    """{name: argv} for every benchmark in the installed MANIFEST, in the pyperformance way."""
    root = site / "pyperformance/data-files/benchmarks"
    lines = (root / "MANIFEST").read_text().split("[benchmarks]", 1)[1].split("[group", 1)[0].splitlines()
    found = {}
    for line in lines:
        fields = line.split("\t")
        if len(fields) != 2 or fields[0] == "name" or line.startswith("#") or fields[0] in EXCLUDED:
            continue
        name, meta = fields
        base = meta.removeprefix("<local").removesuffix(">").removeprefix(":") or name
        folder = root / f"bm_{base}"
        project = tomllib.loads((folder / ("pyproject.toml" if base == name else f"bm_{name}.toml")).read_text())
        extra = project.get("tool", {}).get("pyperformance", {}).get("extra_opts", [])
        found[name] = [str(folder / "run_benchmark.py"), *extra]
    return found


def programs(site):
    return {**{f"pyperformance.{n}": ("pyperf", a) for n, a in pyperformance(site).items()},
            **{f"cli.{n}": ("cli", a) for n, a in CLI.items()},
            **{f"cadence.{n}": ("cli", [str(cadence_tree(site) / a[0]), *a[1:]]) for n, a in CADENCE.items()}}


# --- measurement ------------------------------------------------------------

def execute(argv, site, cwd, timeout):
    """(status, stdout, stderr, wall seconds) of one run with PYTHONPATH=SITE; ARGV may end in "<", FILE.

    The output names the site and the scratch directory CWD as SITE and CWD, so it compares across checkouts."""
    env = {**os.environ, "PYTHONPATH": str(site)}
    argv, stdin = (argv[:-2], Path(cwd, argv[-1]).read_bytes()) if argv[-2:-1] == ["<"] else (argv, b"")
    start = time.perf_counter()
    try:
        done = subprocess.run(argv, cwd=cwd, env=env, input=stdin, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                              timeout=timeout)
    except subprocess.TimeoutExpired:
        return "timeout", b"", b"", timeout
    wall = time.perf_counter() - start
    out, err = (text.replace(str(site).encode(), b"SITE").replace(str(cwd).encode(), b"CWD")
                for text in (done.stdout, done.stderr))
    status = "crash" if done.returncode < 0 else "ok" if done.returncode == 0 else "fail"
    return status, out, err, wall


def pyperf_run(command, argv, site, loops, values, warmups):
    """(status, {benchmark: (best seconds per loop, inner loops per loop)}, stderr digest)."""
    with tempfile.TemporaryDirectory() as temp:
        out = Path(temp) / "result.json"
        status, _, err, _ = execute(command + argv + ["--worker", "-l", str(loops), "-w", str(warmups),
                                                 "-n", str(values), "-o", str(out)], site, temp, TIMEOUT)
        if status != "ok":
            return status, {}, None
        try:
            suite = json.loads(out.read_text())
        except (OSError, ValueError):
            return "fail", {}, None
    benchmarks = suite["benchmarks"] if "benchmarks" in suite else [suite]
    best = {}
    for bench in benchmarks:
        samples = [v for run in bench["runs"] for v in run.get("values", [])]
        meta = {**suite.get("metadata", {}), **bench.get("metadata", {})}
        if not samples:
            return "fail", {}, None
        best[meta["name"]] = min(samples), meta.get("inner_loops", 1)
    return "ok", best, hashlib.sha256(err).hexdigest()


def measure_pyperf(command, argv, site, reference):
    # A one-loop run first, with or without a reference: it calibrates, and it compiles the program's
    # modules, whose compile warnings (SyntaxWarning) would otherwise land in the checked stderr.
    status, best, _ = pyperf_run(command, argv, site, 1, 1, 0)
    if status != "ok":
        return {"status": status, "seconds": None, "loops": None, "check": None}
    # pyperf values are per inner loop; a loop is inner_loops of them.
    calibrated = max(1, round(TARGET / max(sum(v * inner for v, inner in best.values()), 1e-9)))
    loops = reference["loops"] if reference else calibrated
    status, best, err = pyperf_run(command, argv, site, loops, VALUES, WARMUPS)
    # pyperf prints timings on stdout; a benchmark that swallows an error still reports it on stderr.
    check = sorted(best) + [err]
    if status == "ok" and reference and check != reference["check"]:
        status = "wrong"
    return {"status": status, "seconds": sum(v for v, _ in best.values()) if status == "ok" else None, "loops": loops,
            "check": check if status == "ok" else None}


def measure_cli(command, argv, site, reference):
    walls, check, status = [], None, "ok"
    with tempfile.TemporaryDirectory() as temp:
        Path(temp, "src").symlink_to(ROOT / "third_party/cpython")
        for i in range(RUNS + 1):
            status, out, _, wall = execute(command + argv, site, temp, TIMEOUT)
            # A CLI program may exit 1 to report findings; only the output and exit code matter.
            digest = hashlib.sha256(status.encode() + b"\0" + out).hexdigest()
            if status in ("crash", "timeout") or (check and digest != check):
                status = status if status in ("crash", "timeout") else "wrong"
                break
            check, status = digest, "ok"
            walls.append(wall)
    if status == "ok" and reference and check != reference["check"]:
        status = "wrong"
    return {"status": status, "seconds": min(walls[1:]) if status == "ok" else None, "loops": None,
            "check": check if status == "ok" else None}


def measure(site, command, reference, only):
    results = {}
    for program, (kind, argv) in programs(site).items():
        if only and program not in only:
            continue
        ref = reference.get(program) if reference is not None else None
        if reference is not None and not (ref and ref.get("check")):
            results[program] = {"status": "noreference", "seconds": None, "loops": None, "check": None}
            continue
        start = time.perf_counter()
        results[program] = (measure_pyperf if kind == "pyperf" else measure_cli)(command, argv, site, ref)
        print(f"{program}: {results[program]['status']} {results[program]['seconds']} "
              f"({time.perf_counter() - start:.1f} s)", file=sys.stderr, flush=True)
    return results


def main():
    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="action", required=True)
    prep = sub.add_parser("prepare")
    prep.add_argument("site", type=Path)
    prep.add_argument("--cache", type=Path, default=CACHE)
    t = sub.add_parser("time")
    t.add_argument("site", type=Path)
    t.add_argument("--run", required=True, help="the interpreter command, as shell words")
    t.add_argument("--reference", type=Path)
    t.add_argument("--programs", default="", help="comma-separated program ids (default: all)")
    args = p.parse_args()
    if args.action == "prepare":
        return prepare(args.site.resolve(), args.cache)
    reference = json.loads(args.reference.read_text()) if args.reference else None
    only = set(filter(None, args.programs.split(",")))
    command = shlex.split(args.run)
    if "/" in command[0]:  # programs run in a scratch directory
        command[0] = str(Path(command[0]).resolve())
    print(json.dumps(measure(args.site.resolve(), command, reference, only)))


if __name__ == "__main__":
    sys.exit(main())
