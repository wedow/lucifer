#!/usr/bin/env python3
"""Generate lib/compiler/opcodes.py from a CPython source tree.

usage: opcodegen CPYTHON_SOURCE > lib/compiler/opcodes.py

Reads Include/opcode_ids.h and Include/internal/pycore_opcode_metadata.h,
which CPython itself generates from Python/bytecodes.c.
"""
from pathlib import Path
import re
import sys


def table(text, name):
    """The body of the C array definition `name[...] = { ... };`."""
    return re.search(r"\b" + name + r"\[\d+\] = \{\n(.*?)\n\};", text, re.S)[1]


def stack_function(text, name):
    body = re.search(r"int " + name + r"\(int opcode, int oparg\)  \{(.*?)\n\}", text, re.S)[1]
    return {op: expr for op, expr in re.findall(r"case (\w+):\s*return (.*?);", body)}


def main():
    root = Path(sys.argv[1])
    ids = (root / "Include/opcode_ids.h").read_text()
    meta = (root / "Include/internal/pycore_opcode_metadata.h").read_text()
    opmap = {name: int(num) for name, num in re.findall(r"#define (\w+) +(\d+)\n", ids)}
    constants = {k: opmap.pop(k) for k in ("HAVE_ARGUMENT", "MIN_SPECIALIZED_OPCODE", "MIN_INSTRUMENTED_OPCODE")}
    flag_names = re.findall(r"#define (HAS_\w+_FLAG) \((\d+)\)", meta)
    flags = {op: f for op, f in re.findall(r"\[(\w+)\] = \{ true, [\w-]+, (.*?) \}", table(meta, "_PyOpcode_opcode_metadata"))}
    caches = re.findall(r"\[(\w+)\] = (\d+),", table(meta, "_PyOpcode_Caches"))
    deopt = re.findall(r"\[(\w+)\] = (\w+),", table(meta, "_PyOpcode_Deopt"))
    pseudo = re.findall(r"\[(\w+)-256\] = \{ (\d+), \{ ([\w, ]*) \} \}", table(meta, "_PyOpcode_PseudoTargets"))
    out = ['"""CPython opcode metadata, generated by tools/opcodegen; do not edit."""', ""]
    out += [f"{k} = {v}" for k, v in constants.items()]
    out += [f"{k} = {v}" for k, v in opmap.items()]
    out += ["", "opmap = {"] + [f"    {k!r}: {k}," for k in opmap] + ["}", ""]
    out += [f"{k} = {v}" for k, v in flag_names]
    out += ["", "# _PyOpcode_opcode_metadata[op].flags", "flags = {"]
    out += [f"    {op}: {expr}," for op, expr in flags.items()] + ["}", ""]
    for name, py in (("_PyOpcode_num_popped", "num_popped"), ("_PyOpcode_num_pushed", "num_pushed")):
        out += [f"# {name}(opcode, oparg)", f"_{py} = {{"]
        out += [f"    {op}: lambda oparg: {expr}," for op, expr in stack_function(meta, name).items()]
        out += ["}", "", "", f"def {py}(opcode, oparg):", f"    function = _{py}.get(opcode)",
                "    return -1 if function is None else function(oparg)", "", ""]
    out += ["# _PyOpcode_Caches", "caches = {"] + [f"    {op}: {n}," for op, n in caches] + ["}", ""]
    out += ["# _PyOpcode_Deopt", "deopt = {"] + [f"    {op}: {base}," for op, base in deopt] + ["}", ""]
    out += ["# _PyOpcode_PseudoTargets: pseudo-op -> (as_sequence, targets)", "pseudo_targets = {"]
    out += [f"    {op}: ({seq}, ({', '.join(t for t in targets.split(', ') if t != '0')},))," for op, seq, targets in pseudo]
    out += ["}", "", "",
            "def is_pseudo_instr(op):", "    return op in pseudo_targets", "", "",
            "def is_pseudo_target(pseudo, target):", "    return target in pseudo_targets.get(pseudo, (0, ()))[1]", ""]
    print("\n".join(out))


if __name__ == "__main__":
    main()
