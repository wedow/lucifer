#!/usr/bin/env python3
"""Print pass rates using each suite's complete expected manifest."""
import argparse
from collections import Counter
import csv
from pathlib import Path

STATUSES = 'PASS FAIL ERROR SKIP XFAIL XPASS TIMEOUT CRASH NOTRUN'.split()


def load(path):
    with path.open(encoding='utf-8', newline='') as stream:
        reader = csv.DictReader(stream, delimiter='\t')
        if reader.fieldnames != ['id', 'status', 'seconds']:
            raise ValueError(f'{path}: expected id/status/seconds header')
        result = {}
        for row in reader:
            if not row['id'] or row['id'] in result or row['status'] not in STATUSES:
                raise ValueError(f'{path}: invalid or duplicate row {row}')
            result[row['id']] = row['status']
        if not result:
            raise ValueError(f'{path}: empty manifest')
        return result


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--results', type=Path, default=Path(__file__).resolve().parents[1] / 'results')
    parser.add_argument('--suite', action='append')
    args = parser.parse_args()
    print('\t'.join(['suite', 'runtime', 'total', *STATUSES, 'pass_rate']))
    for expected_path in sorted(args.results.glob('*/expected.tsv')):
        suite = expected_path.parent.name
        if args.suite and suite not in args.suite:
            continue
        expected = load(expected_path)
        for path in sorted(expected_path.parent.glob('*.tsv')):
            if path == expected_path:
                continue
            actual = load(path)
            extra = actual.keys() - expected.keys()
            if extra:
                raise ValueError(f'{path}: {len(extra)} IDs outside expected manifest')
            counts = Counter(actual.get(key, 'NOTRUN') for key in expected)
            print('\t'.join(map(str, [suite, path.stem, len(expected),
                                       *(counts[s] for s in STATUSES),
                                       f'{counts["PASS"] / len(expected):.2%}'])))


if __name__ == '__main__':
    main()
