#!/usr/bin/env python3
"""Compile the frozen modules with the host CPython into a C file of marshal blobs.

usage: freeze OUTPUT.c --kernel MODULE.py... --builtin MODULE.py... --frozen NAME:ORIGNAME:FILE...

Run with a host CPython 3.14 (magic 3627). There are three tables:
  kernel   lib/kernel files in boot order; each is named after its file
           (lib/kernel/builtins.py implements builtins);
  builtin  lib/modules ports, named after their files: the builtin modules
           that sys.builtin_module_names lists;
  frozen   modules importlib finds as frozen, as NAME with the dotted module
           ORIGNAME the file implements (importlib.\_bootstrap is frozen as
           _frozen_importlib).
Each is compiled with the filename "<frozen NAME>" (ORIGNAME for the frozen
table), as CPython names its frozen modules. Hashes are never computed here:
the runtime hashes with its own secret.
"""
import importlib.util
import marshal
from pathlib import Path
import sys

SYMBOL = {"kernel": "kernel", "builtin": "builtin", "frozen": "modules"}
MAGIC = (3627).to_bytes(2, "little") + b"\r\n"


def blob(name, data):
    lines = [f"static const unsigned char {name}[] = {{"]
    for i in range(0, len(data), 16):
        lines.append("    " + " ".join(f"{b},"for b in data[i:i + 16]))
    lines.append("};")
    return "\n".join(lines)


def main():
    if importlib.util.MAGIC_NUMBER != MAGIC:
        sys.exit("freeze: the host Python must be CPython 3.14 (magic 3627)")
    output, groups = sys.argv[1], {}
    for arg in sys.argv[2:]:
        if arg.startswith("--"):
            group = groups.setdefault(arg[2:], [])
        else:
            group.append(arg)
    parts = ["/* Generated by tools/freeze; do not edit. */",
             '#include "interp/frozen.h"', ""]
    tables = []
    count = 0
    for table, entries in (("kernel", groups.get("kernel", [])),
                           ("builtin", groups.get("builtin", [])),
                           ("frozen", groups.get("frozen", []))):
        rows = []
        for entry in entries:
            if table == "frozen":
                name, orig, path = entry.split(":", 2)
            else:
                path = entry
                name = orig = Path(path).stem
            code = compile(Path(path).read_text(), f"<frozen {orig}>", "exec", dont_inherit=True)
            data = marshal.dumps(code)
            parts.append(blob(f"module{count}", data))
            origname = f'"{orig}"' if orig != name else "NULL"
            rows.append(f'    {{ "{name}", module{count}, {len(data)}, {origname} }},')
            count += 1
        tables.append((table, rows))
    for table, rows in tables:
        parts.append(f"\nconst struct lu_frozen lu_frozen_{SYMBOL[table]}[] = {{")
        parts.extend(rows)
        parts.append("    { NULL, NULL, 0, NULL },\n};")
    Path(output).parent.mkdir(parents=True, exist_ok=True)
    Path(output).write_text("\n".join(parts) + "\n")


if __name__ == "__main__":
    main()
