#!/usr/bin/env python3
"""Compile the kernel with the host CPython into a C file of marshal blobs.

usage: freeze OUTPUT.c MODULE.py...

Run with a host CPython 3.14 (magic 3627). The modules are given in boot
order; each is named after its file (lib/kernel/builtins.py implements
builtins) and compiled with the filename "<frozen NAME>", as CPython names
its frozen modules. Hashes are never computed here: the runtime hashes with
its own secret.
"""
import importlib.util
import marshal
from pathlib import Path
import sys

MAGIC = (3627).to_bytes(2, "little") + b"\r\n"


def blob(name, data):
    lines = [f"static const unsigned char {name}[] = {{"]
    for i in range(0, len(data), 16):
        lines.append("    " + " ".join(f"{b},"for b in data[i:i + 16]))
    lines.append("};")
    return "\n".join(lines)


def main():
    if importlib.util.MAGIC_NUMBER != MAGIC:
        sys.exit("freeze: the host Python must be CPython 3.14 (magic 3627)")
    output, sources = sys.argv[1], [Path(p) for p in sys.argv[2:]]
    parts = ["/* Generated by tools/freeze; do not edit. */",
             '#include "interp/frozen.h"', ""]
    table = []
    for i, source in enumerate(sources):
        name = source.stem
        code = compile(source.read_text(), f"<frozen {name}>", "exec", dont_inherit=True)
        data = marshal.dumps(code)
        parts.append(blob(f"module{i}", data))
        table.append(f'    {{ "{name}", module{i}, {len(data)} }},')
    parts.append("\nconst struct lu_frozen lu_frozen_kernel[] = {")
    parts.extend(table)
    parts.append("    { NULL, NULL, 0 },\n};\n")
    Path(output).parent.mkdir(parents=True, exist_ok=True)
    Path(output).write_text("\n".join(parts))


if __name__ == "__main__":
    main()
