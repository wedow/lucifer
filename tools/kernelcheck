#!/usr/bin/env python3
"""Run tests/kernel programs on the oracle and on bin/lucifer and compare.

Run with a host CPython 3.14 (magic 3627). Each tests/kernel/NAME.py is
compiled by the host into build/tests/kernel/NAME.pyc, then run as
`INTERPRETER -I -S NAME.pyc` under a 512 KiB RLIMIT_STACK, once on the
free-threaded oracle and once on bin/lucifer. stdout, stderr and the exit
status must be identical. Exit status 1 when any program differs.

Programs in RUNS run once per (flags, environment); an environment replaces
-I -S and the inherited environment. A lane's flags go to the oracle too.
SEEDED programs are also run unseeded, twice: the runs must differ after the
first line, which must equal the oracle's. FLAG_ROWS are bin/lucifer command
lines whose exit status and stderr are checked directly. SOURCE_ROWS are
programs given as source (-c, a .py script, standard input, imports that write
__pycache__): the oracle and bin/lucifer run each in the same directory, and the
output, exit status and the .pyc files left behind must be identical.
The SIGINT probe runs a -c program at both launch dispositions: default, and
SIGINT ignored, as a background job starts.
"""
import argparse
import difflib
import dis
import importlib.machinery
import importlib.util
import os
from pathlib import Path
import py_compile
import re
import resource
import shutil
import signal
import subprocess
import sys
import tempfile
import warnings

ROOT = Path(__file__).resolve().parent.parent
SOURCES = ROOT / "tests" / "kernel"
BUILD = ROOT / "build" / "tests" / "kernel"
STACK = 512 * 1024
TIMEOUT = 120
# A stress lane collects often, and a handoff lane parks the task at every safepoint, which costs a few hundred
# nanoseconds each: its heaviest programs take a minute or more on a quiet host.
HANDOFF_TIMEOUT = 600
MAGIC = (3627).to_bytes(2, "little") + b"\r\n"
# Lanes are the -X policies a program runs under, on the oracle as well:
# CPython only records an unknown -X option in sys._xoptions. "handoff:N" is
# the handoff scheduler with seed N.
LANES = {"plain": [], "handoff": ["-X", "lucifer_handoff"]}
LANES.update({f"handoff:{n}": ["-X", f"lucifer_handoff={n}"] for n in range(1, 9)})
# "gc:N" collects after every N GC allocations (-X lucifer_stress=gc:N). A collection costs the whole heap
# (about a millisecond), so the lanes trade rate for programs (FOUNDATIONS 2.7):
# gc:1 runs the programs below, which finish in under 40 s at that rate; gc:100000 runs them all.
LANES.update({f"gc:{n}": ["-X", f"lucifer_stress=gc:{n}"] for n in (1, 100000)})
# "jit" compiles every function at its first call or back-edge; "jit-deopt" also
# fails every 7th guard execution, so each exit path runs (FOUNDATIONS 2.7).
LANES["jit"] = ["-X", "lucifer_jit=always"]
LANES["jit-deopt"] = ["-X", "lucifer_jit=always", "-X", "lucifer_stress=deopt:7"]
STRICT_PROGRAMS = """
    ast_nodes audit bigint binascii_module bool_ops builtins_funcs bytes_args bytes_errors bytes_methods
    bytes_repr calls cell_type classes class_prepare closures code_positions code_replace collections_deque
    complex_ops comprehensions contextvars_basic control_flow coroutines deep_recursion descriptors dict_ops
    exception_groups exceptions float_ops fstrings gc_at_poll gc_dead_weakref gc_thread_queues generators
    generic_alias handoff_finalize handoff_pinned handoff_state handoff_witness hash_seed hello import_io
    int_arith int_errors int_random int_reflect invalidate itertools_basic list_ops mapping_views
    marshal_dumps match_stmt math_functions memoryview object_reduce posix_basic print_args range_slice
    resurrect scoping set_colliding_keys set_ops set_random signals signals_poll str_format
    str_methods str_sizeof struct_basic sysconfig_vars thread_lock threads_lowlevel tstrings
    tuple_ops types_module typing_primitives unpack with_stmt
""".split()
LANE_PROGRAMS = {"gc:1": STRICT_PROGRAMS}
# name -> stdout under the handoff lanes, where two carriers run the program:
# the one place lucifer is meant to differ from the oracle.
HANDOFF_STDOUT = {
    "handoff_witness": b"2\n",
    "handoff_pinned": b"signal handler saw 1\nmain saw 2\natexit callback saw 1\n",
}
# name -> ticket: known divergences under the handoff lanes. The program must
# still exit as the oracle does; a mismatch reports XFAIL, a match XPASS (then
# delete the entry). Each entry names the ticket that removes it.
HANDOFF_XFAIL = {
    "marshal_dumps": "luc-ymb3",
}
# name -> [(flags, env)]: env None is -I -S with the inherited environment.
RUNS = {
    "hash_seed": [([], {"PYTHONHASHSEED": "12345"}), ([], {"PYTHONHASHSEED": "0"})],
    "stdio": [([], None), (["-u"], None), (["-X", "utf8=0"], {"LC_ALL": "C"}),
              ([], {"LC_ALL": "C"}), ([], {"PYTHONIOENCODING": "latin-1:replace", "PYTHONUNBUFFERED": "1"}),
              ([], {"PYTHONIOENCODING": "ascii:backslashreplace", "LANG": "en_US.UTF-8"})],
    "sys_flags": [([], None),
                  (["-X", "int_max_str_digits=1000", "-X", "foo=bar", "-X", "baz", "-W", "ignore"], None),
                  (["-B", "-b", "-q", "-O", "-E", "-X", "utf8=0"], None),
                  ([], {"PYTHONINTMAXSTRDIGITS": "2000", "PYTHONDONTWRITEBYTECODE": "1",
                        "PYTHONWARNINGS": "ignore,error::ResourceWarning", "PYTHONUTF8": "0",
                        "PYTHONHASHSEED": "7", "PYTHONDEVMODE": "1"}),
                  (["-X", "dev"], {"PYTHONSAFEPATH": "1", "PYTHONNOUSERSITE": "1"})],
}
SEEDED = ("hash_seed",)
# name -> bytes on the program's standard input; the others get an empty pipe.
STDIN = {"stdio_input": "line one\nl\u00efne two\r\nlast, no newline".encode()}
# (name, flags, exit status, text stderr must contain)
FLAG_ROWS = [
    ("stress kind", ["-X", "lucifer_stress=bogus", "-I", "-S", "hello.pyc"], 2, "lucifer_stress"),
    ("stress count", ["-X", "lucifer_stress=gc:x", "-I", "-S", "hello.pyc"], 2, "lucifer_stress"),
    ("stress ok", ["-X", "lucifer_stress=gc:5,deopt,seed:7", "-I", "-S", "hello.pyc"], 0, ""),
    ("handoff seed", ["-X", "lucifer_handoff=x", "-I", "-S", "hello.pyc"], 2, "lucifer_handoff"),
    ("int digits", ["-X", "int_max_str_digits=100", "-I", "-S", "hello.pyc"], 1, "int_max_str_digits"),
    ("no file", ["-I", "-S", "missing.pyc"], 2, "missing.pyc"),
]
# A dropped cycle must be collected within about N GC allocations under gc:N, whatever the heap size
# (lucifer only: the oracle has no stress collections). The program prints the allocations it took.
STRESS_CYCLE = """\
import gc, weakref
gc.set_threshold(0)
class Node: pass
keep = [[] for _ in range(1000)]   # a large heap must not slow the rate
a = Node(); b = Node(); a.other = b; b.other = a
r = weakref.ref(a)
del a, b
n = 0
while r() is not None and n < 100000:
    [] ; n += 1
print(n)
"""
STRESS_CYCLE_SLACK = 8    # allocations the loop's own bookkeeping may add
STRESS_CYCLE_COUNTS = (1, 10, 100)
# signal.getsignal(SIGINT) at both launch dispositions: a process started with
# SIGINT ignored (a background job of a non-interactive shell) keeps it ignored.
SIGINT_SOURCE = ("import signal\n"
                 "print(signal.getsignal(signal.SIGINT) == signal.SIG_IGN,\n"
                 "      signal.getsignal(signal.SIGINT) is signal.default_int_handler)\n")


# Programs given as source: (name, interpreter arguments, files written first,
# standard input, whether stderr is compared). Each runs in a fresh directory
# on each interpreter; the directory's name is hidden from the output. The
# __pycache__ files the run leaves behind must be the same bytes.
SOURCE_MTIME = 1700000000
SOURCE_ROWS = [
    ("-c", ["-S", "-c", "import sys\nprint(sys.argv, repr(sys.path[0]), __name__, __loader__, sorted(globals()))", "a", "b"],
     {}, b"", True),
    ("-c exit", ["-S", "-c", "raise SystemExit(7)"], {}, b"", True),
    ("-c error", ["-S", "-c", "1 / 0"], {}, b"", False),
    ("-c syntax error", ["-S", "-c", "x = ("], {}, b"", False),
    ("-c unicode", ["-S", "-c", "print('caf\u00e9', len('\U0001f600'))"], {}, b"", True),
    ("-c isolated", ["-I", "-S", "-c", "import sys\nprint('' in sys.path, sys.flags.isolated)"], {}, b"", True),
    ("script", ["-S", "script.py", "x", "y"],
     {"script.py": "import sys\nprint(sys.argv, __name__, __file__, __cached__, __spec__, sys.path[0] == __file__.rpartition('/')[0])\n"
                   "print(__loader__.__class__.__name__, sorted(k for k in globals() if k.startswith('__')))\n"}, b"", True),
    ("script exit", ["-S", "s.py"], {"s.py": "import sys\nsys.exit('bye')\n"}, b"", True),
    ("script future", ["-S", "s.py"], {"s.py": "from __future__ import annotations\nx: int = 1\nprint(__annotations__)\n"}, b"", True),
    ("script cookie", ["-S", "s.py"], {"s.py": b"# -*- coding: latin-1 -*-\nprint('caf\xe9')\n"}, b"", True),
    ("script warning", ["-S", "s.py"], {"s.py": "x = '\\d'\nprint(x)\n"}, b"", True),
    ("script syntax error", ["-S", "s.py"], {"s.py": "x = (\n"}, b"", False),
    ("script uncaught", ["-S", "s.py"],
     {"s.py": "def f(x):\n    return [1, 2][x] + (None + 1)\ntry:\n    f(0)\nexcept TypeError as e:\n"
              "    raise ValueError('wrapped') from e\n"}, b"", True),
    ("script excepthook", ["-S", "s.py"],
     {"s.py": "import sys\nsys.excepthook = lambda t, v, tb: print('hooked', t.__name__, v, tb.tb_lineno)\n"
              "raise KeyError('k')\n"}, b"", True),
    ("script import", ["-S", "main.py"],
     {"main.py": "import dep, pkg.mod\nprint(dep.VALUE, dep.__file__, dep.__cached__, pkg.mod.NAME, pkg.mod.__package__)\n",
      "dep.py": "VALUE = [i * i for i in range(5)]\n",
      "pkg/__init__.py": "", "pkg/mod.py": "NAME = __name__\n"}, b"", True),
    ("script import twice", ["-S", "-c", "import dep\nprint(dep.VALUE, dep.__cached__)"],
     {"dep.py": "VALUE = 'cached'\n"}, b"", True, 2),
    ("script no bytecode", ["-S", "-B", "main.py"], {"main.py": "import dep\nprint(dep.VALUE)\n", "dep.py": "VALUE = 1\n"}, b"", True),
    ("stdin", ["-S", "-"], {}, b"import sys\nprint(sys.argv, repr(sys.path[0]), __loader__)\n", True),
    ("stdin default", ["-S"], {}, b"print('from stdin')\n", True),
]


def source_run(interpreter, directory, args, files, stdin, runs):
    """(exit status, stdout, stderr, {pyc path: bytes}) of the last of `runs` runs of one source
    program, in a new directory of the given name."""
    shutil.rmtree(directory, ignore_errors=True)
    directory.mkdir()
    for name, text in files.items():
        path = directory / name
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_bytes(text if isinstance(text, bytes) else text.encode())
        os.utime(path, (SOURCE_MTIME, SOURCE_MTIME))
    for _ in range(runs):
        try:
            child = subprocess.run([interpreter, *args], capture_output=True, timeout=TIMEOUT, input=stdin,
                                   preexec_fn=limit_stack, cwd=directory)
        except subprocess.TimeoutExpired:
            return ("timeout", b"", b"", {})
    pycs = {str(p.relative_to(directory)): p.read_bytes() for p in sorted(directory.rglob("*.pyc"))}
    return (child.returncode, child.stdout, child.stderr, pycs)


def check_source_programs(oracle, lucifer):
    """Print one line per SOURCE_ROWS entry; the number of failures."""
    failed = 0
    with tempfile.TemporaryDirectory() as base:
        directory = Path(base) / "program"
        for name, args, files, stdin, compare_stderr, *runs in SOURCE_ROWS:
            expected = source_run(oracle, directory, args, files, stdin, *runs or [1])
            actual = source_run(lucifer, directory, args, files, stdin, *runs or [1])
            ok_error = True
            if not compare_stderr:
                ok_error = (expected[0] == actual[0] and (expected[2] == b"") == (actual[2] == b"")
                            and (not expected[2] or expected[2].splitlines()[-1] == actual[2].splitlines()[-1]))
                expected, actual = (*expected[:2], b"", expected[3]), (*actual[:2], b"", actual[3])
            if expected == actual and ok_error:
                print(f"PASS source: {name}")
            else:
                failed += 1
                print(describe(f"source: {name}", expected, actual))
                if expected[3] != actual[3]:
                    print(f"  __pycache__: oracle {sorted(expected[3])}, lucifer {sorted(actual[3])}")
    return failed


def limit_stack():
    resource.setrlimit(resource.RLIMIT_STACK, (STACK, STACK))


def ignore_int():
    limit_stack()
    signal.signal(signal.SIGINT, signal.SIG_IGN)


def run(interpreter, flags, pyc, env=None):
    """env None: -I -S with the inherited environment; else -S with exactly env."""
    stdin = STDIN.get(pyc.stem, b"")
    isolation = ["-I", "-S"] if env is None else ["-S"]
    timeout = HANDOFF_TIMEOUT if any(f.startswith(("lucifer_handoff", "lucifer_stress")) for f in flags) else TIMEOUT
    try:
        child = subprocess.run([interpreter, *isolation, *flags, str(pyc)],
                               capture_output=True, timeout=timeout, env=env,
                               input=stdin, preexec_fn=limit_stack, cwd=BUILD)
    except subprocess.TimeoutExpired:
        return ("timeout", b"", b"")
    return (child.returncode, child.stdout, child.stderr)


def compile_program(name):
    source = SOURCES / f"{name}.py"
    if not source.is_file():
        sys.exit(f"kernelcheck: no program {source}")
    pyc = BUILD / f"{name}.pyc"
    with warnings.catch_warnings():
        warnings.simplefilter("ignore", SyntaxWarning)    # the programs are odd on purpose
        py_compile.compile(str(source), str(pyc), dfile=f"{name}.py", doraise=True)
    return pyc


def describe(name, oracle, ours):
    lines = [f"FAIL {name}"]
    for label, index in (("exit", 0), ("stdout", 1), ("stderr", 2)):
        if oracle[index] == ours[index]:
            continue
        if index == 0:
            lines.append(f"  exit: oracle {oracle[0]}, lucifer {ours[0]}")
            continue
        expected = oracle[index].decode("utf-8", "replace").splitlines()
        actual = ours[index].decode("utf-8", "replace").splitlines()
        lines.append(f"  {label}:")
        lines.extend("    " + line for line in difflib.unified_diff(
            expected, actual, "oracle", "lucifer", lineterm=""))
    return "\n".join(lines)


def check_sigint(oracle, lucifer):
    """One line per SIGINT launch disposition; the number of failures."""
    failed = 0
    for label, preexec in (("default", limit_stack), ("ignored", ignore_int)):
        runs = [subprocess.run([interpreter, "-I", "-S", "-c", SIGINT_SOURCE],
                               capture_output=True, timeout=TIMEOUT,
                               preexec_fn=preexec, cwd=BUILD)
                for interpreter in (oracle, lucifer)]
        results = [(child.returncode, child.stdout, child.stderr) for child in runs]
        if results[0] == results[1]:
            print(f"PASS sigint: {label}")
        else:
            failed += 1
            print(describe(f"sigint: {label}", *results))
    return failed


# Base opcodes no compiled program can reach, so the eval loop has no handler.
OPCODE_EXEMPT = {
    "RESERVED": "unassigned",
    "INTERPRETER_EXIT": "ends CPython's C-recursive entry shim; this loop has none",
    "BINARY_OP_INPLACE_ADD_UNICODE": "a specialization of BINARY_OP, which the compiler never emits",
}


def opcode_table():
    spec = importlib.util.spec_from_file_location("opcodes", ROOT / "lib" / "compiler" / "opcodes.py")
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def corpus_opcodes():
    """The opcode names the host emits for the closure, difftest and kernel corpora."""
    loader = importlib.machinery.SourceFileLoader("compilercheck", str(ROOT / "tools" / "compilercheck"))
    spec = importlib.util.spec_from_loader("compilercheck", loader)
    compilercheck = importlib.util.module_from_spec(spec)
    loader.exec_module(compilercheck)
    names = set()
    pending = []
    with warnings.catch_warnings():
        warnings.simplefilter("ignore")
        for corpus in ("closure", "difftest", "kernel"):
            for path in compilercheck.corpus(corpus):
                try:
                    pending.append(compile(path.read_bytes(), str(path), "exec"))
                except (SyntaxError, ValueError):
                    pass
    while pending:
        code = pending.pop()
        names.update(i.opname for i in dis.get_instructions(code, adaptive=False))
        pending.extend(c for c in code.co_consts if hasattr(c, "co_code"))
    return names


def check_opcodes():
    """Every base opcode has a handler in the eval loop; the corpora's too. Returns the failure count."""
    source = (ROOT / "runtime" / "interp" / "ceval.c").read_text()
    table = source[source.index("static void *const targets"):]
    handled = set(re.findall(r"\[(\w+)\] = &&op_", table[:table.index("};")]))
    opcodes = opcode_table()
    base = {n for n, v in opcodes.opmap.items() if v < opcodes.MIN_SPECIALIZED_OPCODE}
    occurring = corpus_opcodes()
    missing = sorted(base - handled - OPCODE_EXEMPT.keys())
    unreached = sorted(occurring - base - {"CACHE"})
    for name in missing:
        print(f"FAIL opcode {name} ({'occurs in the corpora' if name in occurring else 'never occurs'}) has no handler")
    for name in unreached:
        print(f"FAIL opcode {name} occurs in the corpora but is not a base opcode")
    print(f"{len(base)} base opcodes: {len(base & handled)} handled, {len(OPCODE_EXEMPT)} exempt, "
          f"{len(missing)} unhandled; {len(occurring & base)} occur in the corpora")
    return len(missing) + len(unreached)


def main():
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--oracle", help="free-threaded CPython 3.14")
    parser.add_argument("--lucifer", default=str(ROOT / "bin" / "lucifer"))
    parser.add_argument("--programs", default="", help="space-separated names")
    parser.add_argument("--lane", default="plain")
    parser.add_argument("--opcodes", action="store_true", help="check the eval loop handles every base opcode")
    args = parser.parse_args()
    if args.opcodes:
        return 1 if check_opcodes() else 0
    if not args.oracle:
        parser.error("--oracle is required")

    if importlib.util.MAGIC_NUMBER != MAGIC:
        sys.exit("kernelcheck: the host Python must be CPython 3.14 (magic 3627)")
    if args.lane not in LANES:
        sys.exit(f"kernelcheck: unknown lane {args.lane!r}")
    names = args.programs.split() or LANE_PROGRAMS.get(args.lane) or sorted(p.stem for p in SOURCES.glob("*.py"))
    lucifer = str(Path(args.lucifer).resolve())
    BUILD.mkdir(parents=True, exist_ok=True)

    failed = total = 0
    for name in names:
        pyc = compile_program(name)
        for flags, env in RUNS.get(name, [([], None)]):
            label = name if not flags and env is None else f"{name} {flags} {env or ''}".rstrip()
            total += 1
            oracle = run(args.oracle, LANES[args.lane] + flags, pyc, env)
            if args.lane.startswith("handoff") and name in HANDOFF_STDOUT:
                oracle = (oracle[0], HANDOFF_STDOUT[name], oracle[2])
            ours = run(lucifer, LANES[args.lane] + flags, pyc, env)
            if args.lane.startswith("handoff") and name in HANDOFF_XFAIL and oracle[0] == ours[0]:
                print(f"{'XPASS' if oracle == ours else 'XFAIL'} {label} ({HANDOFF_XFAIL[name]})")
            elif oracle == ours:
                print(f"PASS {label}")
            else:
                failed += 1
                print(describe(label, oracle, ours))
        if name in SEEDED:
            label = f"{name} unseeded"
            total += 1
            oracle = run(args.oracle, LANES[args.lane], pyc, {})
            first, second = (run(lucifer, LANES[args.lane], pyc, {}) for _ in range(2))
            head = lambda r: r[1].split(b"\n")[0]
            if first[0] == 0 and head(first) == head(oracle) and first[1] != second[1]:
                print(f"PASS {label}")
            else:
                failed += 1
                print(f"FAIL {label}: exit {first[0]}, flag line {head(first)!r} vs {head(oracle)!r}, "
                      f"runs {'differ' if first[1] != second[1] else 'are identical'}")
    compile_program("hello")
    for label, flags, status, text in FLAG_ROWS:
        child = subprocess.run([lucifer, *flags], capture_output=True, timeout=TIMEOUT, cwd=BUILD)
        if child.returncode == status and text.encode() in child.stderr:
            print(f"PASS flags: {label}")
        else:
            failed += 1
            print(f"FAIL flags: {label}: exit {child.returncode}, stderr {child.stderr!r}")
        total += 1
    for n in STRESS_CYCLE_COUNTS:
        child = subprocess.run([lucifer, "-I", "-S", "-X", f"lucifer_stress=gc:{n}", "-c", STRESS_CYCLE],
                               capture_output=True, timeout=TIMEOUT, cwd=BUILD)
        took = int(child.stdout or -1)
        if child.returncode == 0 and 0 <= took <= n + STRESS_CYCLE_SLACK:
            print(f"PASS stress: gc:{n} collects a dropped cycle in {took} allocations")
        else:
            failed += 1
            print(f"FAIL stress: gc:{n}: exit {child.returncode}, {took} allocations, stderr {child.stderr!r}")
        total += 1
    failed += check_sigint(args.oracle, lucifer)
    total += 2
    source_failed = check_source_programs(args.oracle, lucifer)
    failed += source_failed
    total += len(SOURCE_ROWS)
    print(f"{total - failed}/{total} checks pass ({args.lane})")
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main())
