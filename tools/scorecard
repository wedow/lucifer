def yesterday_metrics(out):
    try:
        day = datetime.date.fromisoformat(out.name.removeprefix("scorecard-"))
    except ValueError:
        return "", None
    yesterday = day - datetime.timedelta(days=1)
    previous = out.parent / f"scorecard-{yesterday}" / "summary.csv"
    if not previous.is_file():
        return day.isoformat(), None
    with previous.open(newline="") as stream:
        rows = [row for row in csv.DictReader(stream) if row.get("kind", "detail") == "detail"]
    return day.isoformat(), daily_metrics(rows)[0]


def daily_headlines(rows, out):
    today, settling_counts = daily_metrics(rows)
    date, yesterday = yesterday_metrics(out)
    result = []
    for key, (card, title, target) in HEADLINES.items():
        scores, counts, changes = [], [], []
        for label, (value, paired, total) in today[key].items():
            coverage = f"{len(paired)}/{len(total)}"
            if key == "steady":
                scores.append(f"{coverage} settled" if total else "—")
                counts.append(settling_counts)
            else:
                number = "—" if value is None else f"{value:.3g}×"
                scores.append(f"{label} {number}")
                counts.append(f"{label} {coverage}")
            if yesterday is None:
                continue
            old, old_pairs, old_total = yesterday[key][label]
            if value is None or old is None:
                delta = "—"
            elif total != old_total or (key != "steady" and paired != old_pairs):
                delta = "coverage changed"
            elif key == "steady":
                delta = f"{value - old:+d} settled"
            else:
                delta = f"{100 * (value / old - 1):+.3g}%"
            changes.append(f"{label} {delta}" if key != "steady" else delta)
        result.append(dict(kind="headline", card=card, program=key, title=title, target=target, date=date,
                           score=", ".join(scores), counts=", ".join(counts), change=", ".join(changes) or "—"))
    return result


def headline_table(headlines):
    lines = ["## Scorecards", "", "Stock is CPython 3.14t. Ratios compare Lucifer time except for Flask, "
             "which compares requests/s on disjoint server and client CPUs. Each paired manifest has one vote. "
             "Change compares the same programs with yesterday's ratios; a dash means no comparable measurement.", "",
             "| Card | Lucifer | Paired / observed | Target | Change since yesterday |", "|---|---|---|---|---|"]
    for card in range(1, 6):
        group = [h for h in headlines if h["card"] == card]
        cells = [" / ".join(h["title"] for h in group)]
        for field in ("score", "counts", "target", "change"):
            cells.append("<br>".join(h[field] for h in group))
        lines.append("| " + " | ".join([f"{card}. {cells[0]}", *cells[1:]]) + " |")
    return lines + [""]


def read_gates(path):
    if path is None:
        return []
    with path.open(newline="") as stream:
        reader = csv.DictReader(stream)
        if not {"program", "status"} <= set(reader.fieldnames or []):
            raise ValueError("gate CSV needs program and status columns")
        return [dict(row, kind="gate") for row in reader]


def repeatability(site, scratch):
    """Five alternating fresh stock/candidate pairs on frozen single-task representatives."""
    baseline = [json.loads(line) for line in (scratch / "corpus-cpython.jsonl").read_text().splitlines()]
    groups = {}
    for row in baseline:
        if row["card"] == 5 or "/" in row["program"] or not (row.get("seconds") or row.get("final_s")):
            continue
        group = suite_name(row)
        if group in ("held out", "native majority", "application", "cli", "startup"):
            groups.setdefault(group, []).append(row)
    def pick(names):
        return min(names, key=lambda name: hashlib.sha256(name.encode()).digest())

    names = {pick(r["program"] for r in group) for group in groups.values()}
    # Measure the repeatability of a positive settling claim as well. Select
    # one previously settled pair without looking at the size of its speedup.
    candidate_ok = {r["program"] for path in scratch.glob("*-lucifer.jsonl")
                    for line in path.read_text().splitlines() if (r := json.loads(line))["card"] == 5
                    and r["status"] == "ok"}
    settled = [r["program"] for r in baseline if r["card"] == 5 and r["status"] == "ok"
               and r.get("group") == "held out" and "/" not in r["program"] and r["program"] in candidate_ok]
    if settled:
        names.add(pick(settled))
    corpus_names = sorted(name.split(".", 1)[1] for name in names if name.startswith("pyperformance."))
    awfy = pick(bench_tool("awfy").INNER)
    for n in range(5):
        arms = ("cpython", "lucifer") if n % 2 == 0 else ("lucifer", "cpython")
        for label in arms:
            raw = scratch / "repeatability" / str(n + 1)
            raw.mkdir(exist_ok=True, parents=True)
            command = runtime_command(label)
            prefix = shlex.split(os.environ.get("LUCIFER_PREFIX", "")) if label == "lucifer" else []
            target = prefix + command
            for rows in (awfy_rows(label, target, raw, [awfy]),
                         cold_rows(label, command, site, raw, names),
                         boundary_rows(label, target, site, raw),
                         corpus_rows(label, target, site, raw, corpus_names, classification_root=scratch)):
                for row in rows:
                    yield dict(row, repeat=n + 1)


def repeat_fields(rows, repeats):
    """Add empirical ranges of paired ratios, preserving unresolved pairs."""
    lookup = {(r["repeat"], r["card"], r["program"], r["runtime"]): r for r in repeats}
    for row in rows:
        key = row["card"], row["program"]
        if row["runtime"] != "lucifer" or (1, *key, "lucifer") not in lookup:
            continue
        if row["card"] == 5:
            walls = [lookup.get((i, *key, "lucifer"), {}).get("warmup_s") for i in range(1, 6)]
            walls = [value for value in walls if value is not None]
            row["warmup_settled_runs"] = len(walls)
            if walls:
                row.update(warmup_min_s=min(walls), warmup_max_s=max(walls))
        for metric in ("seconds", "final_s", "instructions_per_unit", "cycles_per_unit", "first_steady_op"):
            ratios = []
            for i in range(1, 6):
                left = lookup.get((i, *key, "lucifer"), {}).get(metric)
                right = lookup.get((i, *key, "cpython"), {}).get(metric)
                if left is not None and right:
                    ratios.append(left / right)
            if ratios:
                row.update({f"{metric}_paired_n": len(ratios), f"{metric}_ratio_min": min(ratios),
                            f"{metric}_ratio_max": max(ratios)})


def runtime_command(runtime):
    key, fallback = {"cpython": ("ORACLE_T", "python3.14t"), "lucifer": ("LUCIFER", str(ROOT / "bin/lucifer")),
                     "pypy": ("PYPY", "pypy3"), "go": ("AWFY_GO", "awfy-go")}[runtime]
    name = os.environ.get(key, fallback)
    path = shutil.which(name)
    return [str(Path(path).absolute()) if path else name]


def fingerprints(runtimes):
    hashes = {}
    for label in runtimes:
        binary = Path(runtime_command(label)[0])
        if binary.is_file():
            with binary.open("rb") as stream:
                hashes[label] = hashlib.file_digest(stream, "sha256").hexdigest()
    return hashes


def arm(section, runtime, site, scratch):
    command = runtime_command(runtime)
    prefix = shlex.split(os.environ.get("LUCIFER_PREFIX", "")) if runtime == "lucifer" else []
    target = prefix + command
    if section in ("awfy", "corpus"):
        if section == "awfy":
            yield from awfy_rows(runtime, target, scratch, sorted(bench_tool("awfy").INNER))
            if runtime in ("go", "cpython"):
                return
        else:
            yield from cold_rows(runtime, command, site, scratch)
            yield from boundary_rows(runtime, target, site, scratch)
        corpus = bench_tool("corpus")
        names = sorted((corpus.pyperformance(site).keys() | corpus.EXCLUDED.keys()) - set(corpus.STARTUP))
        # Stock establishes every classification first. Distribute each other
        # Python runtime's corpus across its two timed holds to bound their length.
        if runtime != "cpython":
            mid = len(names) // 2
            names = names[:mid] if section == "corpus" else names[mid:]
        yield from corpus_rows(runtime, target, site, scratch, names)
    elif section == "web":
        yield from flask_rows(runtime, target, Path(os.environ.get("WEB_SITE", site)), scratch)
    elif section == "profile":
        yield from flask_profile_rows(runtime, target, Path(os.environ.get("WEB_SITE", site)), scratch)


def worker(args):
    site, scratch = args.site.resolve(), args.scratch.resolve()
    temp = scratch / "tmp"
    temp.mkdir(exist_ok=True)
    os.environ["TMPDIR"] = tempfile.tempdir = str(temp)
    os.environ["PYTHONHASHSEED"] = "0"
    with args.receipt.open("w") as stream:
        for runtime in args.runtimes.split(","):
            if runtime == "cpython":
                os.environ["PYTHON_GIL"] = "0"
            else:
                os.environ.pop("PYTHON_GIL", None)
            rows = repeatability(site, scratch) if args.section == "repeat" else arm(args.section, runtime, site, scratch)
            for row in rows:
                print(json.dumps(row, allow_nan=False), file=stream, flush=True)
                print(row["card"], row["program"], row["runtime"], row["status"], flush=True)


def cell(value):
    if value is None:
        return "—"
    if isinstance(value, float):
        return f"{value:.5g}"
    return str(value).replace("|", "\\|").replace("\n", " ")


def markdown_table(rows, columns):
    header = ["| " + " | ".join(columns) + " |", "|" + "---|" * len(columns)]
    return header + ["| " + " | ".join(cell(row.get(key)) for key in columns) + " |" for row in rows] + [""]


def missing_rows(rows, runtimes):
    """Expose an interrupted worker's omissions using the panel and its peers."""
    expected = {}
    for name in bench_tool("awfy").INNER:
        for card in (1, 5):
            expected[card, "awfy." + name] = {}
    for name in json.loads(REFERENCE.read_text()):
        if name.startswith(("cli.", "startup.")):
            expected[3, name] = {}
    observed = set()
    manifests = set()
    for row in rows:
        card, name, runtime = row["card"], row["program"], row["runtime"]
        observed.add((card, name, runtime))
        manifests.add((card, name.partition("/")[0], runtime))
        expected[card, name] = {k: row[k] for k in ("manifest", "group") if k in row}
    for (card, name), meta in expected.items():
        manifest = name.partition("/")[0]
        for runtime in runtimes:
            if runtime == "go" and not name.startswith("awfy."):
                continue
            if (card, name, runtime) in observed:
                continue
            # A manifest-level failure already accounts for its missing tasks.
            # Conversely a worker with task results needs no manifest placeholder.
            if (card, manifest, runtime) in observed or (name == manifest and (card, name, runtime) in manifests):
                continue
            yield dict(meta, card=card, program=name, runtime=runtime, status="missing measurement")


def read_receipt(path, issues):
    """Keep flushed observations even if a terminated worker left an incomplete line."""
    with path.open("rb") as stream:
        for number, line in enumerate(stream, 1):
            try:
                yield json.loads(line)
            except (ValueError, UnicodeDecodeError):
                issue = f"{path.name} has an invalid measurement on line {number}"
                if issue not in issues:
                    issues.append(issue)


def write_summary(out, rows, issues, source, elapsed, gates_path=None, runtimes=()):
    selected = runtimes or {r["runtime"] for r in rows}
    rows = rows + list(missing_rows(rows, selected))
    public = bench_tool("awfy").public_data
    rows = sorted((public(row) for row in rows), key=lambda row: (row["card"], row["program"], row["runtime"]))
    add_ratios(rows)
    headlines = daily_headlines(rows, out)
    gates = public(read_gates(gates_path))
    records = headlines + [dict(r, kind="detail") for r in rows] + gates
    first = ["kind", "card", "program", "runtime", "status", "score", "counts", "date"]
    fields = first + sorted(set().union(*(r.keys() for r in records)) - set(first))
    with (out / "summary.csv").open("w", newline="") as f:
        writer = csv.DictWriter(f, fields, lineterminator="\n")
        writer.writeheader()
        writer.writerows(records)
    lines = ["# Runtime scorecards", "", f"Source revision `{source}`.", ""]
    lines.extend(headline_table(headlines))
    titles = ["Pure Python", "Application paths", "Short programs", "Native and mixed workloads", "Time to steady state"]
    descriptions = [
        "Seconds per verified AWFY iteration or pyperf operation in the steady suffix. "
        "Go ratios require a matching port. Keep AWFY and the prospective held-outs separate.",
        "Flask reports the median of three fresh servers at each layout. Its profiling row uses a separate warm server. "
        "Counts are per completed request or pyperf operation. The six percentages partition leaf cycle samples. "
        "Shared-client layouts are diagnostic, and failed requests disqualify a gate.",
        "Whole-process wall time at the corpus's fixed work and output checks. "
        "The CLI, startup and additional fresh-process workers have separate denominators.",
        "Median time over the final five values. The stock native share includes callees up to Python re-entry. "
        "Score native-majority, mixed and boxed boundary calls separately.",
        "The last five values define the final median. The suffix must contain at least five values, "
        "all within 5% of that median. A batch reports its first operation. An unsettled row fails this card. "
        "Unit-event replays measure Lucifer churn. PyPy loop and bridge counters are in the CSV.",
    ]
    for card, title in enumerate(titles, 1):
        group = [r for r in rows if r["card"] == card]
        columns = ["program", "runtime", "status"]
        columns += {1: ["group","seconds","over_cpython","over_pypy","over_go","final_s"],
                    2: ["ops_per_s","over_cpython","final_ops_per_s","rps","rps_min","rps_max","rps_over_cpython","scaling","p99_ms","errors"],
                    3: ["seconds","over_cpython"], 4: ["seconds","over_cpython","group","stock_native_pct"],
                    5: ["first_steady_op","warmup_s","compile_ms","post_compile_ms","post_rebuilds","post_kills"]}[card]
        lines.extend([f"## {card}. {title}", "", descriptions[card-1], ""])
        lines.extend(markdown_table(group, columns))
        if card == 2:
            lines.extend(["### Warm CPU attribution", ""])
            profiles = [r for r in group if "profile_status" in r or r["program"].endswith(".profile")]
            lines.extend(markdown_table(profiles, ["program", "runtime", "profile_status", "profile_units",
                                      "instructions_per_unit", "cycles_per_unit", "compiled_pct", "interpreter_pct",
                                      "runtime_c_pct", "native_pct", "kernel_pct", "unknown_pct"]))
    repeats = []
    for r in rows:
        for metric in ("seconds", "final_s", "cycles_per_unit", "first_steady_op"):
            n = r.get(metric + "_paired_n")
            if n:
                low, high = r[metric + "_ratio_min"], r[metric + "_ratio_max"]
                repeats.append(dict(card=r["card"], program=r["program"], metric=metric, pairs=n,
                                    low=low, high=high, spread_pct=100 * (high / low - 1) if low else None))
    if repeats:
        lines.extend(["## Paired repeatability", "", "Low and high are the observed Lucifer/stock ratios "
                      "in five interleaved pairs. Spread is 100 × (high/low − 1). A final_s range is diagnostic.", ""])
        lines.extend(markdown_table(repeats, ["card", "program", "metric", "pairs", "low", "high", "spread_pct"]))
    lines.extend(["## Gates", ""])
    if gates:
        lines.extend(markdown_table(gates, ["program", "status", "score", "counts", "date", "detail"]))
    else:
        lines.extend(["Correctness gates were not supplied.", ""])
    lines.extend(["## Problems", ""])
    problems = list(public(issues))
    for gate in gates:
        if gate["status"] not in ("pass", "measured"):
            problems.append(f"{gate['program']}: {gate['status']} {gate.get('detail', '')}".rstrip())
    # List every affected observation once per reason; detailed values remain in the card tables.
    affected = {}
    for row in rows:
        for field in ("status", "profile_status", "classification_error", "telemetry"):
            reason = row.get(field)
            if reason and reason != "ok":
                affected.setdefault((row["card"], row["runtime"], reason), set()).add(row["program"])
    for (card, runtime, reason), names in sorted(affected.items()):
        problems.append(f"Card {card}, {runtime}, {reason}: {', '.join(sorted(names))}")
    lines.extend(["- " + cell(problem) for problem in problems] or ["None recorded."])
    if elapsed:
        lines.extend(["", f"The {len(elapsed)} measurement arms took {sum(elapsed.values()) / 60:.1f} "
                      "minutes including queue waits."])
    (out / "summary.md").write_text("\n".join(lines) + "\n")


def revision():
    return subprocess.check_output(["git", "rev-parse", "HEAD"], cwd=ROOT, text=True).strip()


def main():
    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--runtimes", default="cpython,lucifer,pypy,go")
    p.add_argument("--site", type=Path, default=ROOT / "build/corpus/site")
    p.add_argument("--output", type=Path, default=ROOT / "results" / f"scorecard-{datetime.datetime.now(datetime.timezone.utc).date()}")
    p.add_argument("--scratch", type=Path, default=ROOT / "build/scorecard")
    p.add_argument("--repeatability", type=Path, metavar="RUN",
                   help="measure five paired repeats on representative rows of a previous run, then render it")
    p.add_argument("--gates", type=Path, metavar="CSV", help="include the daily correctness gate results")
    p.add_argument("--summarize", type=Path, metavar="RUN", help="render a completed scratch run again")
    p.add_argument("--section", choices=["awfy","corpus","web","profile","repeat"], help=argparse.SUPPRESS)
    p.add_argument("--receipt", type=Path, help=argparse.SUPPRESS)
    args = p.parse_args()
    if args.repeatability:
        args.summarize = args.repeatability.resolve()
        recorded = json.loads((args.summarize / "run.json").read_text())["runtime_sha256"]
        current = fingerprints(("cpython", "lucifer"))
        if len(current) != 2 or any(recorded.get(label) != digest for label, digest in current.items()):
            p.error("repeatability requires the baseline stock and Lucifer executables")
        if not os.environ.get("TIMING_PREFIX"):
            p.error("set TIMING_PREFIX for paired repeats")
        repeat_dir = args.summarize / "repeatability"
        repeat_dir.mkdir(exist_ok=True)
        cmd = [sys.executable, __file__, "--section", "repeat", "--runtimes", "lucifer",
               "--site", str(args.site.resolve()), "--scratch", str(args.summarize),
               "--receipt", str(repeat_dir / "samples.jsonl")]
        with (repeat_dir / "run.log").open("w") as log:
            subprocess.run(shlex.split(os.environ["TIMING_PREFIX"]) + cmd, stdout=log, stderr=subprocess.STDOUT, check=True)
    if args.summarize:
        meta = json.loads((args.summarize / "run.json").read_text())
        issues = meta["issues"]
        rows = [row for f in sorted(args.summarize.glob("*.jsonl")) for row in read_receipt(f, issues)]
        receipt = args.summarize / "repeatability/samples.jsonl"
        if receipt.is_file():
            repeat_fields(rows, list(read_receipt(receipt, issues)))
        args.output.mkdir(parents=True, exist_ok=True)
        write_summary(args.output, rows, issues, meta["revision"], meta["elapsed_s"], args.gates,
                      meta.get("runtimes", meta.get("runtime_sha256", {})))
        return int(bool(issues))
    if args.section:
        if args.receipt is None:
            p.error("a worker needs --receipt")
        return worker(args)
    runtimes = args.runtimes.split(",")
    if not runtimes or len(runtimes) != len(set(runtimes)) or set(runtimes) - {"cpython","lucifer","pypy","go"}:
        p.error("choose distinct names from cpython,lucifer,pypy,go")
    if "cpython" not in runtimes and set(runtimes) != {"go"}:
        runtimes.insert(0, "cpython")  # stock defines the corpus classification and denominators
    if not all(os.environ.get(key) for key in ("TEST_PREFIX", "TIMING_PREFIX")):
        p.error("set TEST_PREFIX and TIMING_PREFIX for the test host")
    args.scratch.mkdir(parents=True, exist_ok=True)
    if set(runtimes) != {"go"}:
        corpus = bench_tool("corpus")
        stamp = args.site / ".lock-sha256"
        digest = hashlib.sha256(corpus.LOCK.read_bytes()).hexdigest()
        if not stamp.is_file() or stamp.read_text() != digest:
            if args.site.resolve() != (ROOT / "build/corpus/site"):
                p.error("custom --site must be prepared with the current corpus lock")
            subprocess.run(shlex.split(os.environ["TEST_PREFIX"]) + [
                sys.executable, str(ROOT / "tools/bench/corpus"), "prepare", str(args.site),
                "--cache", str(args.scratch / "downloads")], check=True)
    scratch = Path(tempfile.mkdtemp(prefix="run-", dir=args.scratch.resolve()))
    args.output.mkdir(parents=True, exist_ok=True)
    python = sorted((r for r in runtimes if r != "go"), key=lambda r: r != "cpython")
    jobs = ([("corpus", ["cpython"])] if python else []) + [("awfy", [r]) for r in runtimes]
    jobs += [("corpus", [r]) for r in python if r != "cpython"]
    if python:
        jobs += [("web",python), ("profile",python)]
    source = revision()
    runtime_sha256 = fingerprints(runtimes)
    rows, issues, elapsed = [], [], {}
    print(f"Raw observations: {scratch}", flush=True)
    for section, labels in jobs:
        label = section + "-" + "-".join(labels)
        receipt = scratch / (label + ".jsonl")
        cmd = [sys.executable, __file__, "--section", section, "--runtimes", ",".join(labels),
               "--site", str(args.site.resolve()), "--scratch", str(scratch), "--receipt", str(receipt)]
        prefix = os.environ["TEST_PREFIX" if section in ("web", "profile") else "TIMING_PREFIX"]
        print(label, flush=True)
        started = time.monotonic()
        with (scratch / (label + ".log")).open("w") as log:
            done = subprocess.run(shlex.split(prefix) + cmd, stdout=log, stderr=subprocess.STDOUT)
        if done.returncode:
            issues.append(f"{label} exited {done.returncode}")
        if receipt.exists():
            rows.extend(read_receipt(receipt, issues))
        elif not done.returncode:
            issues.append(f"{label} produced no measurements")
        elapsed[label] = round(time.monotonic() - started, 3)
        (scratch / "run.json").write_text(json.dumps(dict(revision=source, runtimes=runtimes, runtime_sha256=runtime_sha256, issues=issues, elapsed_s=elapsed), indent=2))
    write_summary(args.output, rows, issues, source, elapsed, args.gates, runtimes)
    return int(bool(issues))


if __name__ == "__main__":
    sys.exit(cold_execution() if sys.argv[1:] == ["--cold-exec"] else main())
