    titles = ["Pure Python", "Application paths", "Short programs", "Native and mixed workloads", "Post-warm-up JIT churn"]
    descriptions = [
        f"AWFY discards the first {AWFY_WARMUPS} verified in-process iterations for every runtime. "
        f"It reports the median and a 95% bootstrap interval over the next {AWFY_VALUES}. "
        f"Pyperformance discards {CORPUS_WARMUPS} warm-up values and reports pyperf’s mean and sample "
