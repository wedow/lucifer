        f"Hyperfine measures process launch through exit with {WHOLE_WARMUPS} warm-up and {WHOLE_RUNS} measured runs. "
        "Whole-process columns report hyperfine’s mean, sample standard deviation, median and minimum, in seconds.",
        "Pyperf reports mean seconds per operation after warm-up. The stock native share includes callees up "
        "to Python re-entry. The boundary programs measure boxed calls into a native module.",
        "Lucifer’s event log counts every build, kill and millisecond spent compiling during the measured "
        "iterations. Any measured churn fails the card. PyPy reports available loop and bridge counters.",
    ]
    for card, title in enumerate(titles, 1):
        group = [r for r in rows if r["card"] == card]
        columns = ["program", "runtime", "status"]
        columns += {
            1: ["group", "seconds", "stdev_s", "95% interval", "× stock", "× PyPy", "× Go"],
            2: ["seconds", "stdev_s", "rps", "95% interval", "× stock", "scaling", "p99_ms", "errors"],
            3: [],
            4: ["group", "seconds", "stdev_s", "95% interval", "× stock", "stock_native_pct"],
            5: ["post_builds", "post_kills", "post_compile_ms", "post_compiled_loops", "post_compiled_bridges",
                "post_freed_loops", "post_freed_bridges", "telemetry"],
        }[card]
