def bench_tool(name):
    """Load a benchmark driver with its own globals (cold timing overrides execute)."""
    from importlib.machinery import SourceFileLoader
    from importlib.util import module_from_spec, spec_from_loader

    loader = SourceFileLoader(name, str(BENCH / name))
    module = module_from_spec(spec_from_loader(name, loader))
    loader.exec_module(module)
    return module


def settling(samples):
    """Earliest suffix of at least five values, all within 5% of the last five's median."""
    if len(samples) < 5:
        return None, None
    final = statistics.median(samples[-5:])
    low, high = .95 * final, 1.05 * final
    bad = [i for i, value in enumerate(samples) if not low <= value <= high]
    start = bad[-1] + 1 if bad else 0
    return (start if len(samples) - start >= 5 else None), final


def warm_rows(program, runtime, samples_seconds, loops=1):
    start, final = settling(samples_seconds)
    common = dict(program=program, runtime=runtime, values=len(samples_seconds), ops_per_value=loops)
    settled = start is not None
    seconds = statistics.median(samples_seconds[start:]) / loops if settled else None
    return [dict(common, card=1, status="ok" if settled else "unsettled", seconds=seconds,
                 final_s=final / loops if final is not None else None),
            dict(common, card=5, status="ok" if settled else "unsettled",
                 first_steady_op=start * loops + 1 if settled else None,
                 warmup_s=sum(samples_seconds[:start]) if settled else None)]


def add_ratios(rows):
    indexed = {(r["card"], r["program"], r["runtime"]): r for r in rows}
    for row in rows:
        if row["card"] == 2 and row.get("seconds"):
            row["ops_per_s"] = 1 / row["seconds"]
        if row["card"] == 2 and row.get("final_s"):
            row["final_ops_per_s"] = 1 / row["final_s"]
        if row.get("rps") and row.get("layout") == "disjoint":
            one = indexed.get((2, "flask.1", row["runtime"]), {})
            if row["status"] == one.get("status") == "ok" and one.get("rps"):
                row["scaling"] = row["rps"] / one["rps"]
        for label in ("cpython", "pypy", "go"):
            ref = indexed.get((row["card"], row["program"], label), {})
            if row.get("seconds") and ref.get("seconds") and row["status"] == ref["status"] == "ok":
                row["over_" + label] = row["seconds"] / ref["seconds"]
            if row.get("final_s") and ref.get("final_s"):
                row["final_over_" + label] = row["final_s"] / ref["final_s"]
            if label == "cpython" and row.get("rps") and ref.get("rps") and row["status"] == ref["status"] == "ok":
                row["rps_over_cpython"] = row["rps"] / ref["rps"]


# Unit events are collected on a second execution. The ordinary timed
# process never pays for the event logger's IR fingerprinting.
def jit_counts(events, first, last):
    """Build time through last, and churn in [first, last], in Unix seconds."""
    compile_ms = post_compile_ms = 0.0
    rebuilds = kills = 0
    for line in events:
        match = re.match(r"^jit-ev (\d+\.\d+) (build|putoff|kill) (.*)", line)
        if not match:
            continue
        stamp, event, detail = float(match[1]), match[2], match[3]
        if stamp > last:
            continue
        if event in ("build", "putoff"):
            duration = re.search(r"\bms ([\d.]+)", detail)
            if duration:
                cost = float(duration[1])
                compile_ms += cost
                if first is not None and stamp >= first:
                    post_compile_ms += cost
        if first is not None and stamp >= first:
            kills += event == "kill"
            rebuilds += event == "build" and not detail.rstrip().endswith(": first")
    counts = {"compile_ms": round(compile_ms, 3)}
    if first is not None:
        counts.update(post_rebuilds=rebuilds, post_kills=kills, post_compile_ms=round(post_compile_ms, 3))
    return counts


# Source shared with the diagnostic workers. The PyPy profiler accounts for
# tracing and backend time exclusively. A bridge extends an existing trace;
# the freed counters advance when the GC releases a compiled loop token.
PYPY_SNAPSHOT = """\
def pypy_snapshot():
    import pypyjit
    snap = pypyjit.get_stats_snapshot()
    result = {phase.lower() + "_ms": 1000 * snap.counter_times[phase] for phase in ("TRACING", "BACKEND")}
    for key in ("compiled_loops", "compiled_bridges", "freed_loops", "freed_bridges"):
        result[key] = snap.counters["TOTAL_" + key.upper()]
    return result
"""


def pypy_counts(first, last):
    result = {"compile_ms": last["tracing_ms"] + last["backend_ms"]}
    if first is not None:
        result["post_compile_ms"] = result["compile_ms"] - first["tracing_ms"] - first["backend_ms"]
        for key in ("compiled_loops", "compiled_bridges", "freed_loops", "freed_bridges"):
            result["post_" + key] = last[key] - first[key]
    return result


AWFY_CLOCKS = """\
import os, sys, time
from run import Run
pypy = sys.implementation.name == "pypy"
measure = Run.measure
index = 0
def stamped(self, bench):
    global index
    if pypy and index == int(os.environ["STEADY_INDEX"]):
        print("snapshot-first", repr(pypy_snapshot()), file=sys.stderr)
    print("iteration-begin", time.time(), file=sys.stderr)
    measure(self, bench)
    print("iteration-end", time.time(), file=sys.stderr)
    index += 1
    if pypy and index == self._num_iterations:
        print("snapshot-last", repr(pypy_snapshot()), file=sys.stderr)
Run.measure = stamped
import harness
"""


def awfy_samples(argv, source, name, driver):
    """Observe the verified worker's flushed result boundaries in the parent."""
    import threading
    started = time.monotonic()
    samples, completions, output = [], [], []
    with subprocess.Popen(argv, cwd=source, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                          text=True, errors="replace") as proc:
        def read():
            for line in proc.stdout:
                elapsed = time.monotonic() - started
                output.append(line)
                value = driver.parse_samples(name, line)
                if value:
                    samples.extend(value)
                    completions.append(elapsed)
        reader = threading.Thread(target=read, daemon=True)
        reader.start()
        try:
            code = proc.wait(timeout=120)
        finally:
            if proc.poll() is None:
                proc.kill()
            reader.join(timeout=5)
    if code or len(samples) != 10 or min(samples) <= 0 or not any("Total Runtime:" in line for line in output):
        raise ValueError(f"AWFY verification or sample count failed (exit {code})")
    return [v * 1e-6 for v in samples], completions


def awfy_telemetry(runtime, command, source, args, directory, start, driver):
    events = directory / "events.log"
    env = {**os.environ, "STEADY_INDEX": str(start if start is not None else -1)}
    code = AWFY_CLOCKS
    if runtime == "pypy":
        code = PYPY_SNAPSHOT + code
    else:
        env["LUCIFER_JIT_DEBUG"] = "units"
    with events.open("w") as log:
        replay = subprocess.run(command + ["-u", "-c", code] + args, cwd=source, env=env,
                                stdout=subprocess.PIPE, stderr=log, text=True, timeout=120)
    if replay.returncode or len(driver.parse_samples(args[0], replay.stdout)) != 10:
        raise ValueError("incomplete event replay")
    if runtime == "pypy":
        with events.open() as log:
            snapshots = {key: ast.literal_eval(data) for key, data in
                         (line.split(" ", 1) for line in log if line.startswith("snapshot-"))}
        first = snapshots["snapshot-first"] if start is not None else None
        return pypy_counts(first, snapshots["snapshot-last"])
    with events.open() as log:
        stamps = [line.split() for line in log if line.startswith(("iteration-begin ", "iteration-end "))]
    if len(stamps) != 20 or any(row[0] != ("iteration-begin", "iteration-end")[i % 2] for i, row in enumerate(stamps)):
        raise ValueError("incomplete event window")
    first = float(stamps[2 * start][1]) if start is not None else None
    with events.open() as log:
        return jit_counts(log, first, float(stamps[-1][1]))


def awfy_rows(runtime, command, scratch, names):
    driver = bench_tool("awfy")
    source = ROOT / "third_party/awfy/Python"
    for name in names:
        program = "awfy." + name
        directory = scratch / runtime / program
        directory.mkdir(parents=True, exist_ok=True)
        args = [name, "10", str(driver.INNER[name])]
        argv = command + ([] if runtime == "go" else ["-u", "harness.py"]) + args
        try:
            seconds, ends = awfy_samples(argv, source, name, driver)
            raw = dict(inner=driver.INNER[name], samples_s=seconds, completed_after_s=ends)
            (directory / "series.json").write_text(json.dumps(raw) + "\n")
        except (OSError, ValueError, subprocess.TimeoutExpired) as exc:
            for card in (1, 5):
                yield dict(card=card, program=program, runtime=runtime, status=str(exc))
            continue

        timing, warmup = warm_rows(program, runtime, seconds)
        start, _ = settling(seconds)
        warmup["launch_to_first_complete_s"] = ends[0]
        if start is not None:
            # Completion observed by the parent, minus the worker's own
            # verified work duration. Includes a configured launch prefix.
            warmup["launch_to_steady_s"] = ends[start] - seconds[start]
        if runtime in ("lucifer", "pypy"):
            try:
                warmup.update(awfy_telemetry(runtime, command, source, args, directory, start, driver))
                warmup["telemetry"] = "ok"
            except (KeyError, OSError, ValueError, subprocess.TimeoutExpired) as exc:
                warmup["telemetry"] = str(exc)
        yield timing
        yield warmup


def cold_execution():
    # Run the timer inside the optional resource-control prefix so setting up
    # the scope does not become part of the measured process lifetime.
    argv, site, cwd, timeout, receipt = json.load(sys.stdin)
    status, out, err, wall = bench_tool("corpus").execute(argv, Path(site), cwd, timeout)
    Path(receipt).write_text(json.dumps([status, wall]))
    sys.stdout.buffer.write(out)
    sys.stderr.buffer.write(err)


def scoped_cold(prefix, scratch):
    def execute(argv, site, cwd, timeout):
        with tempfile.TemporaryDirectory(dir=scratch) as temp:
            receipt = Path(temp) / "wall.json"
            command = prefix + [sys.executable, str(ROOT / "tools/scorecard"), "--cold-exec"]
            msg = json.dumps([argv, str(site), str(cwd), timeout, str(receipt)]).encode()
            done = subprocess.run(command, input=msg, capture_output=True, check=True, timeout=timeout + 15)
            status, wall = json.loads(receipt.read_text())
            return status, done.stdout, done.stderr, wall
    return execute


def cold_rows(runtime, command, site, scratch, names=None):
    """Use the status suite's files, oracle output checks, loop counts and statistic."""
    corpus = bench_tool("corpus")
    if runtime == "lucifer" and os.environ.get("LUCIFER_PREFIX"):
        corpus.execute = scoped_cold(shlex.split(os.environ["LUCIFER_PREFIX"]), scratch)
    reference = json.loads(REFERENCE.read_text())
    for program, (kind, argv) in corpus.programs(site).items():
        if program.partition(".")[0] not in ("startup", "cli"):
            continue
        if names is not None and program not in names:
            continue
        expected = reference.get(program)
        result = {"status": "missing oracle check", "seconds": None}
        if expected and expected.get("check"):
            try:
                result = corpus.MEASURE[kind](command, argv, site, expected)
            except (OSError, subprocess.SubprocessError) as exc:
                result["status"] = type(exc).__name__
        yield dict(card=3, program=program, runtime=runtime, status=result["status"], seconds=result["seconds"])


# cmath is a loadable CPython extension on the free-threaded runtimes.
# Prebuilt complex arguments avoid measuring construction in the call loop.
BOUNDARY = """\
import cmath, sys, time
args = [complex(0, i) for i in range(64)]
one = 17j
def unary():
    count = 0
    for _ in range(2048):
        for arg in args:
            count += cmath.isfinite(arg)
    return count
def binary():
    count = 0
    for _ in range(2048):
        for arg in args:
            count += cmath.isclose(arg, one)
    return count
fn, answer = (unary, 64 * 2048) if sys.argv[1] == "isfinite" else (binary, 2048)
for _ in range(10):
    start = time.perf_counter()
    count = fn()
    duration = time.perf_counter() - start
    if count != answer:
        raise ValueError("wrong boundary result")
    print(duration / (64 * 2048))
"""


def boundary_rows(runtime, command, site, scratch):
    for operation in ("isfinite", "isclose"):
        row = dict(card=4, program="boundary.cmath." + operation, runtime=runtime)
        try:
            done = subprocess.run(command + ["-c", BOUNDARY, operation], capture_output=True,
                                  text=True, timeout=90, check=True)
            values = [float(v) for v in done.stdout.splitlines()]
            if len(values) != 10 or min(values) <= 0:
                raise ValueError("invalid boundary samples")
            row.update(status="ok", seconds=statistics.median(values[-5:]))
        except (OSError, ValueError, subprocess.SubprocessError) as exc:
            row["status"] = type(exc).__name__
        yield row


def perf_child(stack, args, scratch, pid):
    """Start disabled, then wait for perf to confirm attachment to the worker."""
    recv, send = os.pipe()
    ack, reply = os.pipe()
    for fd in (recv, send, ack, reply):
        stack.callback(os.close, fd)
    err = stack.enter_context((scratch / (args[0] + '.log')).open('w'))
    proc = subprocess.Popen(['perf', *args, '-p', str(pid), '-D', '-1', '--control',
                             f'fd:{recv},{reply}'], pass_fds=(recv, reply), stderr=err,
                            stdout=subprocess.DEVNULL, env={**os.environ, 'LC_ALL': 'C'})

    def stop():
        if proc.poll() is None:
            proc.send_signal(signal.SIGINT)
            try:
                proc.wait(timeout=5)
            except subprocess.TimeoutExpired:
                proc.kill()
                proc.wait()

    stack.callback(stop)
    def control(message):
        os.write(send, message + b'\n')
        if not select.select([ack], [], [], 5)[0] or b'ack' not in os.read(ack, 32):
            raise RuntimeError('perf ' + args[0] + ' control failed')

    control(b'enable')
    return lambda: control(b'disable')


def compiled_ranges(pid, runtime):
    if runtime != 'lucifer':
        return []
    # codemem.c maps each shared anonymous chunk twice. Match the executable
    # view to a writable view of the same shmem inode, ignoring other mappings.
    maps = Path(f'/proc/{pid}/maps').read_text().splitlines()
    writable = set()
    executable = []
    for line in maps:
        fields = line.split(None, 5)
        if len(fields) != 6 or fields[5] != '/dev/zero (deleted)' or fields[4] == '0':
            continue
        address, perms, offset, device, inode, _ = fields
        key = offset, device, inode
        if perms == 'rw-s':
            writable.add(key)
        elif perms == 'r-xs':
            lo, hi = (int(i, 16) for i in address.split('-'))
            executable.append((lo, hi, key))
    return [(lo, hi) for lo, hi, key in executable if key in writable]


def app_leaf(ip, sym, image, compiled, executable):
    if ip >= 1 << 63 or image.startswith(('[kernel', '[guest.kernel')):
        return 'kernel'
    if any(lo <= ip < hi for lo, hi in compiled):
        return 'compiled'
    if sym.startswith(('eval_frame', '_PyEval_EvalFrameDefault', 'pypy_g_dispatch_bytecode',
                       'pypy_g_PyFrame_dispatch')):
        return 'interpreter'
    if ('.cpython-' in image or '.pypy' in image or '.abi3.so' in image
            or '/lib-dynload/' in image or ('/site-packages/' in image and '.so' in image)):
        return 'native'
    # For the executable and runtime library, unresolved functions cannot
    # distinguish the dispatch loop from the remainder of the C runtime.
    base = Path(image).name
    if base == executable or base.startswith(('libpython', 'libpypy')):
        return 'unknown' if sym.startswith(('[unknown]', '0x')) else 'runtime_c'
    if base.startswith(('libc.so', 'libpthread.', 'libm.so', 'libgcc_s.', 'ld-linux')):
        return 'runtime_c'
    return 'unknown'


def perf_window(pid, sample, scratch, runtime):
    """Measure server/worker threads only. sample runs once and returns completed units."""
    scratch = Path(scratch)
    scratch.mkdir(parents=True, exist_ok=True)
    stat, data = scratch / 'counts.csv', scratch / 'cycles.data'
    for path in (stat, data):
        path.unlink(missing_ok=True)
    errors = []
    observers = [('stat', ['stat', '-x,', '-e', 'instructions,cycles', '-o', str(stat)]),
                 ('record', ['record', '--no-buildid-cache', '-q', '-e', 'cycles', '-F', '199',
                             '-m', '64', '-o', str(data)])]
    ready = {}
    with contextlib.ExitStack() as stack:
        for name, args in observers:
            try:
                ready[name] = perf_child(stack, args, scratch, pid)
            except (OSError, RuntimeError) as exc:
                errors.append(str(exc))
        executable = Path(os.readlink(f'/proc/{pid}/exe')).name
        compiled = compiled_ranges(pid, runtime)
        count = sample()
        for pause in ready.values():
            try:
                pause()
            except (OSError, RuntimeError) as exc:
                errors.append(str(exc))
        if Path(f'/proc/{pid}/maps').exists():
            compiled += compiled_ranges(pid, runtime)
    result = {'profile_units': count, 'profile_scope': 'worker threads and inherited tasks'}
    if runtime == 'pypy':
        result['mapping_note'] = 'unmapped PyPy JIT PCs are unresolved'
    if not count:
        return {**result, 'profile_status': 'no completed work'}
    if 'stat' in ready:
        for line in stat.read_text().splitlines():
            fields = line.split(',')
            if len(fields) > 2 and fields[0].isdigit() and fields[2] in ('instructions', 'cycles'):
                result[fields[2] + '_per_unit'] = int(fields[0]) / count
        if 'instructions_per_unit' not in result or 'cycles_per_unit' not in result:
            errors.append('hardware counts unavailable')
    if 'record' in ready:
        done = subprocess.run(['perf', 'script', '--no-inline', '-i', str(data), '-F', 'period,ip,sym,dso'],
                              capture_output=True, text=True, errors='replace')
        totals = Counter()
        samples = 0
        for line in done.stdout.splitlines():
            m = re.fullmatch(r'\s*(\d+)\s+([0-9a-fA-F]+)\s+(.*?)\s+\((.*)\)\s*', line)
            if not m:
                if line.strip():
                    errors.append('unparsed cycle samples')
                    break
                continue
            kind = app_leaf(int(m[2], 16), m[3], m[4], compiled, executable)
            totals[kind] += int(m[1])
            samples += 1
        if done.returncode or not sum(totals.values()):
            errors.append('cycle attribution unavailable')
        else:
            result['profile_samples'] = samples
            for kind in ('compiled', 'interpreter', 'runtime_c', 'native', 'kernel', 'unknown'):
                result[kind + '_pct'] = 100 * totals[kind] / sum(totals.values())
    result['profile_status'] = ', '.join(errors) or 'ok'
    return result


def flask_layouts(web):
    order, client = web.layout()
    for n in (1, 8):
        available = n <= len(order) and not set(order[:n]).intersection(client)
        yield f'flask.{n}', order[:n] if available else [], client, 'disjoint'
        if not available:
            cores = web.cores()
            shared = [cpus[0] for cpus in cores] + [c for cpus in cores for c in cpus[1:]]
            if n <= len(shared):
                yield f'flask.{n}.shared', shared[:n], client, 'shared-client'


def flask_command(command, site, log, events=False):
    args = ['env', f'PYTHONPATH={site}', 'PYTHONDONTWRITEBYTECODE=1']
    if events:
        args += ['LUCIFER_JIT_DEBUG=units']
    # The web driver inherits stderr. Redirect just this server and preserve
    # its PID across exec so perf observes the application and its threads.
    return shlex.join(['sh', '-c', 'exec "$@" 2>"$0"', str(log), *args, *command])


@contextlib.contextmanager
def flask_server(web, command, cpus):
    # web.Server waits indefinitely for a ready line. Bound daily runs even
    # when the command is an external runtime launcher or fails during import.
    argv = ['taskset', '-c', web.cpu_list(cpus), *shlex.split(command), str(web.HERE / 'app.py'), '0']
    with subprocess.Popen(argv, stdout=subprocess.PIPE, text=True, start_new_session=True) as proc:
        try:
            if not select.select([proc.stdout], [], [], 45)[0]:
                raise RuntimeError('server startup timeout')
            line = proc.stdout.readline().split()
            if len(line) != 2 or line[0] != 'listening':
                raise RuntimeError('server startup failed')
            yield SimpleNamespace(port=int(line[1]), process=proc)
        finally:
            try:
                os.killpg(proc.pid, signal.SIGKILL)
            except ProcessLookupError:
                pass


def flask_pid(server):
    # A launcher may retain its PID and fork the server. Find the worker
    # holding this port inside the launched tree before attaching counters.
    port = f'{server.port:04X}'
    root = Path('/proc')
    inodes = set()
    for path in ('net/tcp', 'net/tcp6'):
        file = root / str(server.process.pid) / path
        if file.exists():
            for line in file.read_text().splitlines()[1:]:
                fields = line.split()
                if fields[3] == '0A' and fields[1].split(':')[-1] == port:
                    inodes.add('socket:[' + fields[9] + ']')
    todo = [server.process.pid]
    while todo:
        pid = todo.pop()
        folder = root / str(pid)
        try:
            for fd in (folder / 'fd').iterdir():
                try:
                    if os.readlink(fd) in inodes:
                        return pid
                except FileNotFoundError:
                    continue
            for children in (folder / 'task').glob('*/children'):
                todo.extend(map(int, children.read_text().split()))
        except FileNotFoundError:
            continue
    raise RuntimeError('cannot identify the server listener')


PYPY_FLASK = """
import json, os, runpy, signal, sys, time
def snapshot(signum, frame):
    record = dict(pypy_snapshot(), timestamp=time.time())
    os.write(1, (json.dumps(record) + chr(10)).encode())
signal.signal(signal.SIGUSR1, snapshot)
sys.argv = sys.argv[1:]
runpy.run_path(sys.argv[0], run_name="__main__")
"""


def flask_snapshot(server, pid):
    os.kill(pid, signal.SIGUSR1)
    stream = server.process.stdout
    if not select.select([stream], [], [], 5)[0]:
        raise RuntimeError('PyPy snapshot timeout')
    return json.loads(stream.readline())


def flask_windows(web, args, command, server_cpus, client, snapshots=None):
    windows = []
    origin = time.monotonic()
    with flask_server(web, command, server_cpus) as server:
        pid = flask_pid(server) if snapshots is not None else None
        for _ in range(10):
            if snapshots is not None:
                snapshots.append(flask_snapshot(server, pid))
            start, elapsed = time.time(), time.monotonic() - origin
            window = web.wrk(args, server.port, 2, client)
            if not window['requests'] or server.process.poll() is not None:
                raise ValueError('server exited or completed no requests')
            windows.append(dict(window, start=start, end=time.time(), elapsed=elapsed))
        if snapshots is not None:
            snapshots.append(flask_snapshot(server, pid))
    return windows


def flask_rows(runtime, command, site, scratch):
    """Uninstrumented daily web mix and a separate cold series on each server layout."""
    web = bench_tool('web/bench')
    args = SimpleNamespace(wrk=os.environ.get('WRK', 'wrk'), connections=64, warmup=10, duration=10)
    web.Server = functools.partial(flask_server, web)
    check = None
    for program, cpus, client, layout in flask_layouts(web):
        base = dict(program=program, runtime=runtime, layout=layout)
        if not cpus:
            for card in (2, 5):
                yield dict(base, card=card, status='insufficient disjoint CPUs')
            continue
        out = Path(scratch) / runtime / program
        out.mkdir(parents=True, exist_ok=True)
        server_command = flask_command(command, site, out / 'server.log')
        try:
            if check is None:
                with flask_server(web, server_command, cpus) as server:
                    transcript = json.dumps(web.transcript(server.port)).encode()
                digest = hashlib.sha256(transcript).hexdigest()
                reference = Path(scratch) / 'flask-transcript.sha256'
                if runtime == 'cpython':
                    reference.write_text(digest)
                check = 'ok' if reference.is_file() and reference.read_text() == digest else 'response mismatch'
            with flask_server(web, server_command, cpus) as server:
                problems = web.hammer(server.port)
            points = [web.point(args, runtime, server_command, len(cpus), cpus, client) for _ in range(3)]
            (out / 'throughput.json').write_text(json.dumps(points))
            rates = [p['rps'] for p in points]
            errors = sum(p['errors'] for p in points)
            status = check
            if problems:
                status = 'concurrent update mismatch'
            if any(p['server_exit'] is not None for p in points):
                status = 'server exited'
            yield dict(base, card=2, status='request errors' if errors else status, response_check=check,
                       rps=statistics.median(rates), rps_min=min(rates), rps_max=max(rates), errors=errors,
                       concurrent_check='ok' if not problems else ', '.join(problems),
                       cpus=len(cpus), repeats=len(rates), p99_ms=statistics.median(p['p99_ms'] for p in points))
        except (OSError, ValueError, RuntimeError) as exc:
            yield dict(base, card=2, status=str(exc))
        try:
            windows = flask_windows(web, args, server_command, cpus, client)
            (out / 'warmup.json').write_text(json.dumps(windows))
            rates = [w['duration_us'] * 1e-6 / w['requests'] for w in windows]
            start, final = settling(rates)
            errors = sum(w['errors'] for w in windows)
            row = dict(base, card=5, status='unsettled' if start is None else 'ok',
                       final_s=final, samples=len(windows), errors=errors)
            if start is not None:
                row.update(first_steady_op=1 + sum(w['requests'] for w in windows[:start]),
                           warmup_s=windows[start]['elapsed'])
            if errors:
                row['status'] += ', request errors'
            if runtime == 'lucifer':
                try:
                    events = out / 'events.log'
                    replay = flask_windows(web, args, flask_command(command, site, events, True), cpus, client)
                    (out / 'warmup-replay.json').write_text(json.dumps(replay))
                    with events.open(errors='replace') as lines:
                        row.update(jit_counts(lines, replay[start]['start'] if start is not None else None,
                                              replay[-1]['end']))
                    row['telemetry'] = 'ok'
                except (OSError, RuntimeError, ValueError) as exc:
                    row['telemetry'] = str(exc)
            elif runtime == 'pypy':
                snapshots = []
                try:
                    cmd = command + ['-c', PYPY_SNAPSHOT + PYPY_FLASK]
                    replay_command = flask_command(cmd, site, out / 'telemetry.log')
                    flask_windows(web, args, replay_command, cpus, client, snapshots)
                    (out / 'pypy-snapshots.json').write_text(json.dumps(snapshots))
                    row.update(pypy_counts(snapshots[start] if start is not None else None, snapshots[-1]))
                    row['telemetry'] = 'ok'
                except (OSError, RuntimeError, ValueError, KeyError) as exc:
                    row['telemetry'] = str(exc)
            yield row
        except (OSError, ValueError, RuntimeError) as exc:
            yield dict(base, card=5, status=str(exc))


def flask_profile_rows(runtime, command, site, scratch):
    """Profile a separate warm server under the timing prefix at its available layouts."""
    web = bench_tool('web/bench')
    args = SimpleNamespace(wrk=os.environ.get('WRK', 'wrk'), connections=64)
    for program, cpus, client, layout in flask_layouts(web):
        name = program + '.profile'
        if not cpus:
            yield dict(card=2, program=name, runtime=runtime, layout=layout,
                       status='insufficient disjoint CPUs', profile_status='insufficient disjoint CPUs')
            continue
        out = Path(scratch) / runtime / name
        out.mkdir(parents=True, exist_ok=True)
        row = dict(card=2, program=name, runtime=runtime, layout=layout, cpus=len(cpus))
        try:
            with flask_server(web, flask_command(command, site, out / 'server.log'), cpus) as server:
                web.wrk(args, server.port, 10, client)

                def sample():
                    result = web.wrk(args, server.port, 5, client)
                    row['errors'] = result['errors']
                    return result['requests']

                row.update(perf_window(flask_pid(server), sample, out, runtime))
                row['status'] = row['profile_status'] if not row['errors'] else 'request errors'
        except (OSError, ValueError, RuntimeError) as exc:
            row['status'] = str(exc)
        yield row


# Run the pinned benchmark's own task and clock. Timing, profiling and JIT
# event collection use disjoint windows. The benchmark source is unchanged.
CORPUS_WORKER = """
import builtins, json, math, os, runpy, sys, time
from pyperf._worker import WorkerTask

channel = os.fdopen(os.dup(1), "w", 1)
with open(os.environ["SCORECARD_STDOUT"], "w") as log:
    os.dup2(log.fileno(), 1)
mode = os.environ["SCORECARD_OBSERVER"]
snapshot = os.environ.get("SCORECARD_PYPY_STATS")
original = WorkerTask._compute_values

def values(self, dest, count, **kwargs):
    if os.environ["SCORECARD_RUNTIME"] == "cpython":
        if sys.version_info[:2] != (3, 14) or sys.abiflags != 't' or sys._is_gil_enabled():
            raise ValueError("classification requires CPython 3.14t with GIL disabled")
    work = self.task_func
    stamps = []
    snapshots = []
    def timed(task, loops):
        if snapshot:
            snapshots.append(pypy_snapshot())
        begin = time.time()
        value = work(task, loops)
        stamps.append([begin, time.time()])
        return value
    self.task_func = timed
    try:
        original(self, dest, count, **kwargs)
    finally:
        self.task_func = work
    if snapshot:
        snapshots.append(pypy_snapshot())
    ops = self.loops * (self.inner_loops or 1)
    print(json.dumps(dict(task=self.name, pid=os.getpid(), ops=ops, values=dest, stamps=stamps, snapshots=snapshots,
                          version=sys.version.split()[0], gil_enabled=(sys._is_gil_enabled()
                          if hasattr(sys, "_is_gil_enabled") else None))), file=channel)
    if mode:
        # Keep the process alive while the parent attaches and reads counters.
        if sys.stdin.readline() != "go\\n":
            raise RuntimeError("profile controller disconnected")
        repeats = max(1, min(1000, math.ceil(0.8 / (max(dest[-3:]) * ops))))
        for _ in range(repeats):
            work(self, self.loops)
        print(json.dumps(dict(completed=repeats * ops)), file=channel)
        if sys.stdin.readline() != "next\\n":
            raise RuntimeError("profile controller disconnected")

WorkerTask._compute_values = values
sys.argv = sys.argv[1:]
sys.path.insert(0, os.path.dirname(sys.argv[0]))
runpy.run_path(sys.argv[0], init_globals={"__builtins__": builtins}, run_name="__main__")
"""


@functools.lru_cache(maxsize=4)
def corpus_inputs(site):
    corpus = bench_tool("corpus")
    return corpus, corpus.pyperformance(site), json.loads(REFERENCE.read_text())


@functools.lru_cache(maxsize=None)
def command_benchmark(script):
    # The pinned runner uses bench_command for a fresh process per operation.
    calls = (node.func for node in ast.walk(ast.parse(Path(script).read_text())) if isinstance(node, ast.Call))
    return any(isinstance(func, ast.Attribute) and func.attr == "bench_command" for func in calls)


def corpus_classification(name, argv, share):
    # Length is the lifetime of the benchmarked workload: a new process per
    # operation is short, while an in-process worker can run indefinitely.
    if name in bench_tool("corpus").STARTUP or (argv and command_benchmark(argv[0])):
        return 3, "fresh process"
    if argv:
        directory = Path(argv[0]).parent
        variant = directory / f"bm_{name}.toml"
        tags = set()
        for config in [directory / "pyproject.toml", variant]:
            if config.is_file():
                meta = tomllib.loads(config.read_text()).get("tool", {}).get("pyperformance", {})
                tags.update(re.findall(r"\w+", str(meta.get("tags", ""))))
        if tags & {"apps", "template"}:
            return 2, "application"
    if share is None:
        return 4, "unmeasured guard"
    if share < 5:
        return 1, "held out"
    return 4, "native majority" if share > 50 else "mixed"


def native_sample_periods(data, executable):
    """Charge extension calls up to the innermost Python evaluator, by cycles."""
    cmd = ["perf", "script", "-i", str(data), "--no-inline", "-F", "period,ip,sym,dso,dsoff"]
    grouped = subprocess.check_output(cmd, text=True, stderr=subprocess.DEVNULL, timeout=30)
    flat = subprocess.check_output(cmd + ["-G"], text=True, stderr=subprocess.DEVNULL, timeout=30).splitlines()
    groups = [s for s in grouped.strip().split("\n\n") if s.strip()]
    if len(flat) != len(groups):
        raise ValueError("flat/stack sample count differs")
    traces = []
    addresses = {}
    for group, leaf in zip(groups, flat):
        head, *frames = group.splitlines()
        period, fallback = leaf.strip().split(None, 1)
        if int(head) != int(period):
            raise ValueError("flat/stack sample period differs")
        stack = []
        for frame in frames or [fallback]:
            m = re.fullmatch(r"\s*[0-9a-f]+ (.*?) \((.*?)(?:\+(0x[0-9a-f]+))?\)", frame)
            if not m:
                raise ValueError("unrecognized perf stack frame")
            symbol, image, offset = m.groups()
            if symbol.startswith("_PyEval_EvalFrameDefault"):
                break
            stack.append((image, offset))
            if offset and (image == executable or Path(image).name.startswith("libpython3.14")):
                addresses.setdefault(image, set()).add(offset)
        traces.append((int(period), stack))
    module = set()
    for image, offsets in addresses.items():
        ordered = sorted(offsets)
        result = subprocess.run(["llvm-symbolizer", "--obj=" + image, "--output-style=JSON"],
                                input="\n".join(ordered) + "\n", capture_output=True, text=True,
                                check=True, timeout=30)
        records = [json.loads(line) for line in result.stdout.splitlines()]
        if len(records) != len(ordered) or not any(s["FileName"] for record in records for s in record["Symbol"]):
            raise ValueError("missing stock debug lines for native modules")
        for offset, record in zip(ordered, records):
            if any(re.search(r"(?:^|/)Modules/(?!main\.c)", s["FileName"]) for s in record["Symbol"]):
                module.add((image, offset))
    total = sum(weight for weight, stack in traces)
    native = sum(weight for weight, stack in traces if any(
        frame in module or "/lib-dynload/" in frame[0] or ".cpython-314t-" in frame[0]
        or ("/site-packages/" in frame[0] and ".so" in frame[0])
        or re.search(r"/lib(?:sqlite3|expat|mpdec|ssl|crypto|zstd)\.so", frame[0]) for frame in stack))
    if not total or len(traces) < 10:
        raise ValueError("too few stock cycle samples")
    return native, total, len(traces)


def native_window(pid, sample, scratch):
    data = scratch / "native.data"
    samples = {}
    with contextlib.ExitStack() as stack:
        try:
            executable = os.readlink(f"/proc/{pid}/exe")
            disable = perf_child(stack, ["record", "--no-buildid-cache", "-q", "-e", "cycles:u", "-F", "249",
                                         "--call-graph", "dwarf,4096", "-m", "256K", "-o", str(data)], scratch, pid)
        except (OSError, RuntimeError) as exc:
            sample()
            return {"classification_error": str(exc)}
        completed = sample()
        try:
            disable()
        except (OSError, RuntimeError) as exc:
            return {"classification_error": str(exc)}
    try:
        native, total, count = native_sample_periods(data, executable)
        samples.update(native_cycles_per_unit=native / completed, user_cycles_per_unit=total / completed,
                       stock_samples=count)
    except (OSError, ValueError, subprocess.SubprocessError) as exc:
        samples["classification_error"] = str(exc)
    finally:
        data.unlink(missing_ok=True)
    return samples


def corpus_process(command, argv, site, runtime, directory, loops, observer="", jit=False):
    """Collect each named pyperf subbenchmark in its real execution order."""
    directory.mkdir(parents=True, exist_ok=True)
    worker = directory / "worker.py"
    pypy_stats = jit and runtime == "pypy"
    worker.write_text((PYPY_SNAPSHOT if pypy_stats else "") + CORPUS_WORKER)
    deadline = time.monotonic() + 110
    stderr = directory / "stderr.log"
    tasks = {}
    with contextlib.ExitStack() as stack:
        env = dict(os.environ, PYTHONHASHSEED="0", PYTHONPATH=str(site), SCORECARD_STDOUT=str(directory / "stdout.log"),
                   SCORECARD_OBSERVER=observer, SCORECARD_RUNTIME=runtime)
        if runtime == "cpython":
            env["PYTHON_GIL"] = "0"
        if pypy_stats:
            env["SCORECARD_PYPY_STATS"] = "1"
        elif jit:
            env["LUCIFER_JIT_DEBUG"] = "units"
        launched = time.time()
        proc = subprocess.Popen(command + [str(worker), *argv, "--worker", "-l", str(loops), "-w", "0",
                                           "-n", "8"], cwd=directory, env=env, stdin=subprocess.PIPE,
                                stdout=subprocess.PIPE, stderr=stack.enter_context(stderr.open("w")),
                                text=True, start_new_session=True)
        events = stack.enter_context(proc.stdout)
        stack.callback(proc.stdin.close)

        def message():
            if not select.select([events], [], [], max(0, deadline - time.monotonic()))[0]:
                raise TimeoutError("pyperformance worker time limit")
            line = events.readline()
            return json.loads(line) if line else None

        def sample():
            proc.stdin.write("go\n")
            proc.stdin.flush()
            done = message()
            if not done or not done.get("completed"):
                raise ValueError("incomplete profile window")
            return done["completed"]

        try:
            while (event := message()) is not None:
                task = event["task"]
                if task in tasks or len(event["values"]) != 8 or not all(
                        math.isfinite(x) and x > 0 for x in event["values"]):
                    raise ValueError("invalid pyperf series")
                event["launched"] = launched
                tasks[task] = event
                if observer:
                    point = directory / str(len(tasks))
                    point.mkdir(exist_ok=True)
                    if observer == "stock":
                        event.update(native_window(event["pid"], sample, point))
                    else:
                        event.update(perf_window(event["pid"], sample, point, runtime))
                    proc.stdin.write("next\n")
                    proc.stdin.flush()
            if proc.wait(timeout=max(0.1, deadline - time.monotonic())):
                raise ValueError(f"pyperf worker exit {proc.returncode}")
        finally:
            if proc.poll() is None:
                os.killpg(proc.pid, signal.SIGKILL)
                proc.wait()
    (directory / "samples.json").write_text(json.dumps(tasks, indent=1) + "\n")
    return tasks, stderr


def stderr_digest(path, site):
    # corpus.execute canonicalizes the suite and working directory before
    # checking diagnostics. A legitimate warning can contain either path.
    data = path.read_bytes().replace(os.fsencode(site), b"SITE").replace(os.fsencode(path.parent), b"CWD")
    return hashlib.sha256(data).hexdigest()


def corpus_rows(runtime, command, site, scratch, names, classification_root=None):
    corpus, programs, reference = corpus_inputs(site)
    for name in names:
        name = name.removeprefix("pyperformance.")
        if name in corpus.STARTUP:
            continue
        program = "pyperformance." + name
        directory = scratch / "pyperformance" / name
        directory.mkdir(parents=True, exist_ok=True)
        classify = runtime == "cpython" and classification_root is None
        classification = (classification_root or scratch) / "pyperformance" / name / "classification.json"
        meta = {} if classify or not classification.is_file() else json.loads(classification.read_text())
        card, group = corpus_classification(name, programs.get(name), meta.get("stock_native_pct"))
        ref = reference.get("pyperformance-warm." + name, {})
        raw = dict(card=card, program=program, manifest=name, runtime=runtime, group=group)
        try:
            if name not in programs or not ref.get("check"):
                raise ValueError("excluded by corpus lock or missing oracle check")
            observer = "application" if card == 2 else "stock" if classify and card != 3 else ""
            tasks, stderr = corpus_process(command, programs[name], site, runtime, directory / runtime,
                                           ref["loops"], observer)
            # The status corpus primes the bytecode cache before checking stderr.
            # If a first import emitted a compiler warning, repeat in a fresh worker.
            if b"SyntaxWarning:" in stderr.read_bytes() and stderr_digest(stderr, site) != ref["check"][-1]:
                tasks, stderr = corpus_process(command, programs[name], site, runtime, directory / runtime / "retry",
                                              ref["loops"], observer)
            if sorted(tasks) != ref["check"][:-1]:
                raise ValueError("pyperf benchmark names differ from oracle")
            if stderr_digest(stderr, site) != ref["check"][-1]:
                raise ValueError("pyperf stderr differs from oracle")
            if observer == "stock":
                if all("native_cycles_per_unit" in row for row in tasks.values()):
                    pct = 100 * sum(r["native_cycles_per_unit"] for r in tasks.values()) / sum(
                        r["user_cycles_per_unit"] for r in tasks.values())
                    meta = dict(stock_native_pct=pct, stock_samples=sum(r["stock_samples"] for r in tasks.values()))
                else:
                    meta = dict(classification_error="; ".join(sorted({r["classification_error"]
                                for r in tasks.values() if "classification_error" in r})))
                card, group = corpus_classification(name, programs[name], meta.get("stock_native_pct"))
            if classify:
                first = next(iter(tasks.values()))
                meta.update(stock_version=first["version"], stock_gil_enabled=first["gil_enabled"])
                classification.write_text(json.dumps(meta))
            raw.update(meta, card=card, group=group)
        except (OSError, ValueError, subprocess.SubprocessError) as exc:
            yield dict(raw, **meta, status=str(exc))
            if card in (1, 2):
                yield dict(raw, **meta, card=5, status=str(exc))
            continue
        replay, replay_error = {}, ""
        if runtime in ("lucifer", "pypy") and card in (1, 2):
            try:
                replay, log = corpus_process(command, programs[name], site, runtime, directory / runtime / "replay",
                                             ref["loops"], jit=True)
                if sorted(replay) != sorted(tasks):
                    raise ValueError("incomplete event replay")
            except (OSError, ValueError, subprocess.SubprocessError) as exc:
                replay_error = str(exc)
        for task, event in tasks.items():
            ident = program if len(tasks) == 1 else program + "/" + task
            ops = event["ops"]
            times = [value * ops for value in event["values"]]
            timing, warm = warm_rows(ident, runtime, times, loops=ops)
            timing.update(raw, program=ident, unit="pyperf operation")
            if card in (3, 4):
                timing.update(status="ok", seconds=statistics.median(event["values"][-5:]))
            if card == 2:
                timing.update({k: v for k, v in event.items() if k not in ("values", "stamps", "ops", "task", "pid", "launched", "version", "gil_enabled", "snapshots")})
            yield timing
            if card in (1, 2):
                warm.update(raw, program=ident, card=5)
                start, _ = settling(times)
                if start is not None:
                    warm["warmup_s"] = event["stamps"][start][0] - event["stamps"][0][0]
                    warm["process_to_steady_s"] = event["stamps"][start][0] - event["launched"]
                if runtime in ("lucifer", "pypy"):
                    if task in replay and not replay_error:
                        stamps = replay[task]["stamps"]
                        if runtime == "pypy":
                            snaps = replay[task]["snapshots"]
                            warm.update(pypy_counts(snaps[start] if start is not None else None, snaps[-1]))
                        else:
                            with log.open() as stream:
                                warm.update(jit_counts(stream, stamps[start][0] if start is not None else None,
                                                       stamps[-1][1]))
                        warm["telemetry"] = "ok"
                    else:
                        warm["telemetry"] = replay_error or "missing replay"
                yield warm


def suite_name(row):
    return row.get("group") or row["program"].partition(".")[0]


def paired_times(rows, reference):
    """Sum tasks before dividing. An incomplete manifest gets no vote."""
    suites = {}
    for row in rows:
        if int(row["card"]) == 5 or row["runtime"] not in ("lucifer", reference):
            continue
        tasks = suites.setdefault(suite_name(row), {}).setdefault(row.get("manifest") or row["program"], {})
        measurements = tasks.setdefault(row["program"], {})
        if row["status"] == "ok" and row.get("seconds"):
            measurements[row["runtime"]] = float(row["seconds"])

    scores = {}
    for suite, manifests in suites.items():
        ratios = {}
        for manifest, tasks in manifests.items():
            if all("lucifer" in pair and reference in pair for pair in tasks.values()):
                ratios[manifest] = (sum(p["lucifer"] for p in tasks.values())
                                    / sum(p[reference] for p in tasks.values()))
        scores[suite] = (statistics.geometric_mean(ratios.values()) if ratios else None,
                         set(ratios), set(manifests))
    return scores


def daily_metrics(rows):
    """Keep the score and the identities behind its numerator and denominator."""
    stock = paired_times(rows, "cpython")
    missing = (None, set(), set())
    scores = {
        "compute": {label: paired_times(rows, label.lower()).get("awfy", missing) for label in ("Go", "PyPy")},
        "held-out": {"stock": stock.get("held out", missing)},
        "web": {},
        "short": {"CLI": stock.get("cli", missing), "startup": stock.get("startup", missing)},
        "native": {"majority": stock.get("native majority", missing), "mixed": stock.get("mixed", missing)},
        "steady": {},
    }
    candidate = {r["program"]: r for r in rows if int(r["card"]) == 2 and r["runtime"] == "lucifer"}
    for name, label in (("flask.1", "1 CPU"), ("flask.8", "8 CPUs")):
        value = candidate.get(name, {}).get("rps_over_cpython")
        scores["web"][label] = (float(value) if value else None, {name} if value else set(), {name})
    series = [r for r in rows if int(r["card"]) == 5]
    names = {r["program"] for r in series}
    # A failed multi-task worker can only name the manifest. Other workers provide
    # its task inventory, so the placeholder must not add an extra series.
    names -= {n.split("/")[0] for n in names if "/" in n}
    states = {r["program"]: r["status"] for r in series if r["runtime"] == "lucifer"}
    settled = {n for n in names if states.get(n) == "ok"}
    scores["steady"]["settled"] = (len(settled) if names else None, settled, names)
    unsettled = sum(states.get(n) == "unsettled" for n in names)
    return scores, f"{unsettled} unsettled, {len(names) - len(settled) - unsettled} unavailable"


