def yesterday_metrics(out):
    try:
        day = datetime.date.fromisoformat(out.name.removeprefix("scorecard-"))
    except ValueError:
        return "", {}
    previous = out.parent / f"scorecard-{day - datetime.timedelta(days=1)}" / "summary.csv"
    if previous.is_file():
        with previous.open(newline="") as stream:
            rows = csv.DictReader(stream)
            # Earlier records have different estimators and no confidence intervals.
            if "seconds_low" in (rows.fieldnames or []):
                return day.isoformat(), daily_metrics([r for r in rows if r.get("kind") == "detail"])
    return day.isoformat(), {}


def ratio_text(estimate):
    value, low, high = estimate
    return f"{value:.3g}×" + (f" ({low:.3g}–{high:.3g}×)" if low is not None else "")


def churn_headline(rows):
    runtimes = {r["runtime"] for r in rows}
    scores, counts = [], []
    for runtime, label in (("lucifer", "Lucifer"), ("pypy", "PyPy")):
        if runtime not in runtimes:
            continue
        states = {}
        for row in rows:
            if int(row["card"]) == 5 and row["runtime"] == runtime:
                states.setdefault(row.get("manifest") or row["program"], set()).add(row["status"])
        churn = sum("churn" in s for s in states.values())
        measured = sum(s <= {"ok", "churn"} or "churn" in s for s in states.values())
        status = ("FAIL" if churn else "incomplete" if measured < len(states) else "PASS")
        score = f"{status} {churn}/{measured} with churn" if measured else "not measured"
        scores.append(f"{label} {score}")
        counts.append(f"{label} {len(states) - measured} unmeasured")
    return "<br>".join(scores), "<br>".join(counts)


def daily_headlines(rows, out):
    today = daily_metrics(rows)
    date, yesterday = yesterday_metrics(out)
    result = []
    groups = dict(HEADLINES)
    groups.update({f"card-{n}": (n, f"Card {n}", "") for n in range(1, 5)})
    for key, (card, title, target) in groups.items():
        scores, counts, changes = [], [], []
        for label, panel in today.get(key, {}).items():
            pairs = {name: estimate for name, estimate in panel.items() if estimate}
            coverage = f"{len(pairs)}/{len(panel)}"
            estimate = combine_intervals(pairs.values(), geometric_mean) if pairs else None
            scores.append(f"{label} {ratio_text(estimate) if estimate else '—'}, {coverage}")
            counts.append(f"{label} {len(panel) - len(pairs)} failed")
            old_panel = yesterday.get(key, {}).get(label, {})
            old_pairs = {name: est for name, est in old_panel.items() if est}
            delta = "—"
            if pairs and pairs.keys() == old_pairs.keys() and panel.keys() == old_panel.keys():
                prev = combine_intervals(old_pairs.values(), geometric_mean)
                if None not in (*estimate, *prev):
                    delta = (f"{100 * (estimate[0] / prev[0] - 1):+.3g}%"
                             if estimate[1] > prev[2] or prev[1] > estimate[2] else "overlap")
            changes.append(f"{label} {delta}")
        score, count = ("<br>".join(scores), "<br>".join(counts)) if key != "churn" else churn_headline(rows)
        kind = "aggregate" if key.startswith("card-") else "headline"
        result.append(dict(kind=kind, card=card, program=key, title=title, target=target, date=date,
                           score=score, counts=count, change="<br>".join(changes) or "—"))
    return result


def headline_table(headlines):
    lines = ["## Scorecards", "", "Stock is CPython 3.14t. Ratios compare Lucifer time to the reference. "
             "The Flask CPU layouts compare requests/s on disjoint server and client CPUs. "
             "Within each group the geometric mean gives each program one vote. A multi-task program sums its "
             "task times before division. Failed runs count against coverage. Bounds propagate each timing’s "
             "95% interval through the sums, numerator/denominator extremes, and geometric mean. "
             "A percentage change requires the same programs and nonoverlapping intervals on consecutive dates.", "",
             "| Card | Lucifer | Failed programs | Target | Change since yesterday |", "|---|---|---|---|---|"]
    for card in range(1, 6):
        group = [h for h in headlines if h["card"] == card and h["kind"] == "headline"]
        cells = [" / ".join(h["title"] for h in group)]
        for field in ("score", "counts", "target", "change"):
            cells.append("<br>".join(h[field] for h in group))
        lines.append("| " + " | ".join([f"{card}. {cells[0]}", *cells[1:]]) + " |")
    lines.extend(["", "### All-program geometric mean by card", "",
                  "Each ratio is Lucifer time divided by reference time. Flask contributes the inverse of "
                  "each disjoint layout’s throughput ratio. Go covers the verified AWFY ports.", "",
                  "| Card | Time ratios | Failed programs | Change since yesterday |", "|---|---|---|---|"])
    for h in headlines:
