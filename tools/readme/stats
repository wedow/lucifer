#!/usr/bin/env python3
"""Rewrite the stats table between README.md's stats markers from the latest daily status record.

Speed is the geomean over every *.on_over_cpython ratio in the latest record, one per
program across every benchmark suite, so new benchmarks join it by recording that key.
A program recorded with an empty ratio failed: it is counted, not scored. Kernel and differential rows take the worst of
the record's lanes; numpy and Lib/test rows carry the date of the run behind their counts.
"""
import argparse
import csv
import math
from pathlib import Path
import re
import sys

ROOT = Path(__file__).resolve().parents[2]
BEGIN, END = "<!-- stats:begin -->", "<!-- stats:end -->"


def latest(results):
    """(date, metrics) of the newest status record."""
    path = sorted(results.glob("status-*/summary.csv"))[-1]
    return path.parent.name.removeprefix("status-"), {r["metric"]: r["value"] for r in csv.DictReader(path.open())}


def share(name, m, part, whole, of="of", note=""):
    a, b = int(m[part]), int(m[whole])
    return f"| {name} | {100 * a / b:.1f}% | {a:,} {of} {b:,}{note} |"


def worst_lane(name, m, suite):
    """The lane passing fewest of conformance.SUITE.LANE.{pass,total}, with the lane count."""
    lanes = [k.split(".")[2] for k in m if k.startswith(f"conformance.{suite}.") and k.count(".") == 3 and k.endswith(".total")]
    lane = min(lanes, key=lambda lane: int(m[f"conformance.{suite}.{lane}.pass"]))
    return share(name, m, f"conformance.{suite}.{lane}.pass", f"conformance.{suite}.{lane}.total", note=f", {len(lanes)} modes")


def table(results):
    date, m = latest(results)
    recorded = [v for k, v in m.items() if k.endswith(".on_over_cpython")]
    ratios = [float(v) for v in recorded if v]
    speed = math.exp(-sum(map(math.log, ratios)) / len(ratios))
    rows = [
        "| Metric | Score | Counts |",
        "|---|---|---|",
        f"| Speed vs CPython 3.14t, composite across benchmark suites | {speed:.2f}x CPython's speed | geomean of {len(ratios)} programs, {len(recorded) - len(ratios)} fail, {date} |",
        share("C-API functions implemented", m, "capi.implemented", "capi.total"),
        share("numpy test suite passing", m, "conformance.numpytest.lucifer.pass", "conformance.numpytest.total",
              note=f" collected, run {m['conformance.numpytest.date']}"),
        share("`Lib/test` passing, relative to CPython", m, "conformance.libtest.lucifer.pass",
              "conformance.libtest.oracle.pass", of="of CPython's", note=f", run {m['conformance.libtest.date']}"),
        worst_lane("Kernel programs passing in every mode", m, "kernel"),
        worst_lane("Differential programs matching CPython in every JIT mode", m, "difftest"),
    ]
    return "\n".join([BEGIN, *rows, END])


def main():
    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--results", type=Path, default=ROOT / "results")
    p.add_argument("--readme", type=Path, default=ROOT / "README.md")
    args = p.parse_args()
    text = args.readme.read_text()
    span = re.compile(re.escape(BEGIN) + ".*?" + re.escape(END), re.S)
    if not span.search(text):
        print(f"readme stats: no {BEGIN} ... {END} block in {args.readme}", file=sys.stderr)
        return 2
    args.readme.write_text(span.sub(lambda _: table(args.results), text, count=1))
    return 0


if __name__ == "__main__":
    sys.exit(main())
