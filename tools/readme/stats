#!/usr/bin/env python3
"""Rewrite the README stats block from the newest daily scorecard."""
import argparse
import csv
from pathlib import Path

ROOT = Path(__file__).resolve().parents[2]
BEGIN, END = '<!-- stats:begin -->', '<!-- stats:end -->'

HEADLINES = {
    'compute': 'Pure-Python compute vs Go / PyPy',
    'held-out': 'Held-out real Python programs vs CPython 3.14t',
    'web': 'Flask throughput and application time vs CPython 3.14t',
    'short': 'Short programs (CLI, startup) vs CPython 3.14t',
    'native': 'Native-heavy programs vs CPython 3.14t',
    'churn': 'JIT churn after warm-up',
}
CARD_TOTALS = {
    'card-1': 'All compute programs (time)',
    'card-2': 'All application paths (time per operation or request)',
    'card-3': 'All short programs (time)',
    'card-4': 'All native and mixed programs (time)',
}
CORRECTNESS = {
    'capi': 'C-API functions implemented',
    'numpy': 'numpy test suite passing',
    'libtest': '`Lib/test` passing, relative to CPython',
    'kernel': 'Kernel programs passing (worst measured mode)',
    'differential': 'Differential programs matching CPython (worst measured JIT mode)',
}


def table(results):
    path = max(results.glob('scorecard-*/summary.csv'), default=None)
    if path is None:
        raise ValueError(f'no scorecard summary in {results}')
    date = path.parent.name.removeprefix('scorecard-')
    with path.open(newline='') as source:
        records = {(r['kind'], r['program']): r for r in csv.DictReader(source)
                   if r['kind'] in ('headline', 'aggregate', 'gate')}
    lines = ['| Metric | Score | Counts | Date |', '|---|---|---|---|']
    for kind, labels in [('headline', HEADLINES), ('aggregate', CARD_TOTALS), ('gate', CORRECTNESS)]:
        for program, label in labels.items():
            record = records.get((kind, program))
            if kind == 'aggregate' and record is None and ('headline', 'steady') in records:
                continue
            if program == 'churn' and record is None and ('headline', 'steady') in records:
                # The earlier scorecards inferred warm-up from timings and did not measure this card.
                record = {'score': 'not measured', 'counts': '—', 'date': date}
            if record is None:
                raise ValueError(f'{path} is missing {kind} {program}')
            cells = [label, record['score'], record['counts'], record['date'] or date]
            lines.append('| ' + ' | '.join(cell.replace('|', r'\|') for cell in cells) + ' |')
    return '\n'.join(lines)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--results', type=Path, default=ROOT / 'results')
    parser.add_argument('--readme', type=Path, default=ROOT / 'README.md')
    args = parser.parse_args()
    text = args.readme.read_text()
    start = text.find(BEGIN)
    end = text.find(END, start + len(BEGIN))
    if start == -1 or end == -1:
        parser.exit(2, f'readme stats: no stats block in {args.readme}\n')
    try:
        stats = table(args.results)
    except (ValueError, KeyError) as e:
        parser.exit(2, f'readme stats: {e}\n')
    args.readme.write_text(text[:start + len(BEGIN)] + '\n' + stats + '\n' + text[end:])


if __name__ == '__main__':
    main()
