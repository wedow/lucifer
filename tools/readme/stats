#!/usr/bin/env python3
"""Rewrite the stats table between README.md's stats markers from the daily status records.

Speed is the geomean over every *.on_over_cpython ratio in the latest record, so new
benchmarks join it by recording that key. numpy runs weekly: its row comes from the
latest record holding numpy.* keys (a --numpy run), else the latest record.
"""
import argparse
import csv
import math
from pathlib import Path
import re
import sys

ROOT = Path(__file__).resolve().parents[2]
BEGIN, END = "<!-- stats:begin -->", "<!-- stats:end -->"


def records(results):
    """(date, metrics) per status record, oldest first."""
    return [(p.parent.name.removeprefix("status-"), {r["metric"]: r["value"] for r in csv.DictReader(p.open())})
            for p in sorted(results.glob("status-*/summary.csv"))]


def share(name, m, part, whole, of="of", note=""):
    a, b = int(m[part]), int(m[whole])
    return f"| {name} | {100 * a / b:.1f}% | {a:,} {of} {b:,}{note} |"


def table(results):
    found = records(results)
    date, m = found[-1]
    numpy_date, numpy = next((r for r in reversed(found) if any(k.startswith("numpy.") for k in r[1])), found[-1])
    ratios = [float(v) for k, v in m.items() if k.endswith(".on_over_cpython") and v]
    speed = math.exp(-sum(map(math.log, ratios)) / len(ratios))
    rows = [
        "| Metric | Score | Counts |",
        "|---|---|---|",
        f"| Speed vs CPython 3.14t | {speed:.2f}x CPython's speed | geomean of {len(ratios)} programs, {date} |",
        share("C-API functions implemented", m, "capi.implemented", "capi.total"),
        share("numpy test suite passing", numpy, "conformance.numpytest.lucifer.pass", "conformance.numpytest.total",
              note=f" collected, {numpy_date}"),
        share("Core-type `Lib/test` passing, relative to CPython", m, "conformance.libtest-core.lucifer.pass",
              "conformance.libtest-core.oracle.pass", of="of CPython's"),
        share("Kernel programs passing", m, "conformance.kernel.plain.pass", "conformance.kernel.plain.total"),
        share("Differential programs matching CPython", m, "conformance.difftest.lucifer.pass", "conformance.difftest.total"),
    ]
    return "\n".join([BEGIN, *rows, END])


def main():
    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--results", type=Path, default=ROOT / "results")
    p.add_argument("--readme", type=Path, default=ROOT / "README.md")
    args = p.parse_args()
    text = args.readme.read_text()
    span = re.compile(re.escape(BEGIN) + ".*?" + re.escape(END), re.S)
    if not span.search(text):
        print(f"readme stats: no {BEGIN} ... {END} block in {args.readme}", file=sys.stderr)
        return 2
    args.readme.write_text(span.sub(lambda _: table(args.results), text, count=1))
    return 0


if __name__ == "__main__":
    sys.exit(main())
