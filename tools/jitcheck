#!/usr/bin/env python3
"""The optimizing tier's correctness lane on AWFY.

Runs each benchmark through the AWFY harness on the oracle and on bin/lucifer
in every JIT mode: the default (-X lucifer_jit=on), -X lucifer_jit=always,
and always with every 7th guard failing (-X lucifer_stress=deopt:7). Output
must match the oracle's line for line once the timings are masked, and in the
compiling modes the tier must have compiled and entered code (its
-X lucifer_jit_stats report), so that a lane cannot pass by not compiling.
Then lanes run a program each under -X lucifer_jit=always at two sizes and
require that a count of the tier's does not grow with the iterations:
  exits  tests/kernel/jit_exits.py, whose hot code holds instructions the
         tier does not compile: side exits. Code that keeps leaving at the
         same place stays in the interpreter instead of paying an entry and
         an exit each time.
  calls  tests/kernel/jit_calls.py, whose hot calls the tier can inline once
         it has feedback: entries into compiled code, direct calls and
         compiled calls.
         None of its functions may be disabled (recompiled until the tier
         gives up on it) or retired (an entry left to the interpreter).
  large  tests/kernel/jit_large_callees.py, whose hot call is of a function
         too large to inline whole but small along the path the program
         runs: entries into compiled code, direct and compiled calls.
  quiet  tests/kernel/jit_quiet_misses.py, whose hot lookups miss and whose
         hot generators end where CPython makes no exception: error exits.
  caught tests/kernel/jit_caught.py, whose hot code raises exceptions that
         handlers in the same compiled code take: error exits, and exits
         at a return for the frame object the traceback made.
  compiled  tests/kernel/jit_compiled_calls.py, whose hot calls are of
         functions it cannot inline: direct calls (compiled code entered
         from C). Compiled code makes them itself.
  ccalls tests/kernel/jit_c_calls.py, whose hot code makes C call compiled
         functions (a dict lookup calls its keys' __hash__ and __eq__):
         direct calls (compiled code entered through the eval loop's C
         entry). C enters the callee's unit itself; one per iteration is
         the kernel's call_special, which the comparison reaches and whose
         *args the direct entry does not bind.
  perfcalls  the compiled lane's program under -X perf, whose trampoline
         gives interpreted frames perf symbols: compiled code still calls
         compiled callees itself (they have symbols of their own): entries
         into compiled code and direct calls.
  super  tests/kernel/jit_super.py, whose hot constructors and methods go
         through super(): side exits. None of its functions may be retired.
  inline tests/kernel/jit_inline_paths.py, whose hot loops read and store
         list and tuple items the running thread owns, box ints and floats,
         and build small lists and tuples: the C paths of those operations
         (compiled code runs them in line).
  repeat the same program, whose hot loop repeats a list ([x] * n):
         entries into compiled code, direct and compiled calls (the copies
         are made without list.__mul__).
  classes  tests/kernel/jit_class_calls.py, whose hot loop calls classes
         with Python initializers: entries into compiled code, direct and
         compiled calls (the instance is made in line, __init__ inlines).
  objects  tests/kernel/jit_virtual_objects.py, whose hot loop makes
         instances and tuples nothing outside compiled code sees: the
         tuples and instances compiled code allocates (-X lucifer_jit_stats'
         allocation census). They stay virtual.
  guards tests/kernel/jit_guards.py, whose hot loop's guards check what a
         writer can change (a global, a function's code, a class
         attribute) or what never changes (the range iterator's type):
         the guards its units execute (-X lucifer_jit_stats' per-unit
         census). They move out of the loop.
  gens   tests/kernel/jit_gen_resumes.py, whose hot generators and
         coroutines are resumed by a for loop, next() and send(), a builtin
         consuming a generator expression, the first run of `yield from`
         and await: the resumes the interpreter runs (each resume enters
         compiled code).
  callees tests/kernel/jit_callee_calls.py, whose hot calls are of
         methods at a site that meets four classes, and of functions,
         bound methods and closures the code reaches through locals and
         attributes: calls compiled code makes of a callee it could not
         name or of a polymorphic site's join (-X lucifer_jit_stats'
         call_unknown and call_poly). The tier inlines them all.
  order  tests/kernel/jit_call_order.py in both orders (luc-sl4y): a loop
         calling a function through a local after, or before, another loop
         called it through a class attribute with other operand types:
         entries into compiled code, direct and compiled calls, and calls
         of callees it could not name. Each site inlines the callee.
A third lane allows one count per iteration:
  inlined  tests/kernel/jit_inlined_frames.py, whose hot method makes a call
         the tier cannot inline: direct and compiled calls, one per
         iteration for that callee, none for the method, which inlines.
The perf lane records Richards under -X perf with `perf record -g` and
requires that at least 95% of the samples in compiled code (code perf finds
in no file: it looks it up in /tmp/perf-PID.map) resolve to py:: symbols.
It reports SKIP where perf cannot record.
Exit status 1 on any difference.
"""
import argparse
import ast
import os
from pathlib import Path
import re
import subprocess
import sys
import tempfile

ROOT = Path(__file__).resolve().parent.parent
AWFY = ROOT / 'third_party' / 'awfy' / 'Python'
# name: (iterations, inner iterations); inner counts the harness can verify.
RUNS = {'Sieve': (3, 1), 'Bounce': (3, 1), 'NBody': (3, 1), 'Richards': (2, 1)}
MODES = {
    'off': ['-X', 'lucifer_jit=off'],
    'on': [],
    'always': ['-X', 'lucifer_jit=always'],
    'deopt:7': ['-X', 'lucifer_jit=always', '-X', 'lucifer_stress=deopt:7'],
}
TIMING = re.compile(r'\d+us')
# lane: (program, the counts in the -X lucifer_jit_stats report, summed, counts allowed per iteration[,
#        interpreter flags[, the argument lists after each run's size, all of which must pass]])
GROWTH = {
    'exits': ('jit_exits.py', r'jit: entries .* side (\d+)', 0),
    'calls': ('jit_calls.py', r'jit: entries (\d+), returns \d+, direct calls (\d+), compiled calls (\d+)', 0),
    'large': ('jit_large_callees.py', r'jit: entries (\d+), returns \d+, direct calls (\d+), compiled calls (\d+)', 0),
    'quiet': ('jit_quiet_misses.py', r'jit: entries .* error (\d+)', 0),
    'caught': ('jit_caught.py', r'jit: entries .* error (\d+) frame (\d+)', 0),
    'compiled': ('jit_compiled_calls.py', r'direct calls (\d+)', 0),
    'ccalls': ('jit_c_calls.py', r'direct calls (\d+)', 1),
    'perfcalls': ('jit_compiled_calls.py', r'jit: entries (\d+), returns \d+, direct calls (\d+)', 0, ('-X', 'perf')),
    'super': ('jit_super.py', r'jit: entries .* side (\d+)', 0),
    'inline': ('jit_inline_paths.py', r'jit: C paths list_item (\d+), tuple_item (\d+), list_store (\d+), '
               r'box_int (\d+), box_float (\d+), build_list (\d+), build_tuple (\d+)', 0),
    'repeat': ('jit_inline_paths.py', r'jit: entries (\d+), returns \d+, direct calls (\d+), compiled calls (\d+)', 0),
    'classes': ('jit_class_calls.py', r'jit: entries (\d+), returns \d+, direct calls (\d+), compiled calls (\d+)', 0),
    'objects': ('jit_virtual_objects.py', r'jit: allocations by kind: .*tuple (\d+), .*instance (\d+)', 0),
    'guards': ('jit_guards.py', r'jit: unit hot@\d+ entries \d+ guards (\d+)', 0),
    'inlined': ('jit_inlined_frames.py', r'direct calls (\d+), compiled calls (\d+)', 1),
    'gens': ('jit_gen_resumes.py', r'jit: generator resumes interpreted (\d+)', 0),
    'callees': ('jit_callee_calls.py', r'call_unknown (\d+) call_poly (\d+)', 0),
    'order': ('jit_call_order.py', r'jit: entries (\d+), returns \d+, direct calls (\d+), compiled calls (\d+)'
              r'|call_unknown (\d+) call_poly (\d+)', 0, (), (['ab'], ['ba'])),
}
GROWTH_N = 20000
PERF_RESOLVED = 0.95


def run(argv, timeout):
    p = subprocess.run(argv, capture_output=True, text=True, timeout=timeout,
                       env=dict(os.environ, PYTHONHASHSEED='0'))
    return p.returncode, TIMING.sub('Nus', p.stdout), p.stderr


def counted(lucifer, program, pattern, n, timeout, flags=(), extra=()):
    code, out, err = run([lucifer, '-X', 'lucifer_jit=always', '-X', 'lucifer_jit_stats', *flags, str(program), str(n),
                          *extra], timeout)
    found = [int(n) for m in re.finditer(pattern, err) for n in m.groups() if n is not None]
    return (code, out, sum(found) if found else None,
            re.findall(r'^jit: (?:disabled (\S+)|retire (\S+)@)', err, re.M))


def qualnames(program):
    """The qualified names of a program's functions and methods."""
    names = set()
    for node in ast.parse(program.read_text()).body:
        if isinstance(node, ast.FunctionDef):
            names.add(node.name)
        elif isinstance(node, ast.ClassDef):
            names.update(f'{node.name}.{f.name}' for f in node.body if isinstance(f, ast.FunctionDef))
    return names


def check_growth(args, lane):
    """The count at 2N less the count at N: what the extra N iterations cost."""
    name, pattern, per, *rest = GROWTH[lane]
    flags, variants = (rest + [(), [()]][len(rest):])[:2]
    program = ROOT / 'tests' / 'kernel' / name
    sizes = (GROWTH_N, 2 * GROWTH_N)
    problems, seen = [], []
    for extra in variants:
        small, large = (counted(args.lucifer, program, pattern, n, args.timeout, flags, extra) for n in sizes)
        want = [run([args.oracle, str(program), str(n), *extra], args.timeout)[:2] for n in sizes]
        tag = f"{' '.join(extra)}: " if extra else ''
        if [small[:2], large[:2]] != want:
            problems.append(tag + 'output differs')
        if small[2] is None or large[2] is None:
            problems.append(tag + 'no stats')
        elif large[2] - small[2] > per * GROWTH_N + GROWTH_N // 20:
            problems.append(f'{tag}{small[2]} at {GROWTH_N} iterations, {large[2]} at {2 * GROWTH_N}')
        own = qualnames(program)
        given_up = own & {name for pair in small[3] for name in pair if name}
        if lane in ('calls', 'super') and given_up:
            problems.append(f"{tag}disabled or retired: {' '.join(sorted(given_up))}")
        seen.append(f'{small[2]}, {large[2]}')
    print(f"{'FAIL' if problems else 'PASS'} {lane}" + (': ' + '; '.join(problems) if problems else
                                                      f" ({'; '.join(seen)})"))
    return 1 if problems else 0


def check_perf(args):
    """The share of compiled-code samples that perf names py::."""
    with tempfile.TemporaryDirectory() as d:
        data = os.path.join(d, 'perf.data')
        argv = [args.lucifer, '-X', 'perf', str(AWFY / 'harness.py'), 'Richards', '20', '1']
        try:
            rec = subprocess.run(['perf', 'record', '-q', '-g', '-o', data, '--'] + argv,
                                 capture_output=True, text=True, timeout=args.timeout)
        except FileNotFoundError:
            rec = None
        if rec is None or rec.returncode != 0 or not os.path.exists(data):
            print('SKIP perf: perf cannot record here')
            return 0
        script = subprocess.run(['perf', 'script', '-i', data, '-F', 'ip,sym,dso', '-G'],
                                capture_output=True, text=True, timeout=args.timeout).stdout
    jit = [line.split()[1] for line in script.splitlines() if re.search(r'\(/tmp/perf-\d+\.map\)$', line)]
    named = sum(sym.startswith('py::') for sym in jit)
    ok = jit and named >= PERF_RESOLVED * len(jit)
    print(f"{'PASS' if ok else 'FAIL'} perf: {named} of {len(jit)} compiled-code samples named py::")
    return 0 if ok else 1


def main():
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument('--lucifer', required=True)
    ap.add_argument('--oracle', required=True)
    ap.add_argument('--benchmarks', default=','.join(RUNS))
    ap.add_argument('--modes', default=','.join([*MODES, *GROWTH, 'perf']))
    ap.add_argument('--timeout', type=float, default=600)
    args = ap.parse_args()
    failed = 0
    modes = [m for m in args.modes.split(',') if m in MODES]
    for name in args.benchmarks.split(',') if modes else []:
        iters, inner = RUNS[name]
        tail = [str(AWFY / 'harness.py'), name, str(iters), str(inner)]
        want = run([args.oracle, '-X', 'lucifer_jit=always'] + tail, args.timeout)
        for mode in modes:
            flags = MODES[mode] + (['-X', 'lucifer_jit_stats'] if mode != 'off' else [])
            got = run([args.lucifer] + flags + tail, args.timeout)
            problems = []
            if got[:2] != want[:2]:
                problems.append(f'exit {got[0]} vs {want[0]}; stdout differs' if got[1] != want[1]
                                else f'exit {got[0]} vs {want[0]}')
            if mode in ('always', 'deopt:7'):
                c = re.search(r'jit: compiles (\d+)', got[2])
                e = re.search(r'jit: entries (\d+)', got[2])
                if not c or not e or int(c[1]) == 0 or int(e[1]) == 0:
                    problems.append('nothing was compiled and entered')
            print(f"{'FAIL' if problems else 'PASS'} {name} {mode}" + (': ' + '; '.join(problems) if problems else ''))
            if problems:
                failed += 1
                sys.stdout.write(got[1][-2000:] + got[2][-3000:])
    for lane in GROWTH:
        if lane in args.modes.split(','):
            failed += check_growth(args, lane)
    if 'perf' in args.modes.split(','):
        failed += check_perf(args)
    print(f'{failed} failing')
    return 1 if failed else 0


if __name__ == '__main__':
    sys.exit(main())
