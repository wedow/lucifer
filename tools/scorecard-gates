#!/usr/bin/env python3
"""Run daily correctness checks on a freshly built tree and write the scorecard's gate CSV.

TEST_PREFIX wraps each command. LIBTEST_PREFIX can give Saturday's full run a longer
time allowance. Raw output stays under the output file's sibling gates/ directory.
"""
import argparse
import csv
from datetime import date
import json
import os
from pathlib import Path
import re
import shlex
import subprocess
import sys

ROOT = Path(__file__).resolve().parents[1]
CHECKS = ('check-fast-float', 'check-blocking', 'check-globals', 'check-capi',
          'check-kernel', 'check-kernel-jit', 'check-embed', 'check-jit')
FIELDS = ('program', 'status', 'score', 'counts', 'date', 'detail')
KERNEL_COUNT = re.compile(r'^(\d+)/(\d+) checks pass \((plain|jit|jit-deopt)\)$', re.M)


def result(name, code, detail=''):
    return dict(program=name, status='fail' if code else 'pass',
                detail=detail or (f'exit {code}' if code else ''))


def share(name, passed, total, counts, measured):
    return dict(program=name, status='measured', score=f'{100 * passed / total:.1f}%',
                counts=counts, date=measured)


def incomplete(name, detail):
    return dict(program=name, status='incomplete', score='—', counts='—', detail=detail)


def lanes(name, found, expected, measured):
    missing = [lane for lane in expected if lane not in found]
    if missing:
        return incomplete(name, 'missing ' + ', '.join(missing))
    if any(not total for _, total in found.values()):
        return incomplete(name, 'empty lane')
    passed, total = min(found.values(), key=lambda pair: pair[0] / pair[1])
    counts = f'{passed:,} of {total:,}, {len(expected)} modes (worst lane)'
    row = share(name, passed, total, counts, measured)
    row['detail'] = ', '.join(f'{k} {found[k][0]}/{found[k][1]}' for k in expected)
    return row


def weekly_counts(board):
    suites = {r['suite']: {} for r in board}
    for row in board:
        suites[row['suite']][row['runtime']] = row
    for name, suite in [('libtest', 'libtest'), ('numpy', 'numpytest')]:
        folder = ROOT / 'results' / suite
        try:
            rows = suites[suite]
            passed = int(rows['lucifer']['PASS'])
            if name == 'libtest':
                total = int(rows['cpython-3.14.10t']['PASS'])
                counts = f"{passed:,} of CPython's {total:,}"
                sources = [folder / 'lucifer.json']
            else:
                total = int(rows['lucifer']['total'])
                counts = f'{passed:,} of {total:,} collected'
                sources = folder.glob('lucifer-*.json')
            # The numpy manifest merges shards. Its date is the most recent shard update.
            measured = max(json.loads(p.read_text())['recorded_at'] for p in sources)[:10]
            date.fromisoformat(measured)
            yield share(name, passed, total, counts, measured)
        except (KeyError, ValueError, TypeError, OSError, ZeroDivisionError):
            yield incomplete(name, f'missing or invalid {suite} record')


def run_gates(day, logs):
    logs.mkdir(parents=True, exist_ok=True)
    runtime = str(Path(os.environ.get('LUCIFER', ROOT / 'bin/lucifer')).resolve())
    flags = [f'{k}={os.environ[k]}' for k in ('ORACLE_T', 'HOST_PYTHON') if k in os.environ]
    prefix = os.environ['TEST_PREFIX']

    def run(name, argv, step_prefix=prefix):
        print(name, flush=True)
        with (logs / f'{name}.log').open('w') as log:
            try:
                return subprocess.run(shlex.split(step_prefix) + argv, cwd=ROOT,
                                      stdout=log, stderr=subprocess.STDOUT).returncode
            except OSError as exc:
                print(exc, file=log)
                return 127

    kernel = {}
    for name in CHECKS:
        code = run(name, ['make', name, *flags])
        detail = ''
        if name.startswith('check-kernel'):
            output = (logs / f'{name}.log').read_text(errors='replace')
            for passed, total, lane in KERNEL_COUNT.findall(output):
                kernel[lane] = (int(passed), int(total))
            if name == 'check-kernel-jit' and code and 'jit' in kernel and 'jit-deopt' not in kernel:
                # make stops at the first red lane. Still measure the other one for the record.
                rc = run('jit-deopt', [os.environ['HOST_PYTHON'], 'tools/kernelcheck', '--oracle',
                                        os.environ['ORACLE_T'], '--lucifer', runtime, '--lane', 'jit-deopt'])
                output = (logs / 'jit-deopt.log').read_text(errors='replace')
                for passed, total, lane in KERNEL_COUNT.findall(output):
                    kernel[lane] = (int(passed), int(total))
                detail = f'exit {code}, remaining jit-deopt lane exited {rc}'
        yield result(name, code, detail)
    yield lanes('kernel', kernel, ('plain', 'jit', 'jit-deopt'), day.isoformat())

    diff = {}
    for lane in ('always', 'deopt'):
        manifest = ROOT / 'build' / 'difftest' / lane / 'lucifer.tsv'
        if manifest.is_file():
            with manifest.open() as file:
                statuses = [r['status'] for r in csv.DictReader(file, delimiter='\t')]
            diff[lane] = (statuses.count('PASS'), len(statuses))
    yield lanes('differential', diff, ('always', 'deopt'), day.isoformat())

    if day.isoweekday() == 6:
        code = run('oracle-exts', ['make', 'oracle-exts', *flags])
        yield result('oracle-exts', code)
        code = run('run-libtest', [sys.executable, 'tools/libtest/run.py', 'run', '--python',
                                   runtime, '--runtime', 'lucifer', '--source', 'installed',
                                   '--raw-dir', str(logs / 'libtest'), '--jobs', os.getenv('LIBTEST_JOBS', '6')],
                   os.getenv('LIBTEST_PREFIX', prefix))
        yield result('run-libtest', code)
    elif day.isoweekday() == 7:
        args = {k: os.getenv('NUMPY_' + k.upper()) for k in ('site', 'cache', 'work')}
        if all(args.values()):
            with (ROOT / 'results/numpytest/expected.tsv').open() as file:
                ids = (r['id'] for r in csv.DictReader(file, delimiter='\t'))
                shards = sorted({i.split('::')[0] if i.startswith('numpy/_core/')
                                 else '/'.join(i.split('/')[:2]) for i in ids})
            failed = []
            for index, shard in enumerate(shards):
                code = run(f'numpy-{index}', [sys.executable, 'tools/numpytest/run.py', 'run', '--python',
                                              runtime, '--runtime', 'lucifer', '--site', args['site'],
                                              '--cache', args['cache'], '--work', args['work'], '--shard', shard])
                if code:
                    failed.append(f'{shard} (exit {code})')
            yield result('run-numpy', len(failed), f'{len(shards)} shards, {len(failed)} failed' +
                         (': ' + ', '.join(failed) if failed else ''))
        else:
            yield incomplete('run-numpy', 'missing numpy site, cache or work directory')

    code = run('scoreboard', [sys.executable, 'tools/scoreboard'])
    yield result('scoreboard', code)
    with (logs / 'scoreboard.log').open(errors='replace') as file:
        yield from weekly_counts(list(csv.DictReader(file, delimiter='\t')) if not code else [])

    code = run('abi-audit', ['make', 'abi-audit', *flags])
    yield result('abi-audit', code)
    audit = re.search(r'functions:\s+(\d+) implemented, \d+ stubs, of (\d+)',
                      (logs / 'abi-audit.log').read_text(errors='replace'))
    if audit and int(audit[2]):
        passed, total = map(int, audit.groups())
        yield share('capi', passed, total, f'{passed:,} of {total:,}', day.isoformat())
    else:
        yield incomplete('capi', 'ABI audit produced no implementation count')


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--date', required=True, type=date.fromisoformat)
    parser.add_argument('--output', required=True, type=Path)
    args = parser.parse_args()
    if not os.getenv('TEST_PREFIX'):
        parser.error('set TEST_PREFIX for the test host')
    rows = list(run_gates(args.date, args.output.resolve().parent / 'gates'))
    with args.output.open('w', newline='') as file:
        writer = csv.DictWriter(file, FIELDS)
        writer.writeheader()
        for row in rows:
            row.setdefault('date', args.date.isoformat())
            writer.writerow(row)


if __name__ == '__main__':
    main()
